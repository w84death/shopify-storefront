{% comment %}
  Game devlog — compact list of the latest blog posts for this game:
  small thumbnail, title, and a read-more button, styled as part of the
  product page (theme section layout + theme button/typography classes),
  not as a copy of the blog listing page.

  Tag resolution: product metafield custom.blog_tag (single line text),
  falling back to the product handle. Tag matching is exact but
  case-insensitive ("KORO" matches "koro"). Renders nothing when no
  article matches, so only games with tagged posts show this section.

  shortcut: blog.articles returns the newest 50 posts only — if the devlog
  ever grows past that, page through blog.articles with paginate here.
{% endcomment %}

{%- liquid
  assign game_product = section.settings.product | default: product
  assign devlog_tag = game_product.metafields.custom.blog_tag.value | default: game_product.handle | downcase | strip
  assign devlog_blog = section.settings.blog
  if devlog_blog == blank
    assign devlog_blog = blogs['devlog']
  endif

  assign matched_count = 0
  if devlog_blog != blank and devlog_tag != blank
    for article in devlog_blog.articles
      assign article_tags = article.tags | join: ',' | downcase
      if article_tags contains devlog_tag
        assign matched_count = matched_count | plus: 1
      endif
    endfor
    if matched_count > section.settings.post_limit
      assign matched_count = section.settings.post_limit
    endif
  endif
-%}

{%- if matched_count > 0 -%}
  {% style %}
    /* House palette from cn-pages.css (product templates intentionally don't
       get the catalog restyle, so this section carries its own copy). */
    #shopify-section-{{ section.id }} {
      --cn-paper: #f6f1e3;
      --cn-paper2: #fdfaf1;
      --cn-navy: #1f2a44;
      --cn-red: #d6453d;
      background: var(--cn-paper);
      color: var(--cn-navy);
    }
    #shopify-section-{{ section.id }} .game-devlog__heading {
      margin: 0 0 20px;
      font-family: "Fredoka", "WDXL Lubrifont JP N", "Anonymous Pro", ui-monospace, monospace;
      color: var(--cn-navy);
    }
    #shopify-section-{{ section.id }} .game-devlog__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 16px;
    }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .game-devlog__grid {
        grid-template-columns: 1fr;
      }
    }
    #shopify-section-{{ section.id }} .game-devlog__card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: var(--cn-paper2);
      border: 2px solid var(--cn-navy);
      border-radius: 8px;
      padding: 12px;
      overflow: clip;
    }
    #shopify-section-{{ section.id }} .game-devlog__thumb {
      width: 96px;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 8px;
      flex: none;
      background: rgb(31 42 68 / 0.06);
    }
    #shopify-section-{{ section.id }} .game-devlog__body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    #shopify-section-{{ section.id }} .game-devlog__link {
      text-decoration: none;
      color: var(--cn-navy);
    }
    #shopify-section-{{ section.id }} .game-devlog__link:hover .game-devlog__title {
      text-decoration: underline;
    }
    #shopify-section-{{ section.id }} .game-devlog__title {
      margin: 0;
    }
    #shopify-section-{{ section.id }} .cn-btn-read-more {
      display: inline-flex;
      width: fit-content;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 42px;
      padding: 0 18px;
      margin-block-start: 0;
      border-radius: 6px;
      border: 2px solid var(--cn-red);
      background: var(--cn-red);
      color: #ffffff;
      font-family: "Nunito", "Trebuchet MS", "Avenir Next", "Segoe UI", sans-serif;
      font-weight: 800;
      font-size: 12.5px;
      text-transform: uppercase;
      letter-spacing: .04em;
      text-decoration: none;
      cursor: pointer;
      transition: transform .12s ease, box-shadow .12s ease, background .12s ease, color .12s ease;
    }
    #shopify-section-{{ section.id }} .cn-btn-read-more:hover {
      transform: translate(-1px, -1px);
      box-shadow: 3px 3px 0 var(--cn-navy);
      color: #ffffff;
    }
  {% endstyle %}

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      game-devlog
      spacing-style
      gap-style
    "
    style="
      {%- render 'spacing-style', settings: section.settings -%}
      {%- render 'gap-style', value: section.settings.gap -%}
    "
  >
    <h2 class="h2 game-devlog__heading">{{ section.settings.heading }}</h2>
    <div class="game-devlog__grid">
      {%- assign shown = 0 -%}
      {%- for article in devlog_blog.articles -%}
        {%- if shown < matched_count -%}
          {%- assign article_tags = article.tags | join: ',' | downcase -%}
          {%- if article_tags contains devlog_tag -%}
            <div class="game-devlog__card">
              <a class="game-devlog__link" href="{{ article.url }}">
                {%- if article.image -%}
                  <img
                    class="game-devlog__thumb"
                    src="{{ article.image | image_url: width: 240 }}"
                    srcset="{{ article.image | image_url: width: 240 }} 240w, {{ article.image | image_url: width: 480 }} 480w"
                    sizes="96px"
                    width="96"
                    height="96"
                    loading="lazy"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                  >
                {%- endif -%}
              </a>
              <div class="game-devlog__body">
                <a class="game-devlog__link" href="{{ article.url }}">
                  <span class="h6 game-devlog__title">{{ article.title }}</span>
                </a>
                <a class="cn-btn-read-more" href="{{ article.url }}">{{ section.settings.read_more_label }}</a>
              </div>
            </div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Game devlog posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest from the devlog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts shown",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read more..."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "paragraph",
      "content": "Shows the newest posts from the blog whose tags match the product metafield custom.blog_tag (or the product handle when empty)."
    }
  ]
}
{% endschema %}
