{% comment %}
  Game devlog — latest blog posts related to this game, styled like the
  blog listing page: same _blog-post-card blocks, grid classes, hero/
  standard/compact layout and responsive image sizes as main-blog.

  Tag resolution: product metafield custom.blog_tag (single line text),
  falling back to the product handle. Tag matching is exact but
  case-insensitive ("KORO" matches "koro"). Renders nothing when no
  article matches, so only games with tagged posts show this section.

  shortcut: blog.articles returns the newest 50 posts only — if the devlog
  ever grows past that, page through blog.articles with paginate here.
{% endcomment %}

{%- liquid
  assign game_product = section.settings.product | default: product
  assign devlog_tag = game_product.metafields.custom.blog_tag.value | default: game_product.handle | downcase | strip
  assign devlog_blog = section.settings.blog
  if devlog_blog == blank
    assign devlog_blog = blogs['devlog']
  endif

  assign matched_count = 0
  if devlog_blog != blank and devlog_tag != blank
    for article in devlog_blog.articles
      assign article_tags = article.tags | join: ',' | downcase
      if article_tags contains devlog_tag
        assign matched_count = matched_count | plus: 1
      endif
    endfor
    if matched_count > section.settings.post_limit
      assign matched_count = section.settings.post_limit
    endif
  endif
-%}

{%- if matched_count > 0 -%}
  {%- if section.settings.background_color != blank -%}
    {%- render 'contrast-override', background_color: section.settings.background_color, section_id: section.id -%}
  {%- endif -%}

  {%- liquid
    # Mirrors --narrow-page-width, --page-margin and grid gaps in main-blog.liquid.
    assign compact_image_sizes = '(min-width: 1520px) 456px, (min-width: 750px) calc(33.33vw - 51px), calc(100vw - 32px)'
    assign standard_image_sizes = '(min-width: 1520px) 702px, (min-width: 750px) calc(50vw - 58px), calc(100vw - 32px)'
    assign hero_image_sizes = '(min-width: 1520px) 983px, (min-width: 750px) calc(70vw - 81px), calc(100vw - 32px)'
    assign shown = 0
    assign image_index = 0
  -%}

  {% style %}
    #shopify-section-{{ section.id }} .game-devlog__heading {
      margin: 0 0 24px;
    }
  {% endstyle %}

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      blog-posts
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
    "
    style="{%- render 'spacing-style', settings: section.settings -%}"
  >
    <h2 class="h2 game-devlog__heading">{{ section.settings.heading }}</h2>
    <div class="blog-posts-container">
      {%- for article in devlog_blog.articles -%}
        {%- if shown < matched_count -%}
          {%- assign article_tags = article.tags | join: ',' | downcase -%}
          {%- if article_tags contains devlog_tag -%}
            {%- liquid
              assign matched_index = shown | plus: 1

              # Same layout rules as main-blog: first post is the hero,
              # next posts standard, the rest compact when 6+.
              assign col_span = 3
              assign scale = 0.8
              assign is_horizontal = false
              case matched_count
                when 1
                  assign col_span = 6
                  assign scale = 1
                  assign is_horizontal = true
                when 3
                  if matched_index == 1
                    assign col_span = 6
                    assign scale = 1
                    assign is_horizontal = true
                  endif
                when 5
                  if matched_index == 1
                    assign col_span = 6
                    assign scale = 1
                    assign is_horizontal = true
                  endif
                else
                  if matched_count >= 6
                    if matched_index == 1
                      assign col_span = 6
                      assign scale = 1
                      assign is_horizontal = true
                    elsif matched_index > 3
                      assign col_span = 2
                      assign scale = 0.6
                    endif
                  endif
              endcase

              case col_span
                when 2
                  assign image_sizes = compact_image_sizes
                when 3
                  assign image_sizes = standard_image_sizes
                when 6
                  assign image_sizes = hero_image_sizes
                else
                  assign image_sizes = '100vw'
              endcase

              assign image_loading = 'lazy'
              assign image_fetch_priority = 'auto'
              if article.image
                assign image_index = image_index | plus: 1
                if image_index <= 2
                  assign image_loading = 'eager'
                endif
                if image_index == 1
                  assign image_fetch_priority = 'high'
                endif
              endif
            -%}
            {% style %}
              [data-blog-index="{{ section.id }}-{{ matched_index }}"] {
                --col-span: {{ col_span }};
                --blog-post-card-scale: {{ scale }};
              }

              @media screen and (max-width: 749px) {
                [data-blog-index="{{ section.id }}-{{ matched_index }}"] {
                  --col-span: 6;
                  --blog-post-card-scale: 0.5;
                }
              }
            {% endstyle %}
            <div
              class="blog-post-item"
              data-testid="blog-post-item"
              data-blog-index="{{ section.id }}-{{ matched_index }}"
            >
              {%- content_for 'block',
                id: 'devlog-card',
                type: '_blog-post-card',
                article: article,
                image_sizes: image_sizes,
                image_loading: image_loading,
                image_fetch_priority: image_fetch_priority,
                is_horizontal: is_horizontal
              -%}
            </div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /* Copied from main-blog.liquid so the cards match the blog listing layout. */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  .blog-post-item {
    grid-column: span var(--col-span);
    background-color: var(--color-background);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Game devlog posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest from the devlog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts shown",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "paragraph",
      "content": "Shows the newest posts from the blog whose tags match the product metafield custom.blog_tag (or the product handle when empty)."
    }
  ]
}
{% endschema %}
