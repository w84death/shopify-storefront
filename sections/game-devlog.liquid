{% comment %}
  Game devlog — latest blog posts related to this game.

  Tag resolution: product metafield custom.blog_tag (single line text),
  falling back to the product handle. Tag matching is exact but
  case-insensitive ("KORO" matches "koro"). Renders nothing when no
  article matches, so only games with tagged posts show this section.

  shortcut: blog.articles returns the newest 50 posts only — if the devlog
  ever grows past that, page through blog.articles with paginate here.
{% endcomment %}

{%- liquid
  assign game_product = closest.product | default: product
  assign devlog_tag = game_product.metafields.custom.blog_tag.value | default: game_product.handle | downcase | strip
  assign devlog_blog = section.settings.blog
  if devlog_blog == blank
    assign devlog_blog = blogs['devlog']
  endif
-%}

{%- assign shown = 0 -%}
{%- capture devlog_cards -%}
  {%- if devlog_blog != blank and devlog_tag != blank -%}
    {%- for article in devlog_blog.articles -%}
      {%- if shown < section.settings.post_limit -%}
        {%- assign article_tags = article.tags | join: ',' | downcase -%}
        {%- if article_tags contains devlog_tag -%}
          <div class="game-devlog__card">
            {%- content_for 'block', id: 'devlog-card', type: '_blog-post-card', article: article, is_horizontal: false -%}
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign devlog_cards = devlog_cards | strip -%}

{%- if devlog_cards != blank -%}
  {%- if section.settings.background_color != blank -%}
    {%- render 'contrast-override', background_color: section.settings.background_color, section_id: section.id -%}
  {%- endif -%}

  {% style %}
    #shopify-section-{{ section.id }} .game-devlog__heading {
      margin: 0;
    }
    #shopify-section-{{ section.id }} .game-devlog__grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.columns }}, minmax(0, 1fr));
      gap: 24px 16px;
    }
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .game-devlog__grid {
        grid-template-columns: 1fr;
      }
    }
  {% endstyle %}

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
      gap-style
    "
    style="
      {%- render 'spacing-style', settings: section.settings -%}
      {%- render 'gap-style', value: section.settings.gap -%}
    "
  >
    <h2 class="h2 game-devlog__heading">{{ section.settings.heading }}</h2>
    <div class="game-devlog__grid">
      {{ devlog_cards }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Game devlog posts",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest from the devlog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "label": "Posts shown",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "paragraph",
      "content": "Shows the newest posts from the blog whose tags match the product metafield custom.blog_tag (or the product handle when empty)."
    }
  ]
}
{% endschema %}
