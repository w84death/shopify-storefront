      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "image_picker", "id": "image", "label": "Optional icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Match five" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Line up five or more of the same color." }
      ]
    },
    {
      "type": "box_item",
      "name": "Box item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo / icon" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cartridge" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Premium GBC cart, region free." }
      ]
    },
    {
      "type": "fact",
      "name": "Buy fact",
      "settings": [
        { "type": "text", "id": "text", "label": "Fact", "default": "Works on original hardware" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Game landing",
      "blocks": [
        { "type": "pill", "settings": { "label": "Game Boy Color" } },
        { "type": "pill", "settings": { "label": "Physical edition" } },
