    { "type": "text", "id": "rules_sub", "label": "Rules subhead", "default": "Simple to learn. Hard to put down." },
    { "type": "range", "id": "rules_columns", "min": 1, "max": 4, "step": 1, "label": "Rule columns", "default": 3 },

    { "type": "header", "content": "Play / demo" },
