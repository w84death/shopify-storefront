    { "type": "color", "id": "color_bg", "label": "Page background", "default": "#F6C94A" },
    { "type": "color", "id": "color_surface", "label": "Surface / ghost buttons", "default": "#FFF8E8" },
    { "type": "color", "id": "color_card", "label": "Cards", "default": "#FFFDF7" },
    { "type": "color", "id": "color_nav", "label": "Nav pill", "default": "#FFF8E8" },
    { "type": "color", "id": "color_ink", "label": "Text", "default": "#2A2A2A" },
    { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#5C5348" },
    { "type": "color", "id": "color_accent", "label": "Accent / headings", "default": "#EE5B7A" },
    { "type": "color", "id": "color_cta", "label": "Primary button", "default": "#EE5B7A" },
    { "type": "color", "id": "color_cta_ink", "label": "Primary button text", "default": "#FFFFFF" },
    { "type": "color", "id": "color_blob", "label": "Hero circle", "default": "#3DB8B4" },
    { "type": "color", "id": "color_line", "label": "Hairline / borders", "default": "#E4D7C0" },
    { "type": "range", "id": "radius", "min": 8, "max": 40, "step": 2, "unit": "px", "label": "Corner radius", "default": 28 },
    { "type": "text", "id": "font_stack", "label": "Body font stack", "default": "Nunito, Trebuchet MS, Avenir Next, Segoe UI, sans-serif" },
    { "type": "text", "id": "heading_font", "label": "Heading font stack", "default": "\"WDXL Lubrifont JP N\", \"Fredoka\", \"Nunito\", sans-serif" },


    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product (leave empty to use current product)" },

    { "type": "header", "content": "Show / hide blocks" },
    { "type": "checkbox", "id": "show_nav", "label": "Sticky nav", "default": true },
    { "type": "checkbox", "id": "show_hero", "label": "Hero", "default": true },
    { "type": "checkbox", "id": "show_story", "label": "Story card", "default": true },
    { "type": "checkbox", "id": "show_rules", "label": "Rules / how to play", "default": true },
    { "type": "checkbox", "id": "show_play", "label": "Play / demo", "default": true },
    { "type": "checkbox", "id": "show_box", "label": "What's in the box", "default": true },
    { "type": "checkbox", "id": "show_buy", "label": "Buy row", "default": true },

    { "type": "header", "content": "Nav" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "KORO" },
    { "type": "text", "id": "nav_story", "label": "Link: story", "default": "Story" },
    { "type": "text", "id": "nav_play", "label": "Link: play", "default": "Play" },
    { "type": "text", "id": "nav_box", "label": "Link: box", "default": "The box" },
    { "type": "text", "id": "nav_buy", "label": "Link: buy", "default": "Get it" },

    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero mascot / key art" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A cheerful puzzle for Game Boy Color" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent line", "default": "KORO" },
    { "type": "textarea", "id": "lede", "label": "Lede", "default": "Help a little mouse collect runaway marbles. Bright, quick, endlessly replayable." },
    { "type": "text", "id": "speech", "label": "Speech bubble", "default": "Cute logic puzzle!" },
    { "type": "text", "id": "sticker", "label": "Sticker", "default": "Clear 24 lines" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button", "default": "Play the demo" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button", "default": "Get the cartridge" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" },
    { "type": "text", "id": "price_chip", "label": "Fallback price chip (if no product)", "default": "224 zł · small batch" },

    { "type": "header", "content": "Story" },
    { "type": "image_picker", "id": "story_image", "label": "Story icon" },
    { "type": "text", "id": "story_heading", "label": "Story heading", "default": "The marbles escaped into the garden." },
    { "type": "textarea", "id": "story_text", "label": "Story text", "default": "Koro loves to play marbles. One sunny day they rolled everywhere." },

    { "type": "header", "content": "Rules" },
