    { "type": "url", "id": "demo_url", "label": "Demo URL (enables embedded player)" },
    { "type": "select", "id": "demo_platform", "label": "Player platform", "options": [
      { "value": "gb", "label": "Game Boy (160×144)" },
      { "value": "dos", "label": "MS-DOS (4:3)" }
    ], "default": "gb" },
    { "type": "text", "id": "play_eyebrow", "label": "Play eyebrow", "default": "Try before you buy" },
    { "type": "text", "id": "play_heading", "label": "Play heading", "default": "Same rules. Same compact controls." },
    { "type": "textarea", "id": "play_text", "label": "Play text", "default": "Browser demo of the cartridge ROM." },
    { "type": "text", "id": "play_button", "label": "Play button", "default": "Open demo" },

    { "type": "header", "content": "What's in the box" },
    { "type": "text", "id": "box_heading", "label": "Box heading", "default": "What’s in the box" },
    { "type": "text", "id": "box_sub", "label": "Box subhead", "default": "A tiny game with a physical tribute to its colorful pieces." },

    { "type": "header", "content": "Buy row" },
