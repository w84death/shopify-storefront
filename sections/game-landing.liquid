    { "type": "text", "id": "buy_eyebrow", "label": "Buy eyebrow", "default": "Bring it home" },
    { "type": "text", "id": "buy_heading", "label": "Buy heading", "default": "Physical edition" },
    { "type": "text", "id": "buy_button", "label": "Add to cart label", "default": "Add to cart" }
