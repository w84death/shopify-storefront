{%- comment -%} sync retrigger a831ee4 {%- endcomment -%}
{% comment %}
  Game landing — palette, images, copy, and "in the box" blocks.
  Drop onto a product template. Assign in Theme editor.
{% endcomment %}

{%- liquid
  assign landing_product = section.settings.product | default: product
  comment
    Player URL: the product metafield wins (URL-type settings never render
    embedded Liquid, so a Liquid value in the demo_url setting stays dead code)
  endcomment
  assign demo_url = section.settings.demo_url
  if landing_product.metafields.custom.iframe_game_url != blank
    assign demo_url = landing_product.metafields.custom.iframe_game_url.value | default: landing_product.metafields.custom.iframe_game_url
  endif
  assign accent = section.settings.color_accent
  assign bg = section.settings.color_bg
  assign surface = section.settings.color_surface
  assign card = section.settings.color_card
  assign ink = section.settings.color_ink
  assign muted = section.settings.color_muted
  assign cta = section.settings.color_cta
  assign cta_ink = section.settings.color_cta_ink
  assign blob = section.settings.color_blob
  assign nav_bg = section.settings.color_nav
  assign line = section.settings.color_line
-%}

{% comment %}
  Fonts are self-hosted from theme assets (see the @font-face rules in the style
  block below). Upload to the theme: wdxl-lubrifont-jp-n-*.woff2, fredoka-*.woff2,
  nunito-*.woff2 (latin + latin-ext each).
{% endcomment %}

{%- style -%}
  /* Self-hosted fonts served from theme assets */
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Fredoka";
    font-style: normal;
    font-weight: 500 700;
    font-stretch: 87.5% 125%;
    font-display: swap;
    src: url({{ "fredoka-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "Fredoka";
    font-style: normal;
    font-weight: 500 700;
    font-stretch: 87.5% 125%;
    font-display: swap;
    src: url({{ "fredoka-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  #shopify-section-{{ section.id }} .gl {
    --gl-bg: {{ bg }};
    --gl-surface: {{ surface }};
    --gl-card: {{ card }};
    --gl-ink: {{ ink }};
    --gl-muted: {{ muted }};
    --gl-accent: {{ accent }};
    --gl-cta: {{ cta }};
    --gl-cta-ink: {{ cta_ink }};
    --gl-blob: {{ blob }};
    --gl-nav: {{ nav_bg }};
    --gl-line: {{ line }};
    --gl-radius: {{ section.settings.radius }}px;
    --gl-shadow: 2px 2px 0px rgba(0,0,0,.14);
    --gl-display: {{ section.settings.heading_font }};
    background: var(--gl-bg);
    color: var(--gl-ink);
    font-family: {{ section.settings.font_stack }};
    line-height: 1.45;
    padding: 12px 0 48px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  #shopify-section-{{ section.id }} .gl * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .gl a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .gl-wrap { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
  #shopify-section-{{ section.id }} .gl-nav {
    position: sticky; top: 12px; z-index: 20;
    width: min(920px, calc(100% - 24px));
    margin: 0 auto 8px;
    background: var(--gl-nav);
    border: 1px solid var(--gl-line);
    border-radius: 999px;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 8px 10px 8px 18px;
    box-shadow: var(--gl-shadow);
  }
  #shopify-section-{{ section.id }} .gl-logo {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--gl-display);
    font-weight: 650;
    font-stretch: 115%;
    letter-spacing: -0.02em;
  }
  #shopify-section-{{ section.id }} .gl-logo img { height: 28px; width: auto; }
  /* Glass 3D logo text: aqua specular top-left, gloss falloff, extruded edge */
  #shopify-section-{{ section.id }} .gl-logo span {
    background-color: currentColor;
    background-image:
      radial-gradient(135% 105% at 28% -4%, rgba(255,255,255,.9) 0%, rgba(255,255,255,.35) 30%, rgba(255,255,255,0) 56%),
      linear-gradient(to bottom, rgba(255,255,255,.4) 0%, rgba(255,255,255,0) 42%, rgba(0,0,0,.28) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 0 rgba(0,0,0,.3)) drop-shadow(0 3px 4px rgba(0,0,0,.22));
  }
  #shopify-section-{{ section.id }} .gl-links { display: flex; gap: 4px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .gl-links a {
    padding: 8px 12px; border-radius: 999px; font-size: 13px; color: var(--gl-muted);
  }
  #shopify-section-{{ section.id }} .gl-chip,
  #shopify-section-{{ section.id }} .gl-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: 999px; border: 0; cursor: pointer; font-weight: 700;
  }
  #shopify-section-{{ section.id }} .gl-chip {
    background: var(--gl-cta); color: var(--gl-cta-ink);
    padding: 8px 16px; font-size: 14px; white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .gl-hero { padding: 48px 0 16px; }
  #shopify-section-{{ section.id }} .gl-hero-grid {
    display: grid; grid-template-columns: 1.05fr .95fr; gap: 36px; align-items: center;
  }
  #shopify-section-{{ section.id }} .gl-eyebrow {
    font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--gl-accent); font-weight: 700; margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .gl h2,
  #shopify-section-{{ section.id }} .gl h3,
  #shopify-section-{{ section.id }} .gl-title,
  #shopify-section-{{ section.id }} .gl-buy-card .price {
    font-family: var(--gl-display);
    font-weight: 650;
    font-stretch: 118%;
    letter-spacing: -0.045em;
    line-height: 0.92;
    margin: 0 0 12px;
    text-wrap: balance;
    font-feature-settings: "kern" 1;
  }
  #shopify-section-{{ section.id }} .gl-title {
    font-size: clamp(52px, 8.4vw, 92px);
    font-weight: 700;
    font-stretch: 122%;
    letter-spacing: -0.055em;
    line-height: 0.88;
  }
  #shopify-section-{{ section.id }} .gl-title em {
    color: var(--gl-accent); font-style: normal; display: block;
  }
  /* OS X liquid-gloss 3D: specular highlight top-left, extruded depth below.
     currentColor keeps each rainbow letter's own color as the gloss base. */
  #shopify-section-{{ section.id }} .gl-title em span {
    font-weight: 700;
    background-color: currentColor;
    background-image:
      radial-gradient(135% 105% at 28% -4%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.4) 30%, rgba(255,255,255,0) 56%),
      linear-gradient(to bottom, rgba(255,255,255,.45) 0%, rgba(255,255,255,0) 42%, rgba(0,0,0,.22) 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 1px 0 rgba(0,0,0,.28))
      drop-shadow(0 3px 0 rgba(0,0,0,.16))
      drop-shadow(0 10px 14px rgba(0,0,0,.24));
  }
  /* letters jump like the buttons on hover; hover filter keeps the 3D drop-shadows */
  #shopify-section-{{ section.id }} .gl-title em span {
    display: inline-block;
    transition: filter .18s ease;
  }
  #shopify-section-{{ section.id }} .gl-title em span:hover {
    animation: gl-jump-{{ section.id }} .45s cubic-bezier(.34, 1.56, .64, 1);
    filter:
      drop-shadow(0 1px 0 rgba(0,0,0,.28))
      drop-shadow(0 3px 0 rgba(0,0,0,.16))
      drop-shadow(0 10px 14px rgba(0,0,0,.24))
      brightness(1.18) saturate(1.12);
  }
  #shopify-section-{{ section.id }} .gl-lede { color: var(--gl-muted); max-width: 460px; margin: 0 0 22px; font-size: 17px; }
  #shopify-section-{{ section.id }} .gl-cta-row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  #shopify-section-{{ section.id }} .gl-btn { padding: 14px 20px; font-size: 15px; }
  /* Glass 3D buttons — same top-left light as title/marble/nums */
  #shopify-section-{{ section.id }} .gl-btn,
  #shopify-section-{{ section.id }} .gl-chip {
    position: relative;
    overflow: hidden;
    transition: filter .18s ease, box-shadow .18s ease;
  }
  /* liquid sheen that sweeps across on hover (the lighting change) */
  #shopify-section-{{ section.id }} .gl-btn::after,
  #shopify-section-{{ section.id }} .gl-chip::after {
    content: ""; position: absolute; top: -40%; bottom: -40%; left: -60%; width: 45%;
    background: linear-gradient(105deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.5) 50%, rgba(255,255,255,0) 100%);
    transform: skewX(-18deg);
    transition: transform .5s ease;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .gl-btn:hover::after,
  #shopify-section-{{ section.id }} .gl-chip:hover::after { transform: skewX(-18deg) translateX(360%); }
  /* fluid jump: stretch up, squash on landing */
  @keyframes gl-jump-{{ section.id }} {
    0% { transform: translateY(0) scale(1, 1); }
    35% { transform: translateY(-3px) scale(.97, 1.07); }
    70% { transform: translateY(1px) scale(1.03, .95); }
    100% { transform: translateY(0) scale(1, 1); }
  }
  #shopify-section-{{ section.id }} .gl-btn:hover,
  #shopify-section-{{ section.id }} .gl-chip:hover {
    animation: gl-jump-{{ section.id }} .45s cubic-bezier(.34, 1.56, .64, 1);
    filter: brightness(1.07) saturate(1.06);
  }
  #shopify-section-{{ section.id }} .gl-btn-primary,
  #shopify-section-{{ section.id }} .gl-chip {
    background:
      radial-gradient(120% 150% at 30% 16%, rgba(255,255,255,.85) 0%, rgba(255,255,255,.3) 32%, rgba(255,255,255,0) 54%),
      radial-gradient(80% 110% at 80% 92%, rgba(255,255,255,.45) 0%, rgba(255,255,255,0) 42%),
      linear-gradient(150deg, color-mix(in srgb, var(--gl-cta) 50%, #fff) 0%, color-mix(in srgb, var(--gl-cta) 85%, #fff) 38%, var(--gl-cta) 82%, color-mix(in srgb, var(--gl-cta) 88%, #000) 100%);
    color: #000;
    text-shadow: 0 1px 0 rgba(255,255,255,.5);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.85),
      inset 2px 3px 6px rgba(255,255,255,.35),
      inset -2px -3px 6px rgba(0,0,0,.2),
      0 3px 0 color-mix(in srgb, var(--gl-cta) 55%, #000),
      0 7px 12px rgba(0,0,0,.22);
  }
  #shopify-section-{{ section.id }} .gl-btn-ghost {
    background:
      radial-gradient(120% 150% at 30% 16%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.45) 32%, rgba(255,255,255,0) 54%),
      linear-gradient(150deg, #fff 0%, color-mix(in srgb, var(--gl-surface) 75%, #fff) 45%, var(--gl-surface) 100%);
    color: var(--gl-ink);
    text-shadow: 0 1px 0 rgba(255,255,255,.6);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.9),
      inset 2px 3px 6px rgba(255,255,255,.5),
      inset -2px -3px 6px rgba(0,0,0,.12),
      0 3px 0 color-mix(in srgb, var(--gl-surface) 60%, #000),
      0 7px 12px rgba(0,0,0,.15);
  }
  /* Dark panel (play section): dark glass buttons, white text */
  #shopify-section-{{ section.id }} .gl-play .gl-btn-primary {
    background:
      radial-gradient(120% 150% at 30% 16%, rgba(255,255,255,.4) 0%, rgba(255,255,255,.14) 32%, rgba(255,255,255,0) 54%),
      linear-gradient(150deg, color-mix(in srgb, var(--gl-cta) 45%, var(--gl-ink)) 0%, color-mix(in srgb, var(--gl-cta) 28%, var(--gl-ink)) 55%, color-mix(in srgb, var(--gl-cta) 22%, #000) 100%);
    color: #fff;
    text-shadow: 0 -1px 0 rgba(0,0,0,.4), 0 1px 1px rgba(255,255,255,.14);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.35),
      inset 2px 3px 6px rgba(255,255,255,.12),
      inset -2px -3px 6px rgba(0,0,0,.45),
      0 3px 0 rgba(0,0,0,.5),
      0 7px 12px rgba(0,0,0,.35);
  }
  #shopify-section-{{ section.id }} .gl-play .gl-btn-ghost {
    background:
      radial-gradient(120% 150% at 30% 16%, rgba(255,255,255,.32) 0%, rgba(255,255,255,.1) 32%, rgba(255,255,255,0) 54%),
      linear-gradient(150deg, color-mix(in srgb, var(--gl-ink) 55%, #fff) 0%, var(--gl-ink) 48%, color-mix(in srgb, var(--gl-ink) 68%, #000) 100%);
    color: #fff;
    text-shadow: 0 -1px 0 rgba(0,0,0,.4), 0 1px 1px rgba(255,255,255,.14);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.3),
      inset 2px 3px 6px rgba(255,255,255,.1),
      inset -2px -3px 6px rgba(0,0,0,.45),
      0 3px 0 rgba(0,0,0,.5),
      0 7px 12px rgba(0,0,0,.35);
  }
  #shopify-section-{{ section.id }} .gl-btn:active,
  #shopify-section-{{ section.id }} .gl-chip:active {
    transform: translateY(2px);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.75),
      inset 2px 3px 6px rgba(255,255,255,.25),
      inset -2px -3px 6px rgba(0,0,0,.25),
      0 1px 0 rgba(0,0,0,.2),
      0 3px 6px rgba(0,0,0,.2);
  }
  #shopify-section-{{ section.id }} .gl-price-chip {
    background: var(--gl-surface); border: 1px solid var(--gl-line);
    border-radius: 999px; padding: 8px 12px; font-size: 14px;
  }
  #shopify-section-{{ section.id }} .gl-pills { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
  #shopify-section-{{ section.id }} .gl-pill {
    background: color-mix(in srgb, var(--gl-surface) 80%, transparent);
    border: 1px solid var(--gl-line);
    border-radius: 999px; padding: 6px 12px; font-size: 13px;
  }
  #shopify-section-{{ section.id }} .gl-art { position: relative; min-height: 380px; display: grid; place-items: center; }
  #shopify-section-{{ section.id }} .gl-blob {
    width: min(360px, 80vw); aspect-ratio: 1;
    border-radius: 50%; background: var(--gl-blob);
    display: grid; place-items: center; overflow: hidden;
    box-shadow: var(--gl-shadow);
  }
  #shopify-section-{{ section.id }} .gl-blob img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #shopify-section-{{ section.id }} .gl-speech,
  #shopify-section-{{ section.id }} .gl-sticker {
    position: absolute; background: var(--gl-surface); color: var(--gl-ink);
    font-weight: 800; box-shadow: var(--gl-shadow);
  }
  #shopify-section-{{ section.id }} .gl-speech {
    top: 18px; right: 0; border-radius: 18px 18px 18px 4px;
    padding: 10px 14px; transform: rotate(5deg);
  }
  #shopify-section-{{ section.id }} .gl-sticker {
    bottom: 18px; left: 8px; border-radius: 999px;
    padding: 8px 12px; background: var(--gl-cta); color: var(--gl-cta-ink);
    transform: rotate(-7deg);
  }
  #shopify-section-{{ section.id }} .gl-block { padding: 22px 0; }
  #shopify-section-{{ section.id }} .gl-story,
  #shopify-section-{{ section.id }} .gl-card,
  #shopify-section-{{ section.id }} .gl-buy-card {
    background: var(--gl-card);
    border: 1px solid var(--gl-line);
    border-radius: var(--gl-radius);
    box-shadow: var(--gl-shadow);
  }
  #shopify-section-{{ section.id }} .gl-story {
    display: grid; grid-template-columns: 88px 1fr; gap: 18px; align-items: center;
    padding: 24px;
  }
  #shopify-section-{{ section.id }} .gl-story img,
  #shopify-section-{{ section.id }} .gl-story-fallback {
    width: 88px; height: 88px; border-radius: 50%; object-fit: cover; background: var(--gl-blob);
  }
  /* Glass marble: top-left specular dot, bottom reflected light, sphere shading */
  #shopify-section-{{ section.id }} .gl-story-fallback {
    background:
      radial-gradient(circle at 30% 24%, rgba(255,255,255,.95) 0%, rgba(255,255,255,.45) 14%, rgba(255,255,255,0) 40%),
      radial-gradient(circle at 70% 85%, rgba(255,255,255,.4) 0%, rgba(255,255,255,0) 32%),
      radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--gl-blob) 45%, #fff) 0%, var(--gl-blob) 58%, color-mix(in srgb, var(--gl-blob) 55%, #000) 100%);
    box-shadow:
      inset -6px -8px 14px rgba(0,0,0,.28),
      inset 4px 6px 10px rgba(255,255,255,.4),
      0 10px 16px rgba(0,0,0,.25);
  }
  #shopify-section-{{ section.id }} .gl h3 { font-size: clamp(30px, 3.6vw, 44px); margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .gl-sub { color: var(--gl-muted); margin: 0; }
  #shopify-section-{{ section.id }} .gl-grid {
    display: grid; gap: 12px;
    grid-template-columns: repeat({{ section.settings.rules_columns }}, 1fr);
  }
  #shopify-section-{{ section.id }} .gl-card { padding: 20px; }
  #shopify-section-{{ section.id }} .gl-num {
    width: 36px; height: 36px; border-radius: 12px;
    display: grid; place-items: center; font-weight: 800; color: var(--gl-cta-ink);
    background: linear-gradient(150deg, color-mix(in srgb, var(--gl-accent) 70%, #fff) 0%, var(--gl-accent) 55%, color-mix(in srgb, var(--gl-accent) 70%, #000) 100%);
    text-shadow: 0 -1px 0 rgba(0,0,0,.3), 0 1px 1px rgba(255,255,255,.35);
    box-shadow:
      inset 0 1px 1px rgba(255,255,255,.85),
      inset 2px 3px 5px rgba(255,255,255,.28),
      inset -2px -3px 5px rgba(0,0,0,.28),
      0 3px 0 color-mix(in srgb, var(--gl-accent) 55%, #000),
      0 6px 10px rgba(0,0,0,.22);
    margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .gl-card h4 {
    margin: 0 0 6px;
    font-family: var(--gl-display);
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: -0.03em;
  }
  #shopify-section-{{ section.id }} .gl-card p { margin: 0; color: var(--gl-muted); font-size: 15px; }
  #shopify-section-{{ section.id }} .gl-card img { width: 48px; height: 48px; object-fit: contain; margin-bottom: 8px; }
  #shopify-section-{{ section.id }} .gl-play {
    background: var(--gl-ink); color: var(--gl-bg);
    border-radius: var(--gl-radius); padding: 28px;
    display: grid; grid-template-columns: 260px 1fr; gap: 24px; align-items: center;
  }
  #shopify-section-{{ section.id }} .gl-play h3,
  #shopify-section-{{ section.id }} .gl-play .gl-eyebrow { color: var(--gl-bg); }
  #shopify-section-{{ section.id }} .gl-play .gl-sub { color: color-mix(in srgb, var(--gl-bg) 75%, #888); }
  #shopify-section-{{ section.id }} .gl-play-frame {
    min-height: 180px; border-radius: 16px; overflow: hidden;
    background: #111; display: grid; place-items: center;
  }
  #shopify-section-{{ section.id }} .gl-play-frame img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .gl-art .gl-player-shell { width: min(560px, 100%); }
  #shopify-section-{{ section.id }} .gl-art .gl-player-shell--lightbox {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    width: auto; max-width: none; padding: 20px;
    border-radius: 0; border: 0; background: rgba(12, 10, 14, .94);
  }
  #shopify-section-{{ section.id }} .gl-art .gl-player-shell--lightbox .gl-player-screen {
    width: auto; height: min(76svh, 640px); max-width: 94vw;
  }
  #shopify-section-{{ section.id }} .gl-art .gl-player-shell--lightbox .gl-player-bar { padding-top: 54px; }
  #shopify-section-{{ section.id }} .gl-player-close {
    display: none; position: absolute; top: 14px; right: 18px;
    width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(255, 255, 255, .14); color: #fff;
    font-size: 20px; font-weight: 800; line-height: 1;
  }
  #shopify-section-{{ section.id }} .gl-art .gl-player-shell--lightbox .gl-player-close { display: block; }
  #shopify-section-{{ section.id }} .gl-player-shell {
    width: 100%; border-radius: 16px; overflow: hidden;
    border: 1px solid var(--gl-line); background: #111; box-shadow: var(--gl-shadow);
  }
  #shopify-section-{{ section.id }} .gl-player-bar {
    display: flex; justify-content: space-between; padding: 10px 14px;
    font-size: 12px; font-weight: 800; letter-spacing: .12em; color: #fff;
  }
  #shopify-section-{{ section.id }} .gl-player-screen { display: block; width: 100%; border: 0; background: #000; }
  #shopify-section-{{ section.id }} .gl-player-screen--gb { aspect-ratio: 160 / 144; }
  #shopify-section-{{ section.id }} .gl-player-screen--dos { aspect-ratio: 4 / 3; }
  #shopify-section-{{ section.id }} .gl-keys {
    margin: 16px auto 0; text-align: center;
    font-family: ui-monospace, monospace; font-size: 13px; color: var(--gl-muted);
  }
  #shopify-section-{{ section.id }} .gl-keys kbd {
    padding: 4px 8px; border: 1px solid var(--gl-line); border-radius: 6px;
    background: var(--gl-surface); color: var(--gl-ink); font-family: inherit; font-size: 12px;
  }
  #shopify-section-{{ section.id }} .gl-box { display: grid; gap: 12px; grid-template-columns: repeat(4, 1fr); }
  #shopify-section-{{ section.id }} .gl-box .gl-card { text-align: center; padding: 0; overflow: hidden; }
  #shopify-section-{{ section.id }} .gl-box .gl-card img {
    width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover;
    display: block; margin: 0;
  }
  #shopify-section-{{ section.id }} .gl-box .gl-card h4 { margin: 14px 14px 4px; }
  #shopify-section-{{ section.id }} .gl-box .gl-card p { margin: 0 14px 16px; }
  #shopify-section-{{ section.id }} .gl-editions {
    display: grid; gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(215px, 1fr));
    align-items: stretch; margin-top: 20px;
  }
  #shopify-section-{{ section.id }} .gl-edition {
    position: relative; display: flex; flex-direction: column; gap: 8px;
    padding: 22px; background: var(--gl-card); border-radius: var(--gl-radius);
    box-shadow: var(--gl-shadow);
  }
  #shopify-section-{{ section.id }} .gl-edition--best { border: 2px solid var(--gl-accent); }
  #shopify-section-{{ section.id }} .gl-edition--soldout { opacity: .55; filter: saturate(.35); }
  #shopify-section-{{ section.id }} .gl-edition--soldout .gl-btn { cursor: not-allowed; }
  #shopify-section-{{ section.id }} .gl-edition__badge {
    position: absolute; top: -12px; right: 16px;
    background: var(--gl-accent); color: #000;
    font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 999px;
  }
  #shopify-section-{{ section.id }} .gl-edition h4 { margin: 0; font-family: var(--gl-display); font-size: 20px; }
  #shopify-section-{{ section.id }} .gl-edition__price { font-family: var(--gl-display); font-weight: 800; font-size: 24px; }
  #shopify-section-{{ section.id }} .gl-edition p { margin: 0; color: var(--gl-muted); font-size: 14.5px; }
  #shopify-section-{{ section.id }} .gl-edition__btns { margin-top: auto; padding-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .gl-buy { display: grid; grid-template-columns: 1.2fr .8fr; gap: 18px; }
  #shopify-section-{{ section.id }} .gl-shot {
    border-radius: var(--gl-radius); min-height: 300px; overflow: hidden;
    background: var(--gl-surface); display: grid; place-items: center;
    border: 1px solid var(--gl-line);
  }
  #shopify-section-{{ section.id }} .gl-shot img { width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .gl-buy-card { padding: 26px; }
  #shopify-section-{{ section.id }} .gl-buy-card .price { font-size: 32px; font-weight: 800; margin: 8px 0 14px; }
  #shopify-section-{{ section.id }} .gl-facts { list-style: none; padding: 0; margin: 0 0 18px; color: var(--gl-muted); }
  #shopify-section-{{ section.id }} .gl-facts li { padding: 6px 0; }
  #shopify-section-{{ section.id }} .gl-facts li::before { content: "● "; color: var(--gl-accent); }
  #shopify-section-{{ section.id }} .gl-buy-card select,
  #shopify-section-{{ section.id }} .gl-buy-card input[type="number"] {
    width: 100%; margin: 0 0 10px; padding: 10px 12px;
    border-radius: 12px; border: 1px solid var(--gl-line);
    background: var(--gl-surface); color: var(--gl-ink);
  }
  #shopify-section-{{ section.id }} .gl-buy-card .gl-btn { width: 100%; }
  @media (max-width: 800px) {
    #shopify-section-{{ section.id }} .gl-hero-grid,
    #shopify-section-{{ section.id }} .gl-grid,
    #shopify-section-{{ section.id }} .gl-play,
    #shopify-section-{{ section.id }} .gl-box,
    #shopify-section-{{ section.id }} .gl-buy { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .gl-links { display: none; }
  }
{%- endstyle -%}

<div class="gl" id="gl-{{ section.id }}">
  {% if section.settings.show_nav %}
    <header class="gl-nav">
      <a class="gl-logo" href="#gl-top-{{ section.id }}">
        {% if section.settings.logo %}
          <img src="{{ section.settings.logo | image_url: width: 200 }}" width="200" height="{{ 200 | divided_by: section.settings.logo.aspect_ratio | round }}" alt="{{ section.settings.logo_text | escape }}">
        {% endif %}
        <span>{{ section.settings.logo_text }}</span>
      </a>
      <nav class="gl-links">
        {% if section.settings.show_story %}<a href="#gl-story-{{ section.id }}">{{ section.settings.nav_story }}</a>{% endif %}
        {% if section.settings.show_play %}<a href="#gl-play-{{ section.id }}">{{ section.settings.nav_play }}</a>{% endif %}
        {% if section.settings.show_box %}<a href="#gl-box-{{ section.id }}">{{ section.settings.nav_box }}</a>{% endif %}
        {% if section.settings.show_buy %}<a href="#gl-buy-{{ section.id }}">{{ section.settings.nav_buy }}</a>{% endif %}
      </nav>
      <a class="gl-chip" href="#gl-buy-{{ section.id }}">
        {% if landing_product %}{{ landing_product.price_max | money }} →{% else %}{{ section.settings.nav_buy }}{% endif %}
      </a>
    </header>
  {% endif %}

  {% if section.settings.show_hero %}
    <section class="gl-hero gl-wrap" id="gl-top-{{ section.id }}">
      <div class="gl-hero-grid">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="gl-eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
          <h2 class="gl-title">
            {{ section.settings.heading }}
            {% if section.settings.heading_accent != blank %}
              <em>
                {%- if section.settings.rainbow_accent -%}
                  {%- assign rainbow = '#1a9e4b,#f2a007,#e0393e,#2b6cd4' | split: ',' -%}
                  {%- assign rainbow_light = '#e7f6ec,#fdf1d9,#fdeaea,#e9effb' | split: ',' -%}
                  {%- assign letters = section.settings.heading_accent | split: '' -%}
                  {%- for letter in letters -%}
                    {%- assign ci = forloop.index0 | modulo: 4 -%}
                    <span style="color:{{ rainbow[ci] }}" data-bg="{{ rainbow_light[ci] }}" role="button" tabindex="0" aria-label="Background color {{ rainbow_light[ci] }}">{{ letter }}</span>
                  {%- endfor -%}
                {%- else -%}
                  {{ section.settings.heading_accent }}
                {%- endif -%}
              </em>
            {% endif %}
          </h2>
          {% if section.settings.lede != blank %}
            <p class="gl-lede">{{ section.settings.lede }}</p>
          {% endif %}
          <div class="gl-cta-row">
            {% if section.settings.cta_primary_label != blank %}
              <a class="gl-btn gl-btn-primary" href="{% if section.settings.cta_primary_link != blank %}{{ section.settings.cta_primary_link }}{% else %}#gl-play-{{ section.id }}{% endif %}">{{ section.settings.cta_primary_label }}</a>
            {% endif %}
            {% if section.settings.cta_secondary_label != blank %}
              <a class="gl-btn gl-btn-ghost" href="{% if section.settings.cta_secondary_link != blank %}{{ section.settings.cta_secondary_link }}{% else %}#gl-buy-{{ section.id }}{% endif %}">{{ section.settings.cta_secondary_label }}</a>
            {% endif %}
            {% if landing_product %}
              <span class="gl-price-chip">{{ landing_product.price_max | money }}{% if landing_product.compare_at_price > landing_product.price %} · {{ landing_product.compare_at_price | money }}{% endif %}</span>
            {% elsif section.settings.price_chip != blank %}
              <span class="gl-price-chip">{{ section.settings.price_chip }}</span>
            {% endif %}
          </div>
          <div class="gl-pills">
            {% for block in section.blocks %}
              {% if block.type == 'pill' %}
                <span class="gl-pill" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="gl-art">
          {% if demo_url != blank %}
            {% render 'game-player', url: demo_url, platform: section.settings.demo_platform, brand: section.settings.logo_text, title: section.settings.heading %}
          {% else %}
          <div class="gl-blob">
            {% if section.settings.hero_image %}
              <img src="{{ section.settings.hero_image | image_url: width: 900 }}" width="900" height="{{ 900 | divided_by: section.settings.hero_image.aspect_ratio | round }}" alt="{{ section.settings.hero_image.alt | default: section.settings.heading | escape }}">
            {% endif %}
          </div>
          {% if section.settings.speech != blank %}<div class="gl-speech">{{ section.settings.speech }}</div>{% endif %}
          {% if section.settings.sticker != blank %}<div class="gl-sticker">{{ section.settings.sticker }}</div>{% endif %}
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  <script>
    (function () {
      var sec = document.getElementById('shopify-section-{{ section.id }}');
      if (!sec) return;
      var shell = sec.querySelector('.gl-player-shell');
      var hero = document.getElementById('gl-top-{{ section.id }}');
      if (!shell || !hero) return;
      var anchor = 'a[href$="#gl-top-{{ section.id }}"]';
      function close() {
        if (!shell.classList.contains('gl-player-shell--lightbox')) return;
        shell.classList.remove('gl-player-shell--lightbox');
        hero.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      document.addEventListener('click', function (e) {
        var a = e.target.closest(anchor + ':not(.gl-logo)');
        if (a) {
          e.preventDefault();
          shell.classList.add('gl-player-shell--lightbox');
          if (!shell.querySelector('.gl-player-close')) {
            var b = document.createElement('button');
            b.type = 'button';
            b.className = 'gl-player-close';
            b.setAttribute('aria-label', 'Close player');
            b.textContent = '\u2715';
            shell.appendChild(b);
          }
          return;
        }
        if (e.target.closest('.gl-player-close')) { close(); return; }
        if (shell.classList.contains('gl-player-shell--lightbox') &&
            !e.target.closest('iframe, .gl-player-bar, .gl-keys')) close();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') close();
      });
      if (location.hash === '#buy') {
        var buy = sec.querySelector('[id^="gl-buy-"]');
        if (buy) requestAnimationFrame(function () { buy.scrollIntoView({ block: 'start' }); });
      }
    })();
  </script>

  {% if section.settings.show_story %}
    <section class="gl-block gl-wrap" id="gl-story-{{ section.id }}">
      <div class="gl-story">
        {% if section.settings.story_image %}
          <img src="{{ section.settings.story_image | image_url: width: 200 }}" width="200" height="{{ 200 | divided_by: section.settings.story_image.aspect_ratio | round }}" alt="">
        {% else %}
          <div class="gl-story-fallback"></div>
        {% endif %}
        <div>
          <h3>{{ section.settings.story_heading }}</h3>
          <p class="gl-sub">{{ section.settings.story_text }}</p>
        </div>
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_rules %}
    <section class="gl-block gl-wrap">
      <h3>{{ section.settings.rules_heading }}</h3>
      {% if section.settings.rules_sub != blank %}<p class="gl-sub" style="margin-bottom:18px">{{ section.settings.rules_sub }}</p>{% endif %}
      <div class="gl-grid">
        {% assign rule_i = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'rule' %}
            {% assign rule_i = rule_i | plus: 1 %}
            <article class="gl-card" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                  <img src="{{ block.settings.image | image_url: width: 160 }}" width="160" height="{{ 160 | divided_by: block.settings.image.aspect_ratio | round }}" alt="">
              {% else %}
                <div class="gl-num">{{ block.settings.number | default: rule_i }}</div>
              {% endif %}
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_play %}
    <section class="gl-block gl-wrap" id="gl-play-{{ section.id }}">
      <div class="gl-play">
        <div class="gl-play-frame">
          {% if section.settings.play_image %}
            <img src="{{ section.settings.play_image | image_url: width: 800 }}" width="800" height="{{ 800 | divided_by: section.settings.play_image.aspect_ratio | round }}" alt="">
          {% elsif section.settings.demo_embed != blank %}
            <div style="width:100%">{{ section.settings.demo_embed }}</div>
          {% else %}
            <span style="color:#fff;font-weight:800;letter-spacing:.08em">PLAY</span>
          {% endif %}
        </div>
        <div>
          <p class="gl-eyebrow">{{ section.settings.play_eyebrow }}</p>
          <h3>{{ section.settings.play_heading }}</h3>
          <p class="gl-sub" style="margin:10px 0 16px">{{ section.settings.play_text }}</p>
          {% if demo_url != blank %}
            <div class="gl-cta-row" style="margin-top:16px">
              <a class="gl-btn gl-btn-primary" href="#gl-top-{{ section.id }}">{{ section.settings.play_button }}</a>
              <a class="gl-btn gl-btn-ghost" href="{{ demo_url }}" target="_blank" rel="noopener">{{ section.settings.play_mobile_button }}</a>
            </div>
          {% endif %}
        </div>
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_editions %}
    <section class="gl-block gl-wrap" id="gl-editions-{{ section.id }}">
      <h3>{{ section.settings.editions_heading }}</h3>
      {% if section.settings.editions_sub != blank %}<p class="gl-sub" style="margin-bottom:18px">{{ section.settings.editions_sub }}</p>{% endif %}
      <div class="gl-editions">
        {% for block in section.blocks %}
          {% if block.type == 'edition' %}
            {% liquid
              assign b1 = '#gl-buy-' | append: section.id
              if block.settings.btn1_action == 'player'
                assign b1 = '#gl-top-' | append: section.id
              elsif block.settings.btn1_action == 'mobile' and demo_url != blank
                assign b1 = demo_url
              elsif block.settings.btn1_action == 'custom' and block.settings.btn1_link != blank
                assign b1 = block.settings.btn1_link
              endif
              assign b2 = '#gl-buy-' | append: section.id
              if block.settings.btn2_action == 'player'
                assign b2 = '#gl-top-' | append: section.id
              elsif block.settings.btn2_action == 'mobile' and demo_url != blank
                assign b2 = demo_url
              elsif block.settings.btn2_action == 'custom' and block.settings.btn2_link != blank
                assign b2 = block.settings.btn2_link
              endif
              comment
                Match the card to a product variant by keyword: ROM only -> *ROM*,
                Just cart -> *Cardridge*, Full CIB -> *Box / CIB*.
              endcomment
              assign card_title = block.settings.title | downcase
              assign matched_variant = null
              assign sold_out = false
              if landing_product
                for v in landing_product.variants
                  assign vt = v.title | downcase
                  assign vt_is_box = false
                  if vt contains 'box' or vt contains 'cib'
                    assign vt_is_box = true
                  endif
                  if card_title contains 'rom' and vt contains 'rom'
                    assign matched_variant = v
                  elsif card_title contains 'cart' and vt contains 'card'
                    assign matched_variant = v
                  elsif card_title contains 'cib' and vt_is_box
                    assign matched_variant = v
                  endif
                endfor
              endif
              if matched_variant and matched_variant.available == false
                assign sold_out = true
              endif
            %}
            <article class="gl-edition{% if block.settings.badge != blank %} gl-edition--best{% endif %}{% if sold_out %} gl-edition--soldout{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.badge != blank %}<span class="gl-edition__badge">{{ block.settings.badge }}</span>{% endif %}
              <h4>{{ block.settings.title }}</h4>
              {% if matched_variant %}
                <div class="gl-edition__price">{{ matched_variant.price | money }}</div>
              {% elsif block.settings.price != blank %}
                <div class="gl-edition__price">{{ block.settings.price }}</div>
              {% endif %}
              <p>{{ block.settings.text }}</p>
              <div class="gl-edition__btns">
                {% if block.settings.btn1_label != blank %}
                  {% if sold_out %}
                    <span class="gl-btn gl-btn-primary gl-btn--soon" aria-disabled="true">Coming soon</span>
                  {% else %}
                    <a class="gl-btn gl-btn-primary" href="{{ b1 }}">{{ block.settings.btn1_label }}</a>
                  {% endif %}
                {% endif %}
                {% if block.settings.btn2_label != blank and block.settings.btn2_action != 'mobile' or block.settings.btn2_action == 'mobile' and demo_url != blank %}
                  <a class="gl-btn gl-btn-ghost" href="{{ b2 }}">{{ block.settings.btn2_label }}</a>
                {% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_box %}
    <section class="gl-block gl-wrap" id="gl-box-{{ section.id }}">
      <h3>{{ section.settings.box_heading }}</h3>
      {% if section.settings.box_sub != blank %}<p class="gl-sub" style="margin-bottom:18px">{{ section.settings.box_sub }}</p>{% endif %}
      <div class="gl-box">
        {% for block in section.blocks %}
          {% if block.type == 'box_item' %}
            <article class="gl-card" {{ block.shopify_attributes }}>
              {% if block.settings.image %}
                <img src="{{ block.settings.image | image_url: width: 800 }}" width="800" height="{{ 800 | divided_by: block.settings.image.aspect_ratio | round }}" alt="{{ block.settings.title | escape }}">
              {% endif %}
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.text }}</p>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endif %}

  {% if section.settings.show_buy %}
    <section class="gl-block gl-wrap" id="gl-buy-{{ section.id }}">
      <div class="gl-buy">
        <div class="gl-shot">
          {% if section.settings.buy_image %}
            <img src="{{ section.settings.buy_image | image_url: width: 1400 }}" width="1400" height="{{ 1400 | divided_by: section.settings.buy_image.aspect_ratio | round }}" alt="{{ landing_product.title | default: section.settings.buy_heading | escape }}">
          {% elsif landing_product and landing_product.featured_image %}
            <img src="{{ landing_product.featured_image | image_url: width: 1400 }}" width="1400" height="{{ 1400 | divided_by: landing_product.featured_image.aspect_ratio | round }}" alt="{{ landing_product.featured_image.alt | escape }}">
          {% endif %}
        </div>
        <aside class="gl-buy-card">
          <p class="gl-eyebrow">{{ section.settings.buy_eyebrow }}</p>
          <h3>{{ section.settings.buy_heading | default: landing_product.title }}</h3>
          {% if landing_product %}
            <div class="price">{{ landing_product.price_max | money }}</div>
          {% elsif section.settings.price_chip != blank %}
            <div class="price">{{ section.settings.price_chip }}</div>
          {% endif %}
          <ul class="gl-facts">
            {% for block in section.blocks %}
              {% if block.type == 'fact' %}
                <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
              {% endif %}
            {% endfor %}
          </ul>
          {% if landing_product %}
            {% form 'product', landing_product %}
              {% unless landing_product.has_only_default_variant %}
                <select name="id">
                  {% for variant in landing_product.variants %}
                    <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                      {{ variant.title }} — {{ variant.price | money }}
                    </option>
                  {% endfor %}
                </select>
              {% else %}
                <input type="hidden" name="id" value="{{ landing_product.selected_or_first_available_variant.id }}">
              {% endunless %}
              <input type="number" name="quantity" value="1" min="1">
              <button type="submit" class="gl-btn gl-btn-primary" name="add">{{ section.settings.buy_button }}</button>
            {% endform %}
          {% else %}
            <a class="gl-btn gl-btn-primary" href="{{ section.settings.cta_secondary_link }}">{{ section.settings.buy_button }}</a>
          {% endif %}
        </aside>
      </div>
    </section>
  {% endif %}
</div>
<script>
  (function () {
    var gl = document.getElementById('gl-{{ section.id }}');
    if (!gl) return;
    function pick(letter) {
      var isReset = letter.dataset.bg === gl.dataset.pickedBg;
      gl.dataset.pickedBg = isReset ? '' : letter.dataset.bg;
      if (isReset) {
        gl.style.removeProperty('--gl-bg');
      } else {
        gl.style.setProperty('--gl-bg', letter.dataset.bg);
      }
    }
    gl.querySelectorAll('.gl-title em span[data-bg]').forEach(function (s) {
      s.style.cursor = 'pointer';
      s.addEventListener('click', function () { pick(s); });
      s.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(s); }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Game landing",
  "tag": "section",
  "class": "section-game-landing",
  "enabled_on": { "templates": ["product", "page"] },
  "settings": [
    {
      "type": "header",
      "content": "Color palette"
    },
