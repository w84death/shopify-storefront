{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'FungusForayProductForm-' | append: section.id


assign ffdx_logo_url = section.settings.logo_image | image_url: width: 1800
assign ffdx_poster_url =  section.settings.poster_image | image_url: width: 1800
assign ffdx_render_url = section.settings.product_render | image_url: width: 2200
assign ffdx_box_url = section.settings.box_image | image_url: width: 2200
assign ffdx_cart_url = section.settings.cartridge_image | image_url: width: 1000

%}

<section id="ffdx-{{ section.id }}" class="ffdx" data-section-id="{{ section.id }}">
  <a class="ffdx-skip" href="#ffdx-buy-{{ section.id }}">Skip to purchase</a>

  <nav class="ffdx-nav" aria-label="Fungus Foray DX page navigation">
    <a class="ffdx-nav__brand" href="#ffdx-top-{{ section.id }}" aria-label="Fungus Foray DX home">
      <span class="ffdx-nav__spore" aria-hidden="true"></span>
      <span>Fungus Foray DX</span>
    </a>
    <div class="ffdx-nav__links">
      <a href="#ffdx-adventure-{{ section.id }}">Adventure</a>
      <a href="#ffdx-gameplay-{{ section.id }}">Gameplay</a>
      {% if section.settings.show_emulator %}<a href="#ffdx-play-{{ section.id }}">Play</a>{% endif %}
      <a class="ffdx-nav__buy" href="#ffdx-buy-{{ section.id }}">Get the game</a>
    </div>
  </nav>

  <div id="ffdx-top-{{ section.id }}" class="ffdx-storefront">
    <div class="ffdx-storefront__gallery" aria-label="Fungus Foray DX product gallery">
      <div class="ffdx-storefront__main">
        <img
          class="ffdx-storefront__main-image"
          src="{{ ffdx_render_url | strip }}"
          alt="Fungus Foray DX physical edition with box, cartridge, and handheld"
          width="1920"
          height="1080"
          loading="eager"
        >
        <span class="ffdx-storefront__badge">64KB ROM</span>
      </div>
      <div class="ffdx-storefront__thumbs" role="list" aria-label="Choose product image">
        <button class="is-active" type="button" data-ffdx-image="{{ ffdx_render_url | strip }}" data-ffdx-alt="Fungus Foray DX physical edition with box, cartridge, and handheld" aria-label="Show physical edition render">
          <img src="{{ ffdx_render_url | strip }}" alt="" width="160" height="90" loading="lazy">
        </button>
        <button type="button" data-ffdx-image="{{ ffdx_poster_url | strip }}" data-ffdx-alt="Fungus Foray DX illustrated forest poster" aria-label="Show illustrated poster">
          <img src="{{ ffdx_poster_url | strip }}" alt="" width="90" height="128" loading="lazy">
        </button>
        <button type="button" data-ffdx-image="{{ ffdx_box_url | strip }}" data-ffdx-alt="Fungus Foray DX unfolded box artwork" aria-label="Show box artwork">
          <img src="{{ ffdx_box_url | strip }}" alt="" width="160" height="103" loading="lazy">
        </button>
        <button type="button" data-ffdx-image="{{ ffdx_cart_url | strip }}" data-ffdx-alt="Fungus Foray DX Game Boy Color cartridge" aria-label="Show cartridge">
          <img src="{{ ffdx_cart_url | strip }}" alt="" width="140" height="123" loading="lazy">
        </button>
      </div>
    </div>

    <div id="ffdx-buy-{{ section.id }}" class="ffdx-storefront__details">
      <p class="ffdx-kicker">Game Boy Color homebrew</p>
      <img class="ffdx-storefront__logo" src="{{ ffdx_logo_url | strip }}" alt="Fungus Foray DX" width="960" height="540" loading="eager">
      <h1 class="ffdx-visually-hidden">{{ product.title | default: 'Fungus Foray DX' }}</h1>
      <div class="ffdx-rating" aria-label="A tiny forest puzzle adventure">
        <span>PUZZLE</span><span>ADVENTURE</span><span>1–2 PLAYERS</span>
      </div>
      <div class="ffdx-storefront__description">
        {% if product.description != blank %}
          {{ product.description | strip_html | truncatewords: 52 }}
        {% else %}
          Grab your basket and step into the woods. Collect mushrooms, push boulders, dodge creepy crawlers, and race for the highest score in 40 bite-sized puzzles.
        {% endif %}
      </div>

      <div class="ffdx-price" data-ffdx-price>{{ selected_variant.price | money }}</div>
      {% if selected_variant.compare_at_price > selected_variant.price %}
        <div class="ffdx-compare-price">Was {{ selected_variant.compare_at_price | money }}</div>
      {% endif %}

      {% form 'product', product, id: product_form_id, class: 'ffdx-product-form' %}
        {% if product.has_only_default_variant %}
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
        {% else %}
          <label class="ffdx-field-label" for="FungusForayVariant-{{ section.id }}">Choose an edition</label>
          <select id="FungusForayVariant-{{ section.id }}" class="ffdx-select" name="id" data-ffdx-variant>
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                data-price="{{ variant.price | money | escape }}"
                data-available="{{ variant.available }}"
                {% if variant == selected_variant %}selected{% endif %}
              >
                {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}
              </option>
            {% endfor %}
          </select>
        {% endif %}

        <div class="ffdx-purchase-row">
          <label class="ffdx-quantity">
            <span class="ffdx-field-label">Quantity</span>
            <input type="number" name="quantity" min="1" value="1" inputmode="numeric">
          </label>
          <button class="ffdx-add" type="submit" name="add" {% unless selected_variant.available %}disabled{% endunless %} data-ffdx-add>
            <span>{% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
            <span aria-hidden="true">→</span>
          </button>
        </div>
      {% endform %}

      <ul class="ffdx-storefront__promises" role="list">
        <li><strong>Handmade pixels</strong><span>Built from scratch for real hardware.</span></li>
        <li><strong>Progress saved</strong><span>Your high scores stay on the cartridge.</span></li>
        <li><strong>Made in Poland</strong><span>A tiny independent physical release.</span></li>
      </ul>
    </div>
  </div>

  <section id="ffdx-adventure-{{ section.id }}" class="ffdx-adventure" style="--ffdx-poster: url('{{ ffdx_poster_url | strip }}');">
    <div class="ffdx-adventure__mist" aria-hidden="true"></div>
    <div class="ffdx-adventure__content ffdx-reveal">
      <img src="{{ ffdx_logo_url | strip }}" alt="" width="960" height="540" loading="lazy">
      <p>{{ section.settings.hero_tagline }}</p>
      <a class="ffdx-forest-button" href="#ffdx-gameplay-{{ section.id }}">Step into the woods <span aria-hidden="true">↓</span></a>
    </div>
    <div class="ffdx-adventure__facts" aria-label="Game highlights">
      <span><b>40</b> puzzles</span>
      <span><b>3</b> action points</span>
      <span><b>2</b> playable heroes</span>
    </div>
  </section>

  <section id="ffdx-gameplay-{{ section.id }}" class="ffdx-gameplay">
    <div class="ffdx-gameplay__intro ffdx-reveal">
      <p class="ffdx-kicker ffdx-kicker--red">A pocket-sized expedition</p>
      <h2>Collect. Push. Dodge. <em>Outscore.</em></h2>
      <p>Every move counts in a compact forest of mushrooms, boulders, bushes, and hungry little creatures. Plan a route, spend your action points, then make the perfect escape.</p>
    </div>

    <div class="ffdx-feature-track">
      <article class="ffdx-feature ffdx-feature--collect ffdx-reveal">
        <span class="ffdx-feature__number">01</span>
        <div>
          <p class="ffdx-feature__eyebrow">Fill your basket</p>
          <h3>Collect mushrooms</h3>
          <p>Find the best route through the board and gather every valuable mushroom before your movement runs out.</p>
        </div>
        <div class="ffdx-feature__icon" aria-hidden="true">♠</div>
      </article>

      <article class="ffdx-feature ffdx-feature--push ffdx-reveal">
        <span class="ffdx-feature__number">02</span>
        <div>
          <p class="ffdx-feature__eyebrow">Open new paths</p>
          <h3>Push boulders</h3>
          <p>Move heavy stones into useful positions. One clever push can create a shortcut—or block the way home.</p>
        </div>
        <div class="ffdx-feature__icon" aria-hidden="true">●</div>
      </article>

      <article class="ffdx-feature ffdx-feature--dodge ffdx-reveal">
        <span class="ffdx-feature__number">03</span>
        <div>
          <p class="ffdx-feature__eyebrow">Mind the wildlife</p>
          <h3>Dodge crawlers</h3>
          <p>Spiders and forest creatures follow simple patterns. Read them, bait them, and slip safely past.</p>
        </div>
        <div class="ffdx-feature__spider" aria-hidden="true"><i></i></div>
      </article>

      <article class="ffdx-feature ffdx-feature--score ffdx-reveal">
        <span class="ffdx-feature__number">04</span>
        <div>
          <p class="ffdx-feature__eyebrow">Every move counts</p>
          <h3>Chase the high score</h3>
          <p>Finish efficiently, replay every board, and improve your route until every step feels inevitable.</p>
        </div>
        <div class="ffdx-feature__icon" aria-hidden="true">★</div>
      </article>
    </div>
  </section>

  <section class="ffdx-character-section">
    <div class="ffdx-character-section__art" style="--ffdx-poster: url('{{ ffdx_poster_url | strip }}');" role="img" aria-label="Two young adventurers entering a colorful forest"></div>
    <div class="ffdx-character-section__copy ffdx-reveal">
      <p class="ffdx-kicker">Choose your explorer</p>
      <h2>Go alone—or share the trail.</h2>
      <p>Play as the boy, or choose the girl and pass the system to a friend between turns. The rules stay simple, but the best route is always up for debate.</p>
      <div class="ffdx-character-tabs" role="list">
        <span><b>Solo</b>One player, one perfect plan.</span>
        <span><b>Pass & play</b>Take turns and compare scores.</span>
      </div>
    </div>
  </section>

  {% if section.settings.show_emulator %}
    <section id="ffdx-play-{{ section.id }}" class="ffdx-play">
      <div class="ffdx-play__leaf ffdx-play__leaf--one" aria-hidden="true"></div>
      <div class="ffdx-play__leaf ffdx-play__leaf--two" aria-hidden="true"></div>
      <div class="ffdx-play__heading ffdx-reveal">
        <p class="ffdx-kicker">Try it in your browser</p>
        <h2>{{ section.settings.emulator_heading }}</h2>
        <p>The forest is open. Use your keyboard and see how many mushrooms you can bring home.</p>
      </div>
      <div class="ffdx-console ffdx-reveal">
        <div class="ffdx-console__top">
          <span>CYFROWY NOMADA</span>
          <span class="ffdx-console__light">POWER</span>
        </div>
        <div class="ffdx-console__screen">
          {% assign game_url = product.metafields.custom.iframe_game_url.value | default: product.metafields.custom.iframe_game_url %}
          {% if game_url != blank %}
            <iframe
              src="{{ game_url | escape }}"
              title="Play {{ product.title | escape }}"
              loading="lazy"
              allow="fullscreen; gamepad"
              {% if section.settings.allow_fullscreen %}allowfullscreen{% endif %}
            ></iframe>
          {% else %}
            <div class="ffdx-console__placeholder">
              <span>GAME LINK NOT SET</span>
              <small>Add the URL to product metafield<br><b>custom.iframe_game_url</b></small>
            </div>
          {% endif %}
        </div>
        <div class="ffdx-console__controls" aria-label="Keyboard controls">
          <span><kbd>← ↑ ↓ →</kbd> Move</span>
          <span><kbd>X</kbd> A</span>
          <span><kbd>Z</kbd> B</span>
          <span><kbd>Enter</kbd> Start</span>
        </div>
      </div>
    </section>
  {% endif %}

  <section class="ffdx-physical">
    <div class="ffdx-physical__copy ffdx-reveal">
      <p class="ffdx-kicker ffdx-kicker--red">A real cartridge adventure</p>
      <h2>Made for your Game Boy Color.</h2>
      <p>Fungus Foray DX is a small physical homebrew release with a printed box, labeled cartridge, and save support. Put it on the shelf, then take it into the woods.</p>
      <a class="ffdx-forest-button ffdx-forest-button--light" href="#ffdx-buy-{{ section.id }}">Choose your edition <span aria-hidden="true">↑</span></a>
    </div>
    <div class="ffdx-physical__render ffdx-reveal">
      <img src="{{ ffdx_render_url | strip }}" alt="Fungus Foray DX physical release" width="1920" height="1080" loading="lazy">
    </div>
  </section>

  <section class="ffdx-details">
    <div class="ffdx-details__header ffdx-reveal">
      <p class="ffdx-kicker">About this game</p>
      <h2>Small cartridge. Big little adventure.</h2>
    </div>
    <dl class="ffdx-details__grid">
      <div><dt>System</dt><dd>Game Boy Color</dd></div>
      <div><dt>Players</dt><dd>1–2 pass & play</dd></div>
      <div><dt>Genre</dt><dd>Puzzle adventure</dd></div>
      <div><dt>Levels</dt><dd>40 bite-sized puzzles</dd></div>
      <div><dt>Save</dt><dd>Cartridge progress save</dd></div>
      <div><dt>Developer</dt><dd>Cyfrowy Nomada</dd></div>
      <div><dt>Region</dt><dd>Region free</dd></div>
      <div><dt>Language</dt><dd>English</dd></div>
    </dl>
  </section>

  <section class="ffdx-final" style="--ffdx-poster: url('{{ ffdx_poster_url | strip }}');">
    <div class="ffdx-final__inner ffdx-reveal">
      <img src="{{ ffdx_logo_url | strip }}" alt="Fungus Foray DX" width="960" height="540" loading="lazy">
      <p>Your basket is empty. The trail is waiting.</p>
      <a class="ffdx-final__button" href="#ffdx-buy-{{ section.id }}">Get Fungus Foray DX</a>
    </div>
  </section>

  <footer class="ffdx-footer">
    <span>© 2026 Cyfrowy Nomada</span>
    <span>Made in Poland · Made for Game Boy Color</span>
    <a href="/">cyfrowynomada.com</a>
  </footer>
</section>

<style>
  body.template-product--fungus-foray-dedicated-page #header-group,
  body.template-product--fungus-foray-dedicated-page .page-wrapper > footer {
    display: none !important;
  }

  body.template-product--fungus-foray-dedicated-page,
  body.template-product--fungus-foray-dedicated-page .page-wrapper,
  body.template-product--fungus-foray-dedicated-page #MainContent {
    margin: 0;
    padding: 0;
    max-width: none;
    width: 100%;
    background: #f7f1d8;
  }

  #ffdx-{{ section.id }} {
    --ffdx-forest: #052d20;
    --ffdx-deep: #041d17;
    --ffdx-green: #0b5a37;
    --ffdx-teal: #35c2ad;
    --ffdx-sky: #29c8df;
    --ffdx-lime: #bfd33d;
    --ffdx-lime-light: #dbe86d;
    --ffdx-cream: #f7f1d8;
    --ffdx-paper: #fffdf3;
    --ffdx-clay: #c65c3f;
    --ffdx-red: #da251f;
    --ffdx-yellow: #f0c33d;
    --ffdx-ink: #172218;
    --ffdx-shadow: 0 24px 60px rgba(4, 29, 23, .18);
    color: var(--ffdx-ink);
    background: var(--ffdx-cream);
    overflow: clip;
    font-family: var(--font-body--family, Arial, sans-serif);
    line-height: 1.5;
  }

  #ffdx-{{ section.id }} *,
  #ffdx-{{ section.id }} *::before,
  #ffdx-{{ section.id }} *::after { box-sizing: border-box; }

  #ffdx-{{ section.id }} img { display: block; max-width: 100%; }
  #ffdx-{{ section.id }} a { color: inherit; text-decoration: none; }
  #ffdx-{{ section.id }} button,
  #ffdx-{{ section.id }} input,
  #ffdx-{{ section.id }} select { font: inherit; }

  .ffdx-skip {
    position: fixed;
    z-index: 1000;
    top: 12px;
    left: 12px;
    padding: 10px 16px;
    background: #fff;
    color: #000;
    transform: translateY(-150%);
  }
  .ffdx-skip:focus { transform: none; }

  .ffdx-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .ffdx-nav {
    position: sticky;
    z-index: 30;
    top: 0;
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 10px clamp(20px, 4vw, 72px);
    color: #fff;
    background: rgba(4, 29, 23, .94);
    border-bottom: 1px solid rgba(255,255,255,.14);
    backdrop-filter: blur(16px);
  }

  .ffdx-nav__brand {
    display: flex;
    align-items: center;
    gap: 11px;
    font-weight: 950;
    letter-spacing: -.03em;
  }

  .ffdx-nav__spore {
    width: 28px;
    height: 21px;
    border-radius: 50% 50% 42% 42%;
    background: var(--ffdx-clay);
    position: relative;
    box-shadow: inset 0 -4px 0 rgba(0,0,0,.14);
  }
  .ffdx-nav__spore::before {
    content: '';
    position: absolute;
    width: 11px;
    height: 12px;
    left: 8px;
    top: 14px;
    border-radius: 2px 2px 5px 5px;
    background: var(--ffdx-cream);
  }

  .ffdx-nav__links { display: flex; align-items: center; gap: clamp(16px, 2.4vw, 38px); font-size: 14px; font-weight: 850; }
  .ffdx-nav__links > a:not(.ffdx-nav__buy) { opacity: .78; transition: opacity .2s ease, transform .2s ease; }
  .ffdx-nav__links > a:not(.ffdx-nav__buy):hover { opacity: 1; transform: translateY(-2px); }
  .ffdx-nav__buy {
    padding: 11px 18px;
    border-radius: 999px;
    color: var(--ffdx-deep) !important;
    background: var(--ffdx-lime);
    box-shadow: 0 5px 0 #7f9220;
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .ffdx-nav__buy:hover { transform: translateY(2px); box-shadow: 0 3px 0 #7f9220; }

  .ffdx-storefront {
    min-height: calc(100svh - 68px);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(390px, .75fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
    padding: clamp(34px, 6vw, 90px) clamp(22px, 6vw, 110px);
    background:
      radial-gradient(circle at 8% 16%, rgba(53,194,173,.18) 0 9%, transparent 9.2%),
      linear-gradient(135deg, #fffef7 0%, #f7f1d8 62%, #e9edb5 100%);
    position: relative;
  }

  .ffdx-storefront::after {
    content: '';
    position: absolute;
    right: -90px;
    bottom: -110px;
    width: 300px;
    height: 300px;
    border-radius: 58% 42% 45% 55%;
    background: var(--ffdx-teal);
    opacity: .12;
    transform: rotate(18deg);
  }

  .ffdx-storefront__gallery { min-width: 0; }
  .ffdx-storefront__main {
    position: relative;
    overflow: hidden;
    min-height: clamp(360px, 52vw, 690px);
    border-radius: clamp(22px, 3vw, 44px);
    background: #061018;
    box-shadow: var(--ffdx-shadow);
    isolation: isolate;
  }
  .ffdx-storefront__main::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(255,255,255,.16), transparent 34%);
  }
  .ffdx-storefront__main-image {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: contain;
    transition: opacity .2s ease, transform .35s ease;
  }
  .ffdx-storefront__main-image.is-changing { opacity: .3; transform: scale(.985); }
  .ffdx-storefront__badge {
    position: absolute;
    z-index: 2;
    right: 22px;
    bottom: 22px;
    display: grid;
    place-items: center;
    width: 92px;
    aspect-ratio: 1;
    padding: 12px;
    text-align: center;
    border-radius: 50%;
    background: var(--ffdx-yellow);
    color: #9f6e00;
    font-weight: 950;
    line-height: 1.05;
    transform: rotate(-8deg);
    clip-path: polygon(50% 0%,61% 12%,76% 5%,82% 20%,98% 21%,94% 37%,100% 50%,88% 61%,95% 76%,80% 82%,79% 98%,63% 94%,50% 100%,39% 88%,24% 95%,18% 80%,2% 79%,6% 63%,0 50%,12% 39%,5% 24%,20% 18%,21% 2%,37% 6%);
  }

  .ffdx-storefront__thumbs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 16px; }
  .ffdx-storefront__thumbs button {
    min-width: 0;
    height: 92px;
    padding: 7px;
    cursor: pointer;
    border: 3px solid transparent;
    border-radius: 14px;
    background: rgba(255,255,255,.7);
    transition: border-color .2s ease, transform .2s ease, background .2s ease;
  }
  .ffdx-storefront__thumbs button:hover { transform: translateY(-3px); background: #fff; }
  .ffdx-storefront__thumbs button.is-active { border-color: var(--ffdx-green); background: #fff; }
  .ffdx-storefront__thumbs img { width: 100%; height: 100%; object-fit: contain; }

  .ffdx-storefront__details { position: relative; z-index: 1; max-width: 580px; }
  .ffdx-kicker {
    margin: 0 0 14px;
    color: var(--ffdx-green);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  .ffdx-kicker--red { color: var(--ffdx-red); }
  .ffdx-storefront__logo { width: min(100%, 540px); margin: 0 auto; }
  .ffdx-rating { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 24px; }
  .ffdx-rating span {
    padding: 7px 10px;
    border: 2px solid rgba(5,45,32,.16);
    border-radius: 999px;
    background: rgba(255,255,255,.6);
    color: var(--ffdx-green);
    font-size: 11px;
    font-weight: 950;
    letter-spacing: .08em;
  }
  .ffdx-storefront__description { max-width: 52ch; font-size: clamp(16px, 1.35vw, 20px); font-weight: 650; }
  .ffdx-storefront__description p { margin: 0; }
  .ffdx-price { margin-top: 25px; font-size: clamp(30px, 3vw, 46px); font-weight: 950; letter-spacing: -.05em; }
  .ffdx-compare-price { margin-top: -4px; color: #687168; text-decoration: line-through; }

  .ffdx-product-form { margin-top: 20px; }
  .ffdx-field-label { display: block; margin-bottom: 7px; font-size: 12px; font-weight: 950; letter-spacing: .08em; text-transform: uppercase; }
  .ffdx-select,
  .ffdx-quantity input {
    width: 100%;
    min-height: 52px;
    border: 2px solid rgba(5,45,32,.22);
    border-radius: 12px;
    background: rgba(255,255,255,.82);
    color: var(--ffdx-ink);
  }
  .ffdx-select { padding: 0 44px 0 15px; }
  .ffdx-purchase-row { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 12px; align-items: end; margin-top: 14px; }
  .ffdx-quantity input { padding: 0 12px; text-align: center; }
  .ffdx-add {
    min-height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 22px;
