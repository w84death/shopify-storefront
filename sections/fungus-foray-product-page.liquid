</style>

<script>
  (() => {
    const root = document.getElementById('ffdx-{{ section.id }}');
    if (!root || root.dataset.ffdxReady === 'true') return;
    root.dataset.ffdxReady = 'true';

    const mainImage = root.querySelector('.ffdx-storefront__main-image');
    root.querySelectorAll('[data-ffdx-image]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!mainImage) return;
        root.querySelectorAll('[data-ffdx-image]').forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
        mainImage.classList.add('is-changing');
        window.setTimeout(() => {
          mainImage.src = button.dataset.ffdxImage;
          mainImage.alt = button.dataset.ffdxAlt || '';
          mainImage.classList.remove('is-changing');
        }, 150);
      });
    });

    const variantSelect = root.querySelector('[data-ffdx-variant]');
    const price = root.querySelector('[data-ffdx-price]');
    const addButton = root.querySelector('[data-ffdx-add]');
    if (variantSelect) {
      variantSelect.addEventListener('change', () => {
        const option = variantSelect.options[variantSelect.selectedIndex];
        const available = option.dataset.available === 'true';
        if (price && option.dataset.price) price.textContent = option.dataset.price;
        if (addButton) {
          addButton.disabled = !available;
          const label = addButton.querySelector('span');
          if (label) label.textContent = available ? 'Add to cart' : 'Sold out';
        }
      });
    }

    const revealItems = root.querySelectorAll('.ffdx-reveal');
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    }
  })();
</script>

