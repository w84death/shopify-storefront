{% comment %}
  3D Retro Max dedicated Shopify product section.
  Add this file to /sections/3d-retro-max-product-page.liquid.
  The matching JSON product template is included separately.
{% endcomment %}

{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'rm3d-product-form-' | append: section.id
  assign shareware_download_url = product.metafields.custom.shareware_download_url.value
  assign hero_art_image = section.settings.hero_art_image
  assign hero_art_alt = section.settings.hero_art_alt | default: '3D Retro Max on a 3.5-inch floppy disk'

  assign workflow_image = section.settings.workflow_image

  assign modifier_image = section.settings.modifier_image

  assign environment_image = section.settings.environment_image

  assign features_image = section.settings.features_image
  assign features_image_alt = section.settings.features_image_alt | default: '3D Retro Max capabilities overview'
%}

<section
  id="RM3D-{{ section.id }}"
  class="rm3d rm3d--{{ section.settings.visual_density }}"
  data-section-id="{{ section.id }}"
  style="
    --rm3d-bg: {{ section.settings.background }};
    --rm3d-surface: {{ section.settings.surface }};
    --rm3d-surface-2: {{ section.settings.surface_secondary }};
    --rm3d-ink: {{ section.settings.text_color }};
    --rm3d-muted: {{ section.settings.muted_color }};
    --rm3d-line: {{ section.settings.line_color }};
    --rm3d-primary: {{ section.settings.primary_accent }};
    --rm3d-signal: {{ section.settings.signal_accent }};
    --rm3d-radius: {{ section.settings.corner_radius }}px;
    --rm3d-max: {{ section.settings.content_width }}px;
  "
>
  <div class="rm3d__ambient rm3d__ambient--one" aria-hidden="true"></div>
  <div class="rm3d__ambient rm3d__ambient--two" aria-hidden="true"></div>

  <div class="rm3d__topline">
    <div class="rm3d__container rm3d__topline-inner">
      <span>{{ section.settings.topline_left }}</span>
      <span class="rm3d__topline-right">{{ section.settings.topline_right }}</span>
    </div>
  </div>

  <header class="rm3d__hero">
    <div class="rm3d__container rm3d__hero-grid">
      <div class="rm3d__hero-copy rm3d-reveal">
        {% if section.settings.eyebrow != blank %}
          <div class="rm3d__eyebrow">
            <span class="rm3d__eyebrow-mark" aria-hidden="true"></span>
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}

        <h1 class="rm3d__title">
          {{ section.settings.heading | default: product.title | escape }}
        </h1>

        {% if section.settings.subheading != blank %}
          <p class="rm3d__lead">{{ section.settings.subheading }}</p>
        {% endif %}

        <div class="rm3d__signal-row" aria-label="Product highlights">
          {% if section.settings.hero_chip_1 != blank %}<span>{{ section.settings.hero_chip_1 }}</span>{% endif %}
          {% if section.settings.hero_chip_2 != blank %}<span>{{ section.settings.hero_chip_2 }}</span>{% endif %}
          {% if section.settings.hero_chip_3 != blank %}<span>{{ section.settings.hero_chip_3 }}</span>{% endif %}
        </div>

        <div class="rm3d__commerce-panel">
          <div class="rm3d__commerce-head">
            <div>
              <span class="rm3d__commerce-label">{{ section.settings.purchase_label }}</span>
              <div class="rm3d__price" data-rm3d-price>{{ current_variant.price | money }}</div>
              <div class="rm3d__compare{% unless current_variant.compare_at_price > current_variant.price %} is-hidden{% endunless %}" data-rm3d-compare>
                {% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}
              </div>
            </div>
            <div class="rm3d__availability">
              <span class="rm3d__availability-dot{% unless current_variant.available %} is-offline{% endunless %}" data-rm3d-status-dot></span>
              <span data-rm3d-status>
                {% if current_variant.available %}{{ section.settings.available_text }}{% else %}{{ section.settings.sold_out_text }}{% endif %}
              </span>
            </div>
          </div>

          {% form 'product', product, id: product_form_id, class: 'rm3d__product-form' %}
            {% if product.has_only_default_variant %}
              <input type="hidden" name="id" value="{{ current_variant.id }}">
            {% else %}
              <label class="rm3d__field-label" for="RM3DVariant-{{ section.id }}">{{ section.settings.variant_label }}</label>
              <div class="rm3d__select-wrap">
                <select id="RM3DVariant-{{ section.id }}" name="id" data-rm3d-variant>
                  {% for variant in product.variants %}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money | escape }}"
                      data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                      data-available="{{ variant.available }}"
                      {% if variant == current_variant %}selected{% endif %}
                    >
                      {{ variant.title }}{% unless variant.available %} — {{ section.settings.sold_out_text }}{% endunless %}
                    </option>
                  {% endfor %}
                </select>
                <svg aria-hidden="true" viewBox="0 0 16 16"><path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              </div>
            {% endif %}

            <button
              type="submit"
              name="add"
              class="rm3d__buy-button"
              data-rm3d-add
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-rm3d-add-label>{% if current_variant.available %}{{ section.settings.button_label }}{% else %}{{ section.settings.sold_out_text }}{% endif %}</span>
              <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
            </button>

            {% if section.settings.show_dynamic_checkout %}
              <div class="rm3d__dynamic-checkout">{{ form | payment_button }}</div>
            {% endif %}
          {% endform %}

          <div class="rm3d__purchase-notes">
            <span><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 1.5 13 3v4.2c0 3.3-2 5.8-5 7.3-3-1.5-5-4-5-7.3V3l5-1.5Z" fill="none" stroke="currentColor"/><path d="m5.4 7.8 1.6 1.6 3.6-3.7" fill="none" stroke="currentColor"/></svg>{{ section.settings.purchase_note_1 }}</span>
            <span><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 1v9m0 0 3-3m-3 3L5 7M2 13.5h12" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/></svg>{{ section.settings.purchase_note_2 }}</span>
          </div>

          {% if shareware_download_url != blank %}
            <div class="rm3d__shareware-cta">
              <a href="{{ shareware_download_url | escape }}" class="rm3d__shareware-button" download>
                <span>DOWNLOAD FREE SHAREWARE</span>
                <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M10 3v10m0 0 4-4m-4 4L6 9M3 17h14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/></svg>
              </a>
              <p>Same editor and workflow. A short 3-second purchase reminder appears before launch.</p>
            </div>
          {% endif %}
        </div>
      </div>

      <div class="rm3d__hero-visual rm3d__hero-visual--artifact rm3d-reveal">
        <div class="rm3d__artifact-stage">
          <div class="rm3d__artifact-grid" aria-hidden="true"></div>
          <div class="rm3d__artifact-orbit rm3d__artifact-orbit--one" aria-hidden="true"><i></i></div>
          <div class="rm3d__artifact-orbit rm3d__artifact-orbit--two" aria-hidden="true"></div>
          <div class="rm3d__artifact-image">
            {% if hero_art_image != blank %}
              {{ hero_art_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 52vw, 92vw', alt: hero_art_alt }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'rm3d__artifact-placeholder' }}
            {% endif %}
          </div>
          <div class="rm3d__artifact-readout rm3d__artifact-readout--top"><span>MEDIA</span><strong>3.5&quot; FLOPPY</strong></div>
          <div class="rm3d__artifact-readout rm3d__artifact-readout--bottom"><span>BUILD SIZE</span><strong>~790 KB / 1.44 MB</strong></div>
          <div class="rm3d__artifact-stamp">FLOPPY-SCALE<br>3D EDITOR</div>
        </div>
      </div>
    </div>
  </header>

  <div class="rm3d__metric-rail rm3d-reveal">
    <div class="rm3d__container rm3d__metrics">
      <div><strong>{{ section.settings.metric_1_value }}</strong><span>{{ section.settings.metric_1_label }}</span></div>
      <div><strong>{{ section.settings.metric_2_value }}</strong><span>{{ section.settings.metric_2_label }}</span></div>
      <div><strong>{{ section.settings.metric_3_value }}</strong><span>{{ section.settings.metric_3_label }}</span></div>
      <div><strong>{{ section.settings.metric_4_value }}</strong><span>{{ section.settings.metric_4_label }}</span></div>
    </div>
  </div>

  <nav class="rm3d__section-nav" aria-label="Product page sections">
    <div class="rm3d__container rm3d__section-nav-inner">
      <a href="#rm3d-workflow-{{ section.id }}">Workflow</a>
      <a href="#rm3d-features-{{ section.id }}">Capabilities</a>
      <a href="#rm3d-modifiers-{{ section.id }}">Modifier stack</a>
      <a href="#rm3d-environment-{{ section.id }}">Cinematic view</a>
      <a href="#rm3d-specs-{{ section.id }}">Specifications</a>
      <a href="#rm3d-faq-{{ section.id }}">FAQ</a>
    </div>
  </nav>

  <section id="rm3d-workflow-{{ section.id }}" class="rm3d__story rm3d__section">
    <div class="rm3d__container">
      <div class="rm3d__section-heading rm3d-reveal">
        <div class="rm3d__index">01 / WORKFLOW</div>
        <h2>{{ section.settings.workflow_heading }}</h2>
        <p>{{ section.settings.workflow_text }}</p>
      </div>

      <div class="rm3d__story-grid">
        <div class="rm3d__story-media rm3d-reveal">
          {% for block in section.blocks %}
            {% if block.type == 'floating_asset' and block.settings.region == 'workflow' and block.settings.image != blank %}
              <div
                class="rm3d__float rm3d__float--{{ block.settings.animation }}{% if block.settings.hide_mobile %} rm3d__float--desktop{% endif %}"
                style="--float-x:{{ block.settings.x }}%;--float-y:{{ block.settings.y }}%;--float-width:{{ block.settings.width }}px;--float-duration:{{ block.settings.duration }}s;--float-delay:{{ block.settings.delay }}s;--float-opacity:{{ block.settings.opacity | divided_by: 100.0 }};--float-rotate:{{ block.settings.rotation }}deg;"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 480, 640, 800', alt: block.settings.alt }}
              </div>
            {% endif %}
          {% endfor %}

          <div class="rm3d__image-frame">
            <div class="rm3d__frame-label"><span>ORTHOGRAPHIC SYSTEM</span><span>4-VIEW</span></div>
            {% if workflow_image != blank %}
              {{ workflow_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '640, 900, 1200, 1600, 2200', sizes: '(min-width: 990px) 58vw, 100vw', alt: section.settings.workflow_image_alt }}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {% endif %}
          </div>
        </div>

          <div class="rm3d__story-list rm3d-reveal">
            <article><span>01</span><div><h3>Four-view orientation</h3><p>Perspective, Top, Front, and Left views keep every edit spatially grounded.</p></div></article>
            <article><span>02</span><div><h3>Direct transforms</h3><p>Move, scale, and rotate with axis locks, grid snapping, numeric input, and a visible gizmo.</p></div></article>
            <article><span>03</span><div><h3>Mesh-level control</h3><p>Switch between object, vertex, edge, and face operations with viewport picking and raycasts.</p></div></article>
            <article><span>04</span><div><h3>Scene-level context</h3><p>Frame the selection, navigate with orbit and dolly controls, and keep the hierarchy in view.</p></div></article>
          </div>
      </div>
    </div>
  </section>

  <section id="rm3d-features-{{ section.id }}" class="rm3d__features rm3d__section">
    <div class="rm3d__container">
      <div class="rm3d__section-heading rm3d-reveal">
        <div class="rm3d__index">02 / CAPABILITIES</div>
        <h2>{{ section.settings.features_heading }}</h2>
        <p>{{ section.settings.features_text }}</p>
      </div>

      {% if features_image != blank %}
        <div class="rm3d__capabilities-media rm3d-reveal">
          <div class="rm3d__capabilities-media-label"><span>CAPABILITIES / OVERVIEW</span><span>FEATURE MAP</span></div>
          {{ features_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '720, 960, 1200, 1600, 2000, 2400', sizes: '(min-width: 990px) 100vw, 100vw', alt: features_image_alt }}
        </div>
      {% endif %}

      <div class="rm3d__feature-grid">
        {% assign feature_number = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <article class="rm3d__feature rm3d__feature--{{ block.settings.size }}{% if block.settings.image != blank %} rm3d__feature--has-media{% endif %} rm3d-reveal" {{ block.shopify_attributes }}>
              <div class="rm3d__feature-top">
                {% assign feature_number = feature_number | plus: 1 %}
                <span class="rm3d__feature-number">{{ feature_number | prepend: '0' | slice: -2, 2 }}</span>
              </div>
              {% if block.settings.image != blank %}
                {% assign capability_alt = block.settings.image_alt | default: block.settings.title %}
                <div class="rm3d__feature-media">
                  {{ block.settings.image | image_url: width: 960 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800, 960', sizes: '(min-width: 990px) 28vw, 92vw', alt: capability_alt }}
                </div>
              {% endif %}
              <div class="rm3d__feature-copy">
                {% if block.settings.kicker != blank %}<span>{{ block.settings.kicker }}</span>{% endif %}
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
              <div class="rm3d__feature-axis" aria-hidden="true"><i></i><i></i><i></i></div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="rm3d-modifiers-{{ section.id }}" class="rm3d__modifier rm3d__section">
    <div class="rm3d__container rm3d__modifier-grid">
      <div class="rm3d__modifier-copy rm3d-reveal">
        <div class="rm3d__index">03 / NON-DESTRUCTIVE</div>
        <h2>{{ section.settings.modifier_heading }}</h2>
        <p class="rm3d__section-lead">{{ section.settings.modifier_text }}</p>
        <ul class="rm3d__check-list">
          <li>33 built-in operators across six categories</li>
          <li>Add, delete, duplicate, reorder, or clear stack entries</li>
          <li>Enable or disable individual steps during evaluation</li>
          <li>Keep base geometry separate from the evaluated mesh</li>
          <li>Open dedicated settings for every registered modifier</li>
        </ul>
      </div>

        <div class="rm3d__modifier-stage rm3d-reveal">
        <div class="rm3d__modifier-preview">
          {% if modifier_image != blank %}
            {{ modifier_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '640, 900, 1200, 1600, 1800', sizes: '(min-width: 990px) 48vw, 100vw', alt: section.settings.modifier_image_alt }}
          {% else %}
            {{ 'product-2' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="rm3d__stack-panel" aria-label="Example modifier stack">
          <div class="rm3d__stack-head"><span>MODIFIER STACK</span><span>04 ACTIVE</span></div>
          <div class="rm3d__stack-item" style="--order:0"><i></i><span>Taper</span><b>01</b></div>
          <div class="rm3d__stack-item" style="--order:1"><i></i><span>Update UVs</span><b>02</b></div>
          <div class="rm3d__stack-item" style="--order:2"><i></i><span>Array 2D</span><b>03</b></div>
          <div class="rm3d__stack-item is-selected" style="--order:3"><i></i><span>Array Circular</span><b>04</b></div>
          <div class="rm3d__stack-controls"><button type="button" tabindex="-1">UP</button><button type="button" tabindex="-1">DOWN</button><button type="button" tabindex="-1">DUP</button></div>
          </div>
        </div>

        <div class="rm3d__modifier-catalog rm3d-reveal">
          <div class="rm3d__catalog-heading">
            <div>
              <span>BUILT-IN CATALOG</span>
              <strong>33 operators / 6 categories</strong>
            </div>
            <p>Use the stack for controlled deformation, topology work, UV motion, repetition, animation, and mesh quality passes.</p>
          </div>
          <div class="rm3d__catalog-grid">
            <article><span>DEFORM</span><p>Twist / Noise / Taper / Inflate / Bend / Skew / Stretch / Squeeze / Wave / Ripple / Push / Mirror / XForm / Relax</p></article>
            <article><span>TOPOLOGY</span><p>Reverse Normals / Subdivide / Shell / Slice / Cap Holes / Normal / Vertex Weld</p></article>
            <article><span>UV EDIT</span><p>Un-scale UVs / Animated UV</p></article>
            <article><span>ARRAY</span><p>Array 2D / Array Circular</p></article>
            <article><span>ANIMATION DEFORMERS</span><p>Animated Noise / Animated Wave / Pulse Scale / Spin</p></article>
            <article><span>MESH QUALITY</span><p>Spherify / Optimize / Tessellate / Smooth</p></article>
          </div>
        </div>
      </div>
  </section>

  <section id="rm3d-environment-{{ section.id }}" class="rm3d__environment rm3d__section">
    <div class="rm3d__container">
      <div class="rm3d__environment-card rm3d-reveal">
        <div class="rm3d__environment-copy">
          <div class="rm3d__index">04 / PRESENTATION</div>
          <h2>{{ section.settings.environment_heading }}</h2>
          <p>{{ section.settings.environment_text }}</p>
          <div class="rm3d__environment-tags"><span>FOV</span><span>FOG</span><span>TIME</span><span>SKY</span><span>POST</span><span>CONTACT</span></div>
        </div>
        <div class="rm3d__environment-media">
          {% if environment_image != blank %}
            {{ environment_image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '640, 900, 1200, 1600, 2200', sizes: '(min-width: 990px) 58vw, 100vw', alt: section.settings.environment_image_alt }}
          {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {% endif %}
          <div class="rm3d__sun-orbit" aria-hidden="true"><i></i><b></b></div>
        </div>
      </div>
    </div>
  </section>

  <section class="rm3d__footprint rm3d__section">
    <div class="rm3d__container rm3d__footprint-grid">
      <div class="rm3d__footprint-number rm3d-reveal">
        <span>APPLICATION SIZE</span>
        <strong>{{ section.settings.footprint_value }}</strong>
        <em>{{ section.settings.footprint_suffix }}</em>
      </div>
      <div class="rm3d__footprint-copy rm3d-reveal">
        <div class="rm3d__index">05 / ENGINEERING</div>
        <h2>{{ section.settings.footprint_heading }}</h2>
        <p>{{ section.settings.footprint_text }}</p>
        <div class="rm3d__binary" aria-hidden="true">00110011 01000100 01010010 01000101 01010100 01010010 01001111</div>
      </div>
    </div>
  </section>

  <section id="rm3d-specs-{{ section.id }}" class="rm3d__specs rm3d__section">
    <div class="rm3d__container">
      <div class="rm3d__section-heading rm3d-reveal">
        <div class="rm3d__index">06 / SPECIFICATION</div>
        <h2>{{ section.settings.specs_heading }}</h2>
      </div>

      <div class="rm3d__spec-table rm3d-reveal">
        <div class="rm3d__spec-row"><span>Renderer</span><strong>OpenGL 1.1 fixed-function pipeline</strong><em>Immediate mode</em></div>
        <div class="rm3d__spec-row"><span>Workflow</span><strong>Viewport-based polygon modeling</strong><em>Object / vertex / edge / face</em></div>
        <div class="rm3d__spec-row"><span>Modifiers</span><strong>33 built-in operators</strong><em>Deform / Topology / UV / Array / Animation / Quality</em></div>
        <div class="rm3d__spec-row"><span>Animation</span><strong>Keyframe timeline and clips</strong><em>Step and linear interpolation</em></div>
        <div class="rm3d__spec-row"><span>Executable</span><strong>Approximately 790 KB</strong><em>Current UPX-compressed build</em></div>
        <div class="rm3d__spec-row"><span>Memory</span><strong>Scene-dependent usage</strong><em>Estimated mesh memory is available in the editor</em></div>
        <div class="rm3d__spec-row"><span>Platform</span><strong>Windows Win32 / i386</strong><em>Portable executable</em></div>
        <div class="rm3d__spec-row"><span>Dependencies</span><strong>System OpenGL + GLU</strong><em>No .NET runtime</em></div>
        <div class="rm3d__spec-row"><span>Project file</span><strong>Human-readable .3drm text</strong><em>Current format version 8 / legacy loading from v1</em></div>
      </div>

      <div class="rm3d__compatibility rm3d-reveal">
        <div><span class="rm3d__compat-label">TARGET SYSTEMS</span><strong>Windows XP → Windows 11</strong></div>
        <p>{{ section.settings.compatibility_note }}</p>
      </div>
    </div>
  </section>

  <section id="rm3d-faq-{{ section.id }}" class="rm3d__faq rm3d__section">
    <div class="rm3d__container rm3d__faq-grid">
      <div class="rm3d__faq-intro rm3d-reveal">
        <div class="rm3d__index">07 / SUPPORT</div>
        <h2>{{ section.settings.faq_heading }}</h2>
        <p>{{ section.settings.faq_text }}</p>
      </div>
      <div class="rm3d__faq-list rm3d-reveal">
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            <details class="rm3d__faq-item" {{ block.shopify_attributes }}>
              <summary><span>{{ block.settings.question }}</span><i aria-hidden="true"></i></summary>
              <div class="rm3d__faq-answer rte">{{ block.settings.answer }}</div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="rm3d__final">
    {% for block in section.blocks %}
      {% if block.type == 'floating_asset' and block.settings.region == 'final' and block.settings.image != blank %}
        <div
          class="rm3d__float rm3d__float--{{ block.settings.animation }}{% if block.settings.hide_mobile %} rm3d__float--desktop{% endif %}"
          style="--float-x:{{ block.settings.x }}%;--float-y:{{ block.settings.y }}%;--float-width:{{ block.settings.width }}px;--float-duration:{{ block.settings.duration }}s;--float-delay:{{ block.settings.delay }}s;--float-opacity:{{ block.settings.opacity | divided_by: 100.0 }};--float-rotate:{{ block.settings.rotation }}deg;"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '120, 180, 240, 360, 480, 640, 800', alt: block.settings.alt }}
        </div>
      {% endif %}
    {% endfor %}

    <div class="rm3d__container rm3d__final-inner rm3d-reveal">
      <span class="rm3d__final-kicker">{{ section.settings.final_kicker }}</span>
      <h2>{{ section.settings.final_heading }}</h2>
      <p>{{ section.settings.final_text }}</p>
      <a class="rm3d__final-button" href="#{{ product_form_id }}">
        {{ section.settings.final_button }}
        <svg aria-hidden="true" viewBox="0 0 20 20"><path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
      </a>
    </div>
  </section>

  <footer class="rm3d__manifesto-ref">
    <div class="rm3d__container rm3d__manifesto-inner">
      <span>SMALL SOFTWARE / 3.5&quot; FLOPPY SCALE</span>
      <p>The current packaged executable is approximately 790 KB, comfortably below the 1.44 MB capacity of a standard 3.5-inch floppy disk.</p>
      <a href="https://fitsonafloppy.com/" target="_blank" rel="noopener noreferrer">Read the Fits on a Floppy manifesto <span aria-hidden="true">-&gt;</span></a>
    </div>
  </footer>
</section>

{% style %}
  #RM3D-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--rm3d-bg);
    color: var(--rm3d-ink);
    font-family: var(--font-body-family, Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
    line-height: 1.5;
  }

  #RM3D-{{ section.id }} *,
  #RM3D-{{ section.id }} *::before,
  #RM3D-{{ section.id }} *::after { box-sizing: border-box; }

  #RM3D-{{ section.id }} img { display: block; max-width: 100%; }
  #RM3D-{{ section.id }} button,
  #RM3D-{{ section.id }} select { font: inherit; }
  #RM3D-{{ section.id }} a { color: inherit; }

  #RM3D-{{ section.id }}::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -3;
    pointer-events: none;
    opacity: .34;
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--rm3d-line) 46%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--rm3d-line) 34%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(to bottom, #000 0%, transparent 43%);
  }

  #RM3D-{{ section.id }} .rm3d__container {
    width: min(calc(100% - 40px), var(--rm3d-max));
    margin-inline: auto;
  }

  #RM3D-{{ section.id }} .rm3d__ambient {
    position: absolute;
    z-index: -2;
    width: 46rem;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(100px);
    opacity: .17;
    pointer-events: none;
  }
  #RM3D-{{ section.id }} .rm3d__ambient--one { top: 3rem; right: -20rem; background: var(--rm3d-primary); }
  #RM3D-{{ section.id }} .rm3d__ambient--two { top: 54rem; left: -27rem; background: var(--rm3d-signal); opacity: .1; }

  #RM3D-{{ section.id }} .rm3d__topline {
    border-bottom: 1px solid var(--rm3d-line);
    color: var(--rm3d-muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }
  #RM3D-{{ section.id }} .rm3d__topline-inner {
    min-height: 34px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  #RM3D-{{ section.id }} .rm3d__hero { padding: clamp(56px, 8vw, 118px) 0 54px; }
  #RM3D-{{ section.id }} .rm3d__hero-grid {
    display: grid;
    grid-template-columns: minmax(330px, .82fr) minmax(520px, 1.28fr);
    align-items: center;
    gap: clamp(42px, 6vw, 92px);
  }

  #RM3D-{{ section.id }} .rm3d__eyebrow,
  #RM3D-{{ section.id }} .rm3d__index {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--rm3d-primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  #RM3D-{{ section.id }} .rm3d__eyebrow-mark {
    width: 7px;
    height: 7px;
    background: var(--rm3d-signal);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--rm3d-signal) 18%, transparent);
  }

  #RM3D-{{ section.id }} .rm3d__title {
    max-width: 760px;
    margin: 24px 0 24px;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(3.1rem, 6.4vw, 7.3rem);
    font-weight: 650;
    letter-spacing: -.065em;
    line-height: .89;
    text-wrap: balance;
  }
  #RM3D-{{ section.id }} .rm3d__lead {
    max-width: 660px;
    margin: 0;
    color: var(--rm3d-muted);
    font-size: clamp(1.02rem, 1.45vw, 1.28rem);
    line-height: 1.6;
  }

  #RM3D-{{ section.id }} .rm3d__signal-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }
  #RM3D-{{ section.id }} .rm3d__signal-row span {
    padding: 7px 10px;
    border: 1px solid var(--rm3d-line);
    background: color-mix(in srgb, var(--rm3d-surface) 74%, transparent);
    color: var(--rm3d-muted);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  #RM3D-{{ section.id }} .rm3d__commerce-panel {
    max-width: 610px;
    margin-top: 34px;
    padding: 18px;
    border: 1px solid var(--rm3d-line);
    border-radius: calc(var(--rm3d-radius) * .7);
    background: color-mix(in srgb, var(--rm3d-surface) 90%, transparent);
    box-shadow: 0 28px 90px rgba(0,0,0,.16);
    backdrop-filter: blur(18px);
  }
  #RM3D-{{ section.id }} .rm3d__commerce-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 14px;
  }
  #RM3D-{{ section.id }} .rm3d__commerce-label,
  #RM3D-{{ section.id }} .rm3d__field-label {
    display: block;
    margin-bottom: 3px;
    color: var(--rm3d-muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  #RM3D-{{ section.id }} .rm3d__price { font-size: 25px; font-weight: 750; letter-spacing: -.03em; }
  #RM3D-{{ section.id }} .rm3d__compare { color: var(--rm3d-muted); font-size: 12px; text-decoration: line-through; }
  #RM3D-{{ section.id }} .is-hidden { display: none !important; }
  #RM3D-{{ section.id }} .rm3d__availability {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 7px;
    color: var(--rm3d-muted);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  #RM3D-{{ section.id }} .rm3d__availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #35d07f;
    box-shadow: 0 0 0 5px rgba(53,208,127,.12);
  }
  #RM3D-{{ section.id }} .rm3d__availability-dot.is-offline { background: #f25a5a; box-shadow: 0 0 0 5px rgba(242,90,90,.12); }

  #RM3D-{{ section.id }} .rm3d__product-form { display: grid; grid-template-columns: 1fr auto; gap: 10px; }
  #RM3D-{{ section.id }} .rm3d__field-label { grid-column: 1 / -1; margin-bottom: -4px; }
  #RM3D-{{ section.id }} .rm3d__select-wrap { position: relative; min-width: 170px; }
  #RM3D-{{ section.id }} .rm3d__select-wrap select {
    width: 100%;
    height: 50px;
    padding: 0 42px 0 14px;
    appearance: none;
    border: 1px solid var(--rm3d-line);
    border-radius: 2px;
    background: var(--rm3d-bg);
    color: var(--rm3d-ink);
  }
  #RM3D-{{ section.id }} .rm3d__select-wrap svg { position: absolute; right: 14px; top: 50%; width: 15px; transform: translateY(-50%); pointer-events: none; }
  #RM3D-{{ section.id }} .rm3d__buy-button,
  #RM3D-{{ section.id }} .rm3d__final-button {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 0 20px;
    border: 1px solid var(--rm3d-primary);
    border-radius: 2px;
    background: var(--rm3d-primary);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .06em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
  }
  #RM3D-{{ section.id }} .rm3d__buy-button:hover,
  #RM3D-{{ section.id }} .rm3d__final-button:hover { transform: translateY(-2px); box-shadow: 0 16px 34px color-mix(in srgb, var(--rm3d-primary) 28%, transparent); }
  #RM3D-{{ section.id }} .rm3d__buy-button:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }
  #RM3D-{{ section.id }} .rm3d__buy-button svg,
  #RM3D-{{ section.id }} .rm3d__final-button svg { width: 18px; flex: 0 0 auto; }
  #RM3D-{{ section.id }} .rm3d__dynamic-checkout { grid-column: 1 / -1; }
  #RM3D-{{ section.id }} .rm3d__purchase-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 14px;
    padding-top: 13px;
    border-top: 1px solid var(--rm3d-line);
    color: var(--rm3d-muted);
    font-size: 10px;
    font-weight: 650;
    text-transform: uppercase;
  }
  #RM3D-{{ section.id }} .rm3d__purchase-notes span { display: inline-flex; align-items: center; gap: 7px; }
  #RM3D-{{ section.id }} .rm3d__purchase-notes svg { width: 15px; color: var(--rm3d-primary); }
  #RM3D-{{ section.id }} .rm3d__shareware-cta { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--rm3d-line); }
  #RM3D-{{ section.id }} .rm3d__shareware-button { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 0 13px; border: 1px solid color-mix(in srgb, var(--rm3d-signal) 62%, var(--rm3d-line)); background: color-mix(in srgb, var(--rm3d-signal) 9%, transparent); color: var(--rm3d-ink); font-size: 10px; font-weight: 800; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; transition: background .25s ease, border-color .25s ease, transform .25s ease; }
  #RM3D-{{ section.id }} .rm3d__shareware-button:hover { border-color: var(--rm3d-signal); background: color-mix(in srgb, var(--rm3d-signal) 17%, transparent); transform: translateY(-2px); }
  #RM3D-{{ section.id }} .rm3d__shareware-button svg { width: 18px; flex: 0 0 auto; color: var(--rm3d-signal); }
  #RM3D-{{ section.id }} .rm3d__shareware-cta p { margin: 8px 0 0; color: var(--rm3d-muted); font-size: 9px; line-height: 1.45; }

  #RM3D-{{ section.id }} .rm3d__hero-visual { position: relative; min-width: 0; perspective: 1200px; }
  #RM3D-{{ section.id }} .rm3d__hero-visual--artifact { perspective: none; }
  #RM3D-{{ section.id }} .rm3d__artifact-stage {
    position: relative;
    min-height: 640px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--rm3d-line);
    border-radius: var(--rm3d-radius);
    background: radial-gradient(circle at 50% 48%, color-mix(in srgb, var(--rm3d-primary) 14%, transparent), transparent 42%), #080d15;
    box-shadow: 0 42px 120px rgba(0,0,0,.3);
  }
  #RM3D-{{ section.id }} .rm3d__artifact-grid {
    position: absolute;
    inset: 0;
    opacity: .42;
    background-image: linear-gradient(to right, rgba(89,124,170,.17) 1px, transparent 1px), linear-gradient(to bottom, rgba(89,124,170,.17) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(circle at 50% 50%, #000 0%, transparent 73%);
  }
  #RM3D-{{ section.id }} .rm3d__artifact-orbit { position: absolute; z-index: 1; width: 78%; aspect-ratio: 2.15; border: 1px solid color-mix(in srgb, var(--rm3d-primary) 38%, transparent); border-radius: 50%; transform: rotate(-19deg); opacity: .58; }
  #RM3D-{{ section.id }} .rm3d__artifact-orbit--two { width: 66%; aspect-ratio: 1.85; transform: rotate(62deg); border-color: color-mix(in srgb, var(--rm3d-signal) 32%, transparent); opacity: .35; }
  #RM3D-{{ section.id }} .rm3d__artifact-orbit--one { animation: rm3d-artifact-orbit 18s linear infinite; }
  #RM3D-{{ section.id }} .rm3d__artifact-orbit i { position: absolute; left: 8%; top: 4%; width: 9px; height: 9px; border-radius: 50%; background: var(--rm3d-signal); box-shadow: 0 0 25px color-mix(in srgb, var(--rm3d-signal) 80%, transparent); }
  #RM3D-{{ section.id }} .rm3d__artifact-image { position: relative; z-index: 3; width: min(84%, 650px); animation: rm3d-artifact-float 7s ease-in-out infinite; filter: drop-shadow(0 34px 30px rgba(0,0,0,.48)); }
  #RM3D-{{ section.id }} .rm3d__artifact-image img { width: 100%; height: auto; object-fit: contain; }
  #RM3D-{{ section.id }} .rm3d__artifact-placeholder { width: min(84%, 650px); aspect-ratio: 1.45; color: #3e5874; opacity: .6; }
  #RM3D-{{ section.id }} .rm3d__artifact-readout { position: absolute; z-index: 4; display: grid; gap: 5px; padding: 10px 12px; border-left: 2px solid var(--rm3d-signal); background: rgba(5,9,15,.76); color: var(--rm3d-muted); font-size: 8px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; backdrop-filter: blur(10px); }
  #RM3D-{{ section.id }} .rm3d__artifact-readout strong { color: var(--rm3d-ink); font-size: 12px; letter-spacing: .04em; }
  #RM3D-{{ section.id }} .rm3d__artifact-readout--top { top: 11%; right: 5%; }
  #RM3D-{{ section.id }} .rm3d__artifact-readout--bottom { bottom: 11%; left: 5%; border-left-color: var(--rm3d-primary); }
  #RM3D-{{ section.id }} .rm3d__artifact-stamp { position: absolute; z-index: 4; right: 6%; bottom: 8%; color: color-mix(in srgb, var(--rm3d-primary) 72%, var(--rm3d-muted)); font: 800 9px/1.5 ui-monospace, monospace; letter-spacing: .14em; text-align: right; }
  #RM3D-{{ section.id }} .rm3d__float {
    position: absolute;
    z-index: 12;
    left: var(--float-x);
    top: var(--float-y);
    width: min(var(--float-width), 40vw);
    opacity: var(--float-opacity);
    pointer-events: none;
    transform: translate(-50%, -50%) rotate(var(--float-rotate));
    transform-origin: 50% 50%;
    filter: drop-shadow(0 26px 35px rgba(0,0,0,.28));
  }
  #RM3D-{{ section.id }} .rm3d__float img { width: 100%; height: auto; }
  #RM3D-{{ section.id }} .rm3d__float--float { animation: rm3d-float var(--float-duration) ease-in-out var(--float-delay) infinite; }
  #RM3D-{{ section.id }} .rm3d__float--rotate { animation: rm3d-rotate var(--float-duration) linear var(--float-delay) infinite; }
  #RM3D-{{ section.id }} .rm3d__float--drift { animation: rm3d-drift var(--float-duration) ease-in-out var(--float-delay) infinite; }
  #RM3D-{{ section.id }} .rm3d__float--pulse { animation: rm3d-object-pulse var(--float-duration) ease-in-out var(--float-delay) infinite; }

  #RM3D-{{ section.id }} .rm3d__metric-rail { border-block: 1px solid var(--rm3d-line); background: color-mix(in srgb, var(--rm3d-surface) 75%, transparent); }
  #RM3D-{{ section.id }} .rm3d__metrics { display: grid; grid-template-columns: repeat(4, 1fr); }
  #RM3D-{{ section.id }} .rm3d__metrics > div { min-height: 122px; display: flex; flex-direction: column; justify-content: center; padding: 22px 28px; border-right: 1px solid var(--rm3d-line); }
  #RM3D-{{ section.id }} .rm3d__metrics > div:first-child { border-left: 1px solid var(--rm3d-line); }
  #RM3D-{{ section.id }} .rm3d__metrics strong { font-size: clamp(1.8rem, 3vw, 3.4rem); font-weight: 620; letter-spacing: -.055em; line-height: 1; }
  #RM3D-{{ section.id }} .rm3d__metrics span { margin-top: 8px; color: var(--rm3d-muted); font-size: 9px; font-weight: 750; letter-spacing: .13em; text-transform: uppercase; }

  #RM3D-{{ section.id }} .rm3d__section-nav {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--rm3d-line);
    background: color-mix(in srgb, var(--rm3d-bg) 88%, transparent);
    backdrop-filter: blur(16px);
  }
  #RM3D-{{ section.id }} .rm3d__section-nav-inner { display: flex; gap: 28px; overflow-x: auto; scrollbar-width: none; }
  #RM3D-{{ section.id }} .rm3d__section-nav-inner::-webkit-scrollbar { display: none; }
  #RM3D-{{ section.id }} .rm3d__section-nav a { flex: 0 0 auto; padding: 15px 0 13px; color: var(--rm3d-muted); font-size: 9px; font-weight: 750; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; transition: color .2s ease; }
  #RM3D-{{ section.id }} .rm3d__section-nav a:hover { color: var(--rm3d-primary); }

  #RM3D-{{ section.id }} .rm3d__section { padding: clamp(84px, 11vw, 164px) 0; }
  #RM3D-{{ section.id }} .rm3d__section-heading { display: grid; grid-template-columns: minmax(150px, .45fr) 1.15fr .8fr; gap: 40px; align-items: start; margin-bottom: 64px; }
  #RM3D-{{ section.id }} .rm3d__section-heading h2,
  #RM3D-{{ section.id }} .rm3d__modifier-copy h2,
  #RM3D-{{ section.id }} .rm3d__environment-copy h2,
  #RM3D-{{ section.id }} .rm3d__footprint-copy h2,
  #RM3D-{{ section.id }} .rm3d__faq-intro h2,
  #RM3D-{{ section.id }} .rm3d__final h2 {
    margin: 0;
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2.25rem, 4.7vw, 5rem);
    font-weight: 620;
    letter-spacing: -.055em;
    line-height: .98;
    text-wrap: balance;
  }
  #RM3D-{{ section.id }} .rm3d__section-heading > p,
  #RM3D-{{ section.id }} .rm3d__section-lead,
  #RM3D-{{ section.id }} .rm3d__environment-copy p,
  #RM3D-{{ section.id }} .rm3d__footprint-copy p,
  #RM3D-{{ section.id }} .rm3d__faq-intro p,
  #RM3D-{{ section.id }} .rm3d__final p { margin: 0; color: var(--rm3d-muted); font-size: 1rem; line-height: 1.7; }

  #RM3D-{{ section.id }} .rm3d__story { background: color-mix(in srgb, var(--rm3d-surface) 30%, transparent); }
  #RM3D-{{ section.id }} .rm3d__story-grid { display: grid; grid-template-columns: 1.45fr .55fr; gap: clamp(36px, 6vw, 88px); align-items: center; }
  #RM3D-{{ section.id }} .rm3d__story-media { position: relative; min-width: 0; }
  #RM3D-{{ section.id }} .rm3d__image-frame { position: relative; overflow: hidden; border: 1px solid var(--rm3d-line); border-radius: var(--rm3d-radius); background: var(--rm3d-surface); box-shadow: 0 34px 100px rgba(0,0,0,.22); }
  #RM3D-{{ section.id }} .rm3d__image-frame img,
  #RM3D-{{ section.id }} .rm3d__image-frame svg { width: 100%; aspect-ratio: 1.48; object-fit: cover; }
  #RM3D-{{ section.id }} .rm3d__frame-label { display: flex; justify-content: space-between; padding: 10px 12px; border-bottom: 1px solid var(--rm3d-line); color: var(--rm3d-muted); font-size: 8px; font-weight: 800; letter-spacing: .12em; }
  #RM3D-{{ section.id }} .rm3d__story-list { border-top: 1px solid var(--rm3d-line); }
  #RM3D-{{ section.id }} .rm3d__story-list article { display: grid; grid-template-columns: 38px 1fr; gap: 18px; padding: 24px 0; border-bottom: 1px solid var(--rm3d-line); }
  #RM3D-{{ section.id }} .rm3d__story-list article > span { color: var(--rm3d-primary); font: 800 9px/1 ui-monospace, monospace; }
  #RM3D-{{ section.id }} .rm3d__story-list h3 { margin: 0 0 7px; font-size: 1rem; letter-spacing: -.02em; }
  #RM3D-{{ section.id }} .rm3d__story-list p { margin: 0; color: var(--rm3d-muted); font-size: .86rem; line-height: 1.55; }

  #RM3D-{{ section.id }} .rm3d__capabilities-media { overflow: hidden; margin: -18px 0 42px; border: 1px solid var(--rm3d-line); border-radius: var(--rm3d-radius); background: #080d14; box-shadow: 0 30px 90px rgba(0,0,0,.18); }
  #RM3D-{{ section.id }} .rm3d__capabilities-media-label { display: flex; justify-content: space-between; gap: 18px; padding: 10px 12px; border-bottom: 1px solid var(--rm3d-line); color: var(--rm3d-muted); font-size: 8px; font-weight: 800; letter-spacing: .12em; }
  #RM3D-{{ section.id }} .rm3d__capabilities-media img { width: 100%; aspect-ratio: 2.35; object-fit: cover; }

  #RM3D-{{ section.id }} .rm3d__feature-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; }
  #RM3D-{{ section.id }} .rm3d__feature {
    position: relative;
    min-height: 330px;
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 26px;
    border: 1px solid var(--rm3d-line);
    border-radius: calc(var(--rm3d-radius) * .8);
    background: linear-gradient(145deg, color-mix(in srgb, var(--rm3d-surface) 96%, transparent), color-mix(in srgb, var(--rm3d-surface-2) 78%, transparent));
    transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease;
  }
  #RM3D-{{ section.id }} .rm3d__feature:hover { transform: translateY(-5px); border-color: color-mix(in srgb, var(--rm3d-primary) 60%, var(--rm3d-line)); box-shadow: 0 30px 75px rgba(0,0,0,.14); }
  #RM3D-{{ section.id }} .rm3d__feature--wide { grid-column: span 8; }
  #RM3D-{{ section.id }} .rm3d__feature--half { grid-column: span 6; }
