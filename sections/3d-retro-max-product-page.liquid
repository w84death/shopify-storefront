    #RM3D-{{ section.id }} .rm3d__manifesto-inner { grid-template-columns: 1fr; gap: 10px; padding-block: 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    #RM3D-{{ section.id }} *,
    #RM3D-{{ section.id }} *::before,
    #RM3D-{{ section.id }} *::after { scroll-behavior: auto !important; animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
    #RM3D-{{ section.id }} .rm3d-reveal { opacity: 1; transform: none; }
  }
{% endstyle %}

<script>
  (() => {
    const initRM3D = (root) => {
      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const variantSelect = root.querySelector('[data-rm3d-variant]');
      if (variantSelect) {
        const price = root.querySelector('[data-rm3d-price]');
        const compare = root.querySelector('[data-rm3d-compare]');
        const status = root.querySelector('[data-rm3d-status]');
        const statusDot = root.querySelector('[data-rm3d-status-dot]');
        const add = root.querySelector('[data-rm3d-add]');
        const addLabel = root.querySelector('[data-rm3d-add-label]');
        const availableText = {{ section.settings.available_text | json }};
        const soldOutText = {{ section.settings.sold_out_text | json }};
        const buttonText = {{ section.settings.button_label | json }};

        const updateVariant = () => {
          const option = variantSelect.options[variantSelect.selectedIndex];
          const available = option.dataset.available === 'true';
          if (price) price.textContent = option.dataset.price || '';
          if (compare) {
            compare.textContent = option.dataset.compare || '';
            compare.classList.toggle('is-hidden', !option.dataset.compare);
          }
          if (status) status.textContent = available ? availableText : soldOutText;
          if (statusDot) statusDot.classList.toggle('is-offline', !available);
          if (add) add.disabled = !available;
          if (addLabel) addLabel.textContent = available ? buttonText : soldOutText;
        };
        variantSelect.addEventListener('change', updateVariant);
        updateVariant();
      }

      const revealItems = root.querySelectorAll('.rm3d-reveal');
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('is-visible'));
      }

    };

    window.RM3DInit = initRM3D;
    initRM3D(document.getElementById('RM3D-{{ section.id }}'));

    if (!window.RM3DEditorEventsBound) {
      window.RM3DEditorEventsBound = true;
      document.addEventListener('shopify:section:load', (event) => {
        const sectionRoot = event.target.querySelector?.('.rm3d') || (event.target.matches?.('.rm3d') ? event.target : null);
        if (sectionRoot) window.RM3DInit(sectionRoot);
      });
    }
  })();
</script>

