{% comment %}
  Catalog page — renders a standard page (title + rich text) in the
  "Mail-order catalogue" style. Add it to any page template
  (e.g. Contact, About) in place of the generic blocks layout.
  Fonts are self-hosted from theme assets.
{% endcomment %}

{%- style -%}
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  #shopify-section-{{ section.id }} .cnp {
    --paper: {{ section.settings.color_bg }};
    --navy: {{ section.settings.color_ink }};
    --red: {{ section.settings.color_accent }};
    --dim: {{ section.settings.color_muted }};
    --rule: {{ section.settings.color_line }};
    --paper2: {{ section.settings.color_card }};
    --mono: ui-monospace, "Cascadia Mono", "JetBrains Mono", Consolas, monospace;
    --display: "WDXL Lubrifont JP N", "Fredoka", "Nunito", sans-serif;
    background: var(--paper);
    color: var(--navy);
    font-family: "Nunito", "Trebuchet MS", "Avenir Next", "Segoe UI", sans-serif;
    line-height: 1.55;
    padding-bottom: 60px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  #shopify-section-{{ section.id }} .cnp * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .cnp a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .cnp :focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .cnp-wrap { width: min(760px, calc(100% - 40px)); margin: 0 auto; }
  #shopify-section-{{ section.id }} .cnp h1,
  #shopify-section-{{ section.id }} .cnp h2,
  #shopify-section-{{ section.id }} .cnp h3 {
    font-family: var(--display); font-weight: 650; letter-spacing: -.02em;
    text-wrap: balance; margin: 0;
  }

  #shopify-section-{{ section.id }} .cnp-ticker {
    background: var(--navy); color: var(--paper);
    font-family: var(--mono); font-size: 11.5px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; text-align: center;
    padding: 8px 12px; margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .cnp-ticker b { color: #F6C94A; }

  #shopify-section-{{ section.id }} .cnp-kicker {
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--red);
  }
  #shopify-section-{{ section.id }} .cnp-head {
    text-align: center; padding: 52px 0 36px; border-bottom: 3px double var(--navy);
    margin-bottom: 36px;
  }
  #shopify-section-{{ section.id }} .cnp-head h1 { font-size: clamp(38px, 5.4vw, 68px); line-height: .95; margin: 14px 0 12px; }

  /* rich text */
  #shopify-section-{{ section.id }} .cnp-rte { font-size: 17px; }
  #shopify-section-{{ section.id }} .cnp-rte h2 {
    font-size: clamp(28px, 3.4vw, 38px); line-height: 1.05; margin: 36px 0 12px;
  }
  #shopify-section-{{ section.id }} .cnp-rte h3 {
    font-size: clamp(22px, 2.6vw, 28px); line-height: 1.1; margin: 28px 0 10px;
  }
  #shopify-section-{{ section.id }} .cnp-rte h4 { font-family: var(--display); font-size: 20px; margin: 24px 0 8px; }
  #shopify-section-{{ section.id }} .cnp-rte p { margin: 0 0 18px; }
  #shopify-section-{{ section.id }} .cnp-rte a {
    color: var(--red); font-weight: 700;
    text-decoration: underline; text-underline-offset: 3px;
  }
  #shopify-section-{{ section.id }} .cnp-rte ul,
  #shopify-section-{{ section.id }} .cnp-rte ol { margin: 0 0 18px; padding-left: 24px; }
  #shopify-section-{{ section.id }} .cnp-rte li { margin-bottom: 8px; }
  #shopify-section-{{ section.id }} .cnp-rte li::marker { color: var(--red); }
  #shopify-section-{{ section.id }} .cnp-rte img,
  #shopify-section-{{ section.id }} .cnp-rte iframe,
  #shopify-section-{{ section.id }} .cnp-rte video {
    max-width: 100%; border-radius: 8px; border: 2px solid var(--navy);
  }
  #shopify-section-{{ section.id }} .cnp-rte blockquote {
    margin: 24px 0; padding: 4px 0 4px 18px;
    border-left: 4px solid var(--red); color: var(--dim); font-style: italic;
  }
  #shopify-section-{{ section.id }} .cnp-rte pre {
    background: var(--navy); color: #F6F1E3;
    border-radius: 8px; padding: 16px 20px; overflow-x: auto;
    font-family: var(--mono); font-size: 13.5px; line-height: 1.6; margin: 0 0 18px;
  }
  #shopify-section-{{ section.id }} .cnp-rte code {
    font-family: var(--mono); font-size: 0.9em;
    background: color-mix(in srgb, var(--red) 12%, transparent);
    border-radius: 4px; padding: 2px 6px;
  }
  #shopify-section-{{ section.id }} .cnp-rte pre code { background: transparent; padding: 0; }
  #shopify-section-{{ section.id }} .cnp-rte hr { border: 0; border-top: 1px solid var(--rule); margin: 32px 0; }
  #shopify-section-{{ section.id }} .cnp-rte table {
    width: 100%; border-collapse: collapse; margin: 0 0 22px;
    font-size: 15px; border: 2px solid var(--navy);
  }
  #shopify-section-{{ section.id }} .cnp-rte th,
  #shopify-section-{{ section.id }} .cnp-rte td {
    border: 1px solid var(--rule); padding: 10px 14px; text-align: left; vertical-align: top;
  }
  #shopify-section-{{ section.id }} .cnp-rte tr:first-child th,
  #shopify-section-{{ section.id }} .cnp-rte tr:first-child td {
    background: var(--navy); color: var(--paper);
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .cnp-rte tr:nth-child(even) td { background: var(--paper2); }
  #shopify-section-{{ section.id }} .cnp-rte figcaption { color: var(--dim); font-size: 13px; text-align: center; }
{%- endstyle -%}

<div class="cnp">
  {%- if section.settings.show_ticker and section.settings.ticker_text != blank -%}
    <div class="cnp-ticker">
      {%- assign ticker = section.settings.ticker_text | strip -%}
      {{ ticker }} <b>★</b> {{ ticker }}
    </div>
  {%- endif -%}

  <header class="cnp-head cnp-wrap">
    {%- if section.settings.kicker != blank -%}
      <p class="cnp-kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}
    <h1>{{ page.title | default: section.settings.fallback_title }}</h1>
  </header>

  <div class="cnp-rte cnp-wrap">
    {% if page.content != blank %}
      {{ page.content }}
    {% elsif section.settings.fallback_content != blank %}
      {{ section.settings.fallback_content }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Catalog page",
  "tag": "section",
  "class": "section-catalog-page",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "checkbox", "id": "show_ticker", "label": "Show ticker", "default": true },
    { "type": "textarea", "id": "ticker_text", "label": "Ticker text (repeated with ★)", "default": "New games for old machines · Handmade in Poland · Small batches · Tested on real hardware" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Cyfrowy Nomada" },
    { "type": "text", "id": "fallback_title", "label": "Title (if page has none)", "default": "Page" },
    { "type": "richtext", "id": "fallback_content", "label": "Content (if page has none)" },
    { "type": "color", "id": "color_bg", "label": "Paper background", "default": "#F6F1E3" },
    { "type": "color", "id": "color_ink", "label": "Text (navy)", "default": "#1F2A44" },
    { "type": "color", "id": "color_accent", "label": "Print red", "default": "#D6453D" },
    { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#5D6478" },
    { "type": "color", "id": "color_card", "label": "Cards", "default": "#FDFAF1" },
    { "type": "color", "id": "color_line", "label": "Hairlines", "default": "#C9BFA6" }
  ]
}
{% endschema %}
