{% comment %}
  Game page content — per-game copy taken from product metafields, so each
  game fills in its own text in the admin without touching the theme.

  Metafields (rich text, defined on Products):
    custom.game_description — About the game
    custom.game_manual      — Micro manual
    custom.game_history     — History & references

  Each part renders only when its metafield has content; products without
  any of them show nothing at all.
{% endcomment %}

{%- liquid
  assign game_product = closest.product | default: product
  assign game_description = game_product.metafields.custom.game_description
  assign game_manual = game_product.metafields.custom.game_manual
  assign game_history = game_product.metafields.custom.game_history
-%}

{%- if game_description != blank or game_manual != blank or game_history != blank -%}
  {%- if section.settings.background_color != blank -%}
    {%- render 'contrast-override', background_color: section.settings.background_color, section_id: section.id -%}
  {%- endif -%}

  {% style %}
    #shopify-section-{{ section.id }} .game-content__part {
      max-width: 46rem;
    }
    #shopify-section-{{ section.id }} .game-content__part > .h2 {
      margin: 0;
    }
  {% endstyle %}

  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      spacing-style
      gap-style
    "
    style="
      {%- render 'spacing-style', settings: section.settings -%}
      {%- render 'gap-style', value: section.settings.gap -%}
    "
  >
    {%- if game_description != blank -%}
      <div class="game-content__part">
        <h2 class="h2">{{ section.settings.description_heading }}</h2>
        <div class="rte">{{ game_description | metafield_tag }}</div>
      </div>
    {%- endif -%}

    {%- if game_manual != blank -%}
      <div class="game-content__part">
        <h2 class="h2">{{ section.settings.manual_heading }}</h2>
        <div class="rte">{{ game_manual | metafield_tag }}</div>
      </div>
    {%- endif -%}

    {%- if game_history != blank -%}
      <div class="game-content__part">
        <h2 class="h2">{{ section.settings.history_heading }}</h2>
        <div class="rte">{{ game_history | metafield_tag }}</div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Game page content",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "description_heading",
      "label": "Description heading",
      "default": "About the game"
    },
    {
      "type": "text",
      "id": "manual_heading",
      "label": "Manual heading",
      "default": "Micro manual"
    },
    {
      "type": "text",
      "id": "history_heading",
      "label": "History heading",
      "default": "History & references"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between sections",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "paragraph",
      "content": "Content comes from the product metafields custom.game_description, custom.game_manual and custom.game_history."
    }
  ],
  "presets": [
    {
      "name": "Game page content"
    }
  ]
}
{% endschema %}
