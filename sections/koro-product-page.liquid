{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'koro-product-form-' | append: section.id
  assign demo_url = product.metafields.custom.iframe_game_url.value | default: product.metafields.custom.iframe_game_url

    assign hero_image_url = section.settings.hero_image | image_url: width: 2400
    assign box_art_image_url = section.settings.box_art_image | image_url: width: 2200
    assign cartridge_image_url = section.settings.cartridge_image | image_url: width: 1000
    assign gallery_wide_image_url = section.settings.gallery_wide_image | image_url: width: 2400
    assign gallery_left_image_url = section.settings.gallery_left_image | image_url: width: 2200
    assign gallery_right_image_url = section.settings.gallery_right_image | image_url: width: 1400

%}

<div id="KoroPage-{{ section.id }}" class="koro-page">
  <nav class="koro-nav" aria-label="Koro page navigation">
    <a class="koro-nav__brand" href="#koro-top-{{ section.id }}" aria-label="Koro home">
      <span class="koro-wordmark" aria-label="Koro">
        <span class="koro-wordmark__k">K</span><span class="koro-wordmark__o1">O</span><span class="koro-wordmark__r">R</span><span class="koro-wordmark__o2">O</span>
      </span>
    </a>
    <div class="koro-nav__links">
      <a href="#koro-story-{{ section.id }}">About</a>
      <a href="#koro-play-{{ section.id }}">Play</a>
      <a href="#koro-buy-{{ section.id }}">Get Koro</a>
    </div>
    <a class="koro-nav__cart" href="{{ routes.cart_url }}">Cart <span aria-hidden="true">↗</span></a>
  </nav>

  <main>
    <section id="koro-top-{{ section.id }}" class="koro-hero">
      <div class="koro-orbit koro-orbit--one" aria-hidden="true"></div>
      <div class="koro-orbit koro-orbit--two" aria-hidden="true"></div>
      <div class="koro-marble koro-marble--pink koro-marble--a" aria-hidden="true"></div>
      <div class="koro-marble koro-marble--blue koro-marble--b" aria-hidden="true"></div>
      <div class="koro-marble koro-marble--orange koro-marble--c" aria-hidden="true"></div>

      <div class="koro-hero__copy">
        <p class="koro-kicker">{{ section.settings.eyebrow | escape }}</p>
        <h1>
          <span>{{ section.settings.hero_title | escape }}</span>
          <strong>{{ product.title | escape }}</strong>
        </h1>
        <p class="koro-hero__intro">{{ section.settings.hero_text | escape }}</p>

        <div class="koro-hero__actions">
          <a class="koro-button koro-button--primary" href="#koro-buy-{{ section.id }}">
            Get the game <span aria-hidden="true">→</span>
          </a>
          <a class="koro-button koro-button--ghost" href="#koro-play-{{ section.id }}">
            Play the demo
          </a>
        </div>

        <ul class="koro-badges" aria-label="Product highlights">
          <li>Game Boy Color</li>
          <li>Physical edition</li>
          <li>Made in Poland</li>
        </ul>
      </div>

      <div class="koro-hero__visual">
        <div class="koro-hero__halo" aria-hidden="true"></div>
        <img
          class="koro-hero__image"
          src="{{ hero_image_url }}"
          alt="Koro Game Boy Color box, cartridge and console presentation"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
        >
        <div class="koro-sticker koro-sticker--top">Cute logic puzzle!</div>
        <div class="koro-sticker koro-sticker--bottom">Clear 24 lines</div>
      </div>

      <a class="koro-scroll" href="#koro-story-{{ section.id }}">
        Scroll to explore <span aria-hidden="true">↓</span>
      </a>
    </section>

    <section id="koro-story-{{ section.id }}" class="koro-story">
      <div class="koro-story__header">
        <p class="koro-kicker">A tiny story, a big challenge</p>
        <h2>{{ section.settings.story_title | escape }}</h2>
        <p>{{ section.settings.story_text | escape }}</p>
      </div>

      <div class="koro-feature-grid">
        <article class="koro-feature-card koro-feature-card--green">
          <span class="koro-feature-card__number">01</span>
          <div class="koro-feature-card__icon" aria-hidden="true">●●●●●</div>
          <h3>Match five</h3>
          <p>Find a line of five or more matching marbles and pick them up.</p>
        </article>
        <article class="koro-feature-card koro-feature-card--pink">
          <span class="koro-feature-card__number">02</span>
          <div class="koro-feature-card__icon" aria-hidden="true">↔</div>
          <h3>Plan each move</h3>
          <p>Every marble changes the board. Build the next line before space runs out.</p>
        </article>
        <article class="koro-feature-card koro-feature-card--blue">
          <span class="koro-feature-card__number">03</span>
          <div class="koro-feature-card__icon" aria-hidden="true">★</div>
          <h3>Master the garden</h3>
          <p>Clear 24 lines to earn the title of Koro Master.</p>
        </article>
      </div>

      <div class="koro-story__art">
        <div class="koro-story__art-copy">
          <span>Designed for real hardware</span>
          <h3>Simple to learn.<br>Hard to stop.</h3>
          <p>A cheerful, quick-session puzzle game made for the Game Boy Color.</p>
        </div>
        <img
          src="{{ box_art_image_url }}"
          alt="Flat print layout of the Koro game box"
          width="2048"
          height="1312"
          loading="lazy"
        >
      </div>
    </section>

    <section id="koro-play-{{ section.id }}" class="koro-play">
      <div class="koro-play__heading">
        <p class="koro-kicker">Try before you buy</p>
        <h2>Play Koro right here.</h2>
        <p>{{ section.settings.demo_text | escape }}</p>
      </div>

      <div class="koro-console-shell">
        <div class="koro-console-shell__top">
          <span>CYFROWY NOMADA</span>
          <span>COLOR</span>
        </div>
        <div class="koro-screen-wrap">
          {% if demo_url != blank and section.settings.show_demo %}
            <iframe
              class="koro-demo"
              src="{{ demo_url | escape }}"
              title="Play the Koro Game Boy Color demo"
              loading="lazy"
              allow="autoplay; fullscreen; gamepad"
              allowfullscreen
            ></iframe>
          {% else %}
            <div class="koro-demo-placeholder">
              <span class="koro-demo-placeholder__marble" aria-hidden="true"></span>
              <strong>Demo ready when you are.</strong>
              <p>Add a URL to the product metafield <code>custom.iframe_game_url</code>.</p>
            </div>
          {% endif %}
        </div>
        <div class="koro-console-shell__controls" aria-hidden="true">
          <div class="koro-dpad"><i></i><i></i></div>
          <div class="koro-speaker"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="koro-ab"><i>A</i><i>B</i></div>
        </div>
      </div>

      <p class="koro-controls">Keyboard: <kbd>X</kbd> A &nbsp; <kbd>Z</kbd> B &nbsp; <kbd>Enter</kbd> Start &nbsp; <kbd>Tab</kbd> Select</p>
    </section>

    <section id="koro-buy-{{ section.id }}" class="koro-buy">
      <div class="koro-buy__media">
        <div class="koro-buy__burst" aria-hidden="true"></div>
        <img
          class="koro-buy__cartridge"
          src="{{ cartridge_image_url }}"
          alt="Koro Game Boy Color cartridge"
          width="496"
          height="437"
          loading="lazy"
        >
        <span class="koro-buy__caption">A real cartridge for your collection</span>
      </div>

      <div class="koro-buy__details">
        <p class="koro-kicker">Bring Koro home</p>
        <h2>{{ product.title | escape }}</h2>
        <div class="koro-price" data-koro-price>
          <span>{{ selected_variant.price | money }}</span>
          {% if selected_variant.compare_at_price > selected_variant.price %}
            <s>{{ selected_variant.compare_at_price | money }}</s>
          {% endif %}
        </div>

        {% if product.description != blank %}
          <div class="koro-description rte">{{ product.description }}</div>
        {% else %}
          <p class="koro-description">{{ section.settings.fallback_description | escape }}</p>
        {% endif %}

        {% form 'product', product, id: product_form_id, class: 'koro-buy-form' %}
          {% if product.variants.size > 1 %}
            <label class="koro-field" for="KoroVariant-{{ section.id }}">
              <span>Edition</span>
              <select id="KoroVariant-{{ section.id }}" name="id" data-koro-variant>
                {% for variant in product.variants %}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price | money | escape }}"
                    data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | escape }}{% endif %}"
                    data-available="{{ variant.available }}"
                    {% if variant == selected_variant %}selected{% endif %}
                  >
                    {{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </label>
          {% else %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
          {% endif %}

          <div class="koro-buy-form__row">
            <label class="koro-field koro-field--quantity" for="KoroQuantity-{{ section.id }}">
              <span>Qty.</span>
              <input id="KoroQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
            </label>

            <button
              class="koro-add-button"
              type="submit"
              name="add"
              data-koro-add
              {% unless selected_variant.available %}disabled{% endunless %}
            >
              <span data-koro-add-label>{% if selected_variant.available %}Add to cart{% else %}Sold out{% endif %}</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>

          {{ form | payment_terms }}
        {% endform %}

        <ul class="koro-product-notes">
          <li><strong>Region free</strong><span>Works on Game Boy Color hardware</span></li>
          <li><strong>Small-batch release</strong><span>Made and packed by Cyfrowy Nomada</span></li>
          <li><strong>Collector-ready</strong><span>Box, cartridge and printed materials</span></li>
        </ul>
      </div>
    </section>

    <section class="koro-gallery">
      <div class="koro-gallery__lead">
        <p class="koro-kicker">Made to feel special</p>
        <h2>From screen to shelf.</h2>
      </div>
<figure class="koro-gallery__wide">
  <img
    src="{{ gallery_wide_image_url }}"
    alt="{{ section.settings.gallery_wide_alt | default: 'Koro physical edition product visualization' | escape }}"
    width="1920"
    height="1080"
    loading="lazy"
  >

  {% if section.settings.gallery_wide_note != blank %}
    <figcaption>
      {{ section.settings.gallery_wide_note | escape }}
    </figcaption>
  {% endif %}
</figure>

  <div class="koro-gallery__pair">
    <figure>
      <img
        src="{{ gallery_left_image_url }}"
        alt="{{ section.settings.gallery_left_alt | default: 'Koro box artwork and print layout' | escape }}"
        width="2048"
        height="1312"
        loading="lazy"
      >

      {% if section.settings.gallery_left_note != blank %}
        <figcaption>
          {{ section.settings.gallery_left_note | escape }}
        </figcaption>
      {% endif %}
    </figure>

    <figure class="koro-gallery__cartridge-card">
      <img
        src="{{ gallery_right_image_url }}"
        alt="{{ section.settings.gallery_right_alt | default: 'Koro cartridge label artwork' | escape }}"
        width="1200"
        height="1200"
        loading="lazy"
      >

      {% if section.settings.gallery_right_note != blank %}
        <figcaption>
          {{ section.settings.gallery_right_note | escape }}
        </figcaption>
      {% endif %}
    </figure>
  </div>
    </section>
  </main>

  <footer class="koro-footer">
    <a class="koro-wordmark koro-wordmark--footer" href="#koro-top-{{ section.id }}" aria-label="Back to top">
      <span class="koro-wordmark__k">K</span><span class="koro-wordmark__o1">O</span><span class="koro-wordmark__r">R</span><span class="koro-wordmark__o2">O</span>
    </a>
    <p>Made in Poland by Cyfrowy Nomada · © {{ 'now' | date: '%Y' }}</p>
    <a href="{{ routes.root_url }}">Visit the shop <span aria-hidden="true">↗</span></a>
  </footer>
</div>

{% style %}
  .template-product-koro-dedicated-page {
    --koro-yellow: #ffcc50;
    --koro-cream: #fff7d7;
    --koro-pink: #e92d5c;
    --koro-blue: #31c6e9;
    --koro-green: #52b65b;
    --koro-orange: #f58a1f;
    --koro-purple: #a783ed;
    --koro-ink: #3f3d42;
    --koro-plum: #33233f;
    background: var(--koro-cream);
  }

  .template-product-koro-dedicated-page #header-group,
  .template-product-koro-dedicated-page .page-wrapper > footer,
  .template-product-koro-dedicated-page chat-drawer {
    display: none !important;
  }

  .template-product-koro-dedicated-page .page-wrapper,
  .template-product-koro-dedicated-page #MainContent,
  .template-product-koro-dedicated-page .shopify-section {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .template-product-koro-dedicated-page #MainContent {
    overflow: clip;
  }

  #KoroPage-{{ section.id }} {
    color: var(--koro-ink);
    background: var(--koro-cream);
    font-family: "Arial Rounded MT Bold", "Trebuchet MS", ui-rounded, system-ui, sans-serif;
    line-height: 1.45;
    overflow: clip;
  }

  #KoroPage-{{ section.id }} *,
  #KoroPage-{{ section.id }} *::before,
  #KoroPage-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #KoroPage-{{ section.id }} a {
    color: inherit;
    text-decoration: none;
  }

  #KoroPage-{{ section.id }} img {
    display: block;
    max-width: 100%;
  }

  #KoroPage-{{ section.id }} h1,
  #KoroPage-{{ section.id }} h2,
  #KoroPage-{{ section.id }} h3,
  #KoroPage-{{ section.id }} p {
    margin-top: 0;
  }

  .koro-nav {
    position: fixed;
    z-index: 50;
    top: 18px;
    left: 50%;
    width: min(1120px, calc(100% - 32px));
    min-height: 66px;
    padding: 9px 12px 9px 18px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border: 2px solid rgba(63, 61, 66, .12);
    border-radius: 999px;
    background: rgba(255, 247, 215, .88);
    box-shadow: 0 12px 30px rgba(92, 57, 18, .12);
    backdrop-filter: blur(18px);
    transform: translateX(-50%);
  }

  .koro-nav__brand {
    justify-self: start;
  }

  .koro-nav__links {
    display: flex;
    gap: clamp(16px, 3vw, 34px);
    font-size: 14px;
    font-weight: 800;
  }

  .koro-nav__links a,
  .koro-nav__cart {
    transition: transform .2s ease, color .2s ease;
  }

  .koro-nav__links a:hover,
  .koro-nav__cart:hover {
    color: var(--koro-pink);
    transform: translateY(-2px);
  }

  .koro-nav__cart {
    justify-self: end;
    padding: 11px 17px;
    border-radius: 999px;
    background: var(--koro-ink);
    color: white !important;
    font-size: 13px;
    font-weight: 900;
  }

  .koro-wordmark {
    display: inline-flex;
    align-items: center;
    font-size: 25px;
    font-weight: 1000;
    letter-spacing: -4px;
    line-height: 1;
    filter: drop-shadow(0 3px 0 rgba(255,255,255,.85));
  }

  .koro-wordmark span {
    display: inline-block;
    -webkit-text-stroke: 1px rgba(255, 255, 255, .75);
  }

  .koro-wordmark__k { color: var(--koro-green); transform: rotate(-6deg); }
  .koro-wordmark__o1 { color: var(--koro-yellow); transform: translateY(1px) rotate(5deg); }
  .koro-wordmark__r { color: var(--koro-pink); transform: rotate(-3deg); }
  .koro-wordmark__o2 { color: var(--koro-blue); transform: translateY(1px) rotate(4deg); }

  .koro-hero {
    position: relative;
    min-height: 100svh;
    padding: 132px max(28px, calc((100vw - 1220px) / 2)) 72px;
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(440px, 1.25fr);
    align-items: center;
    gap: clamp(30px, 5vw, 82px);
    isolation: isolate;
    overflow: hidden;
    overflow: clip;

    background:
      radial-gradient(circle at 15% 18%, rgba(255,255,255,.68) 0 4px, transparent 5px),
      radial-gradient(circle at 88% 18%, rgba(255,255,255,.5) 0 6px, transparent 7px),
      linear-gradient(145deg, #ffd765 0%, var(--koro-yellow) 55%, #ffbd43 100%);
  }

  .koro-hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    right: -8vw;
    bottom: -22vw;
    width: 64vw;
    height: 64vw;
    min-width: 720px;
    min-height: 720px;
    border-radius: 46% 54% 58% 42% / 45% 46% 54% 55%;
    background: rgba(255, 247, 215, .82);
    transform: rotate(-8deg);
  }

  .koro-hero__copy {
    position: relative;
    z-index: 4;
    max-width: 620px;
  }

  .koro-kicker {
    margin-bottom: 18px;
    color: var(--koro-pink);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .koro-hero h1 {
    margin-bottom: 24px;
    color: var(--koro-ink);
    font-size: clamp(50px, 7.2vw, 112px);
    font-weight: 1000;
    letter-spacing: -.07em;
    line-height: .86;
  }

  .koro-hero h1 span,
  .koro-hero h1 strong {
    display: block;
  }

  .koro-hero h1 strong {
    color: var(--koro-pink);
    font-size: .96em;
    font-weight: inherit;
    text-shadow: 5px 5px 0 rgba(255,255,255,.72);
  }

  .koro-hero__intro {
    max-width: 560px;
    margin-bottom: 30px;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
    line-height: 1.4;
  }

  .koro-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 30px;
  }

  .koro-button {
    min-height: 58px;
    padding: 16px 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    border: 2px solid var(--koro-ink);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 900;
    box-shadow: 0 6px 0 rgba(63, 61, 66, .22);
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .koro-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 9px 0 rgba(63, 61, 66, .2);
  }

  .koro-button--primary {
    background: var(--koro-pink);
    color: white !important;
  }

  .koro-button--ghost {
    background: rgba(255,255,255,.4);
  }

  .koro-badges {
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .koro-badges li {
    padding: 8px 12px;
    border: 1.5px solid rgba(63,61,66,.16);
    border-radius: 999px;
    background: rgba(255,247,215,.62);
    font-size: 12px;
    font-weight: 800;
  }

  .koro-hero__visual {
  position: relative;
  z-index: 3;
  width: min(650px, 46vw);
  aspect-ratio: 1 / 1;
  display: grid;
  place-items: center;
  perspective: 1200px;
}

.koro-hero__halo {
  position: absolute;
  inset: 0;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  background: var(--koro-blue);

  /* Remove the white ring/border */
  box-shadow: none;
  transform: none;
}

.koro-hero__image {
  position: relative;
  z-index: 2;
  width: 92%;
  height: 92%;
  max-width: none !important;
  margin: 0;
  aspect-ratio: 1 / 1;
  object-fit: contain;

  /* Transparent product image without a card */
  border: 0;
  border-radius: 0;
  box-shadow: none;

  /* Similar floating presentation to the cartridge */
  filter: drop-shadow(0 35px 36px rgba(72, 47, 16, .3));
  transform: rotate(2.5deg) translateZ(0);
  animation: koro-float 6s ease-in-out infinite;
}

  .koro-sticker {
    position: absolute;
    z-index: 4;
    padding: 12px 18px;
    border: 3px solid var(--koro-ink);
    border-radius: 999px;
    background: var(--koro-cream);
    font-size: clamp(12px, 1.3vw, 17px);
    font-weight: 1000;
    box-shadow: 5px 7px 0 rgba(63,61,66,.22);
  }

  .koro-sticker--top {
    top: -18px;
    right: 5%;
    transform: rotate(7deg);
  }

  .koro-sticker--bottom {
    left: 1%;
    bottom: -18px;
    background: var(--koro-green);
    color: white;
    transform: rotate(-6deg);
  }

  .koro-scroll {
    position: absolute;
    left: 50%;
    bottom: 22px;
    z-index: 5;
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .koro-orbit {
    position: absolute;
    z-index: 0;
    border: 3px dashed rgba(255,255,255,.5);
    border-radius: 50%;
    pointer-events: none;
  }

  .koro-orbit--one { width: 370px; height: 370px; left: -180px; top: 12%; }
  .koro-orbit--two { width: 260px; height: 260px; right: -100px; bottom: 8%; }

  .koro-marble {
    position: absolute;
    z-index: 2;
    width: 52px;
    height: 52px;
    border: 4px solid rgba(255,255,255,.82);
    border-radius: 50%;
    box-shadow: inset -8px -9px 0 rgba(63,61,66,.12), 0 12px 22px rgba(86,58,22,.16);
    animation: koro-bob 5s ease-in-out infinite;
  }

  .koro-marble::before {
    content: "";
    position: absolute;
    top: 8px;
    left: 11px;
    width: 13px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255,255,255,.9);
    transform: rotate(-25deg);
  }

  .koro-marble--pink { background: var(--koro-pink); }
  .koro-marble--blue { background: var(--koro-blue); }
  .koro-marble--orange { background: var(--koro-orange); }
  .koro-marble--a { left: 44%; top: 16%; animation-delay: -.8s; }
  .koro-marble--b { right: 4%; top: 26%; width: 36px; height: 36px; animation-delay: -2.2s; }
  .koro-marble--c { left: 49%; bottom: 10%; width: 30px; height: 30px; animation-delay: -3.4s; }

  .koro-story {
    padding: clamp(84px, 10vw, 150px) max(28px, calc((100vw - 1180px) / 2));
    background: var(--koro-cream);
  }

  .koro-story__header {
    max-width: 860px;
    margin: 0 auto 64px;
    text-align: center;
  }

  .koro-story__header h2,
  .koro-play__heading h2,
  .koro-gallery__lead h2 {
    margin-bottom: 22px;
    font-size: clamp(42px, 6vw, 86px);
    font-weight: 1000;
    letter-spacing: -.06em;
    line-height: .95;
  }

  .koro-story__header > p:last-child,
  .koro-play__heading > p:last-child {
    max-width: 700px;
    margin: 0 auto;
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 700;
  }

  .koro-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .koro-feature-card {
    position: relative;
    min-height: 360px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    border: 3px solid var(--koro-ink);
    border-radius: 38px;
    box-shadow: 9px 11px 0 var(--koro-ink);
    overflow: hidden;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .koro-feature-card:hover {
    transform: translateY(-7px) rotate(-1deg);
    box-shadow: 13px 17px 0 var(--koro-ink);
  }

  .koro-feature-card--green { background: #b9e98b; }
  .koro-feature-card--pink { background: #ff94ac; }
  .koro-feature-card--blue { background: #8be1f2; }

  .koro-feature-card__number {
    font-family: ui-monospace, monospace;
    font-size: 13px;
    font-weight: 900;
  }

  .koro-feature-card__icon {
    min-height: 135px;
    display: grid;
    place-items: center;
    font-size: clamp(44px, 5vw, 74px);
    font-weight: 1000;
    letter-spacing: -.18em;
    color: rgba(255,255,255,.9);
    text-shadow: 4px 4px 0 rgba(63,61,66,.18);
  }

  .koro-feature-card h3 {
    margin-bottom: 12px;
    font-size: 28px;
    font-weight: 1000;
    letter-spacing: -.035em;
  }

  .koro-feature-card p {
    margin-bottom: 0;
    font-family: system-ui, sans-serif;
    font-size: 16px;
    font-weight: 650;
  }

  .koro-story__art {
    min-height: 620px;
    margin-top: 84px;
    padding: clamp(28px, 5vw, 72px);
    display: grid;
    grid-template-columns: .7fr 1.3fr;
    align-items: center;
    gap: 42px;
    border-radius: 56px;
    background: var(--koro-purple);
    color: white;
    overflow: hidden;
  }

  .koro-story__art-copy {
    position: relative;
    z-index: 2;
  }

  .koro-story__art-copy > span {
    display: inline-block;
    margin-bottom: 18px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,.18);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .koro-story__art h3 {
    margin-bottom: 22px;
    font-size: clamp(38px, 5vw, 70px);
    font-weight: 1000;
    letter-spacing: -.06em;
    line-height: .95;
  }

  .koro-story__art p {
    font-family: system-ui, sans-serif;
    font-size: 18px;
    font-weight: 650;
  }

  .koro-story__art img {
    width: 130%;
    max-width: none !important;
    margin-right: -25%;
    border: 8px solid rgba(255,255,255,.82);
    border-radius: 26px;
    box-shadow: 0 30px 70px rgba(49,31,62,.35);
    transform: rotate(7deg);
  }

  .koro-play {
    position: relative;
    padding: clamp(90px, 10vw, 150px) max(28px, calc((100vw - 1080px) / 2));
    background:
      radial-gradient(circle at 12% 20%, rgba(255,204,80,.16) 0 8px, transparent 9px),
      radial-gradient(circle at 88% 32%, rgba(49,198,233,.17) 0 11px, transparent 12px),
      var(--koro-plum);
    color: white;
  }

  .koro-play__heading {
    max-width: 820px;
    margin: 0 auto 54px;
    text-align: center;
  }

  .koro-play .koro-kicker { color: var(--koro-yellow); }

  .koro-console-shell {
    max-width: 940px;
    margin: 0 auto;
    padding: clamp(20px, 3vw, 38px);
    border: 4px solid #2d2931;
    border-radius: 42px 42px 86px 42px;
    background: #f0e6c4;
    color: var(--koro-ink);
    box-shadow: 0 34px 0 #18141d, 0 60px 90px rgba(0,0,0,.35);
  }

  .koro-console-shell__top {
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    font-family: ui-monospace, monospace;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .1em;
  }

  .koro-screen-wrap {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
    padding: clamp(10px, 2vw, 20px);
    border: 4px solid #5e5962;
    border-radius: 22px;
    background: #3c3840;
    box-shadow: inset 0 0 0 5px #26222b;
  }

 .koro-demo,
  .koro-demo-placeholder {
    display: block;
    width: 100%;
    height: auto;
    min-height: 0;

    /* Game Boy screen: 160 × 144 */
    aspect-ratio: 160 / 144;

    border: 0;
    border-radius: 10px;
    background: #fff7d7;
  }

  .koro-demo-placeholder {
    padding: 30px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 14px;
    text-align: center;
  }

  .koro-demo-placeholder strong { font-size: clamp(24px, 4vw, 44px); }
  .koro-demo-placeholder p { margin: 0; font-family: system-ui, sans-serif; }
  .koro-demo-placeholder code { padding: 3px 6px; border-radius: 5px; background: rgba(63,61,66,.08); }

  .koro-demo-placeholder__marble {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: var(--koro-pink);
    box-shadow: inset -12px -13px 0 rgba(63,61,66,.12);
  }

  .koro-console-shell__controls {
    padding: 28px 18px 4px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .koro-dpad {
    position: relative;
    width: 84px;
    height: 84px;
  }

  .koro-dpad i {
    position: absolute;
    inset: 30px 0;
    border-radius: 6px;
    background: #343038;
  }

  .koro-dpad i:last-child { transform: rotate(90deg); }

  .koro-speaker { display: flex; gap: 7px; transform: rotate(-12deg); }
  .koro-speaker i { width: 6px; height: 35px; border-radius: 999px; background: #9d9290; }

  .koro-ab {
    justify-self: end;
    display: flex;
    gap: 12px;
    transform: rotate(-18deg);
  }

  .koro-ab i {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--koro-pink);
    color: white;
    font-style: normal;
    font-weight: 1000;
    box-shadow: inset -6px -7px 0 rgba(63,61,66,.18);
  }

  .koro-controls {
    margin: 62px auto 0;
    text-align: center;
    font-family: ui-monospace, monospace;
    font-size: 13px;
    color: rgba(255,255,255,.72);
  }

  .koro-controls kbd {
    padding: 5px 8px;
    border: 1px solid rgba(255,255,255,.28);
    border-radius: 7px;
    background: rgba(255,255,255,.08);
    color: white;
    font-family: inherit;
  }

  .koro-buy {
    min-height: 100svh;
    padding: clamp(100px, 11vw, 160px) max(28px, calc((100vw - 1180px) / 2));
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(50px, 8vw, 110px);
    background: var(--koro-pink);
    color: white;
  }

  .koro-buy__media {
    position: relative;
    min-height: 640px;
    display: grid;
    place-items: center;
  }

  .koro-buy__burst {
    position: absolute;
    width: min(560px, 90%);
    aspect-ratio: 1;
    border-radius: 45% 55% 48% 52% / 58% 43% 57% 42%;
    background: var(--koro-yellow);
    box-shadow: 0 0 0 24px rgba(255,247,215,.18);
    transform: rotate(-9deg);
  }

  .koro-buy__cartridge {
    position: relative;
    z-index: 2;
    width: min(490px, 78%);
    filter: drop-shadow(0 35px 36px rgba(66,13,31,.36));
    transform: rotate(-7deg);
    animation: koro-float 6.5s ease-in-out infinite reverse;
  }

  .koro-buy__caption {
    position: absolute;
    z-index: 3;
    right: 2%;
    bottom: 9%;
    max-width: 190px;
    padding: 14px 18px;
    border: 3px solid var(--koro-ink);
    border-radius: 18px;
    background: var(--koro-cream);
    color: var(--koro-ink);
    font-size: 14px;
    font-weight: 900;
    box-shadow: 7px 8px 0 var(--koro-ink);
    transform: rotate(5deg);
  }

  .koro-buy__details {
    max-width: 560px;
  }

  .koro-buy .koro-kicker { color: var(--koro-yellow); }

  .koro-buy h2 {
    margin-bottom: 10px;
    font-size: clamp(56px, 8vw, 110px);
    font-weight: 1000;
    letter-spacing: -.07em;
    line-height: .9;
  }

  .koro-price {
    margin-bottom: 24px;
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 1000;
  }

  .koro-price s {
    opacity: .55;
    font-size: .58em;
  }

  .koro-description {
    margin-bottom: 28px;
    font-family: system-ui, sans-serif;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.65;
  }

  .koro-description > *:last-child { margin-bottom: 0; }

  .koro-buy-form {
    padding: 24px;
    border: 3px solid var(--koro-ink);
    border-radius: 28px;
    background: var(--koro-cream);
    color: var(--koro-ink);
    box-shadow: 10px 12px 0 var(--koro-ink);
  }

  .koro-field {
    display: grid;
    gap: 8px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .koro-field select,
  .koro-field input {
    width: 100%;
    min-height: 54px;
    padding: 0 16px;
    border: 2px solid var(--koro-ink);
    border-radius: 14px;
    background: white;
    color: var(--koro-ink);
    font: 800 15px/1 system-ui, sans-serif;
  }

  .koro-buy-form__row {
    margin-top: 16px;
    display: grid;
    grid-template-columns: 92px 1fr;
    gap: 12px;
  }

  .koro-add-button {
    min-height: 76px;
    padding: 0 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border: 2px solid var(--koro-ink);
    border-radius: 18px;
    background: var(--koro-yellow);
    color: var(--koro-ink);
    font: 1000 18px/1 system-ui, sans-serif;
    cursor: pointer;
    box-shadow: 0 5px 0 rgba(63,61,66,.22);
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .koro-add-button:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 8px 0 rgba(63,61,66,.22);
  }

  .koro-add-button:disabled {
    cursor: not-allowed;
    opacity: .55;
  }

  .koro-product-notes {
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  .koro-product-notes li {
    padding: 15px 0;
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 18px;
    border-bottom: 1px solid rgba(255,255,255,.28);
    font-family: system-ui, sans-serif;
    font-size: 14px;
  }

  .koro-product-notes strong { font-family: "Arial Rounded MT Bold", "Trebuchet MS", sans-serif; }
  .koro-product-notes span { opacity: .78; }

  .koro-gallery {
    padding: clamp(90px, 10vw, 150px) max(28px, calc((100vw - 1220px) / 2));
    background: var(--koro-yellow);
  }

  .koro-gallery__lead {
    max-width: 760px;
    margin-bottom: 50px;
  }

  .koro-gallery__wide,
  .koro-gallery__pair figure {
    margin: 0;
    overflow: hidden;
    border: 5px solid var(--koro-ink);
    box-shadow: 12px 14px 0 var(--koro-ink);
  }

  .koro-gallery__wide {
    border-radius: 46px;
  }

  .koro-gallery__wide img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .koro-gallery__pair {
    margin-top: 32px;
    display: grid;
    grid-template-columns: 1.35fr .65fr;
    gap: 32px;
  }

  .koro-gallery__pair figure {
    min-height: 480px;
    display: flex;
    flex-direction: column;
    border-radius: 34px;
    background: var(--koro-cream);
  }

  .koro-gallery__pair img {
    width: 100%;
    flex: 1;
    object-fit: cover;
  }

  .koro-gallery__cartridge-card img {
    padding: 46px;
    object-fit: contain;
    background: var(--koro-blue);
  }

  .koro-gallery figcaption {
    padding: 22px 24px;
    background: var(--koro-cream);
    font-size: 16px;
    font-weight: 900;
  }

  .koro-footer {
    padding: 44px max(28px, calc((100vw - 1180px) / 2));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 28px;
    background: var(--koro-ink);
    color: white;
    font-size: 13px;
    font-weight: 800;
  }

  .koro-footer p { margin: 0; opacity: .68; text-align: center; }
  .koro-footer > a:last-child { justify-self: end; }
  .koro-wordmark--footer { font-size: 34px; filter: none; }

  @keyframes koro-float {
    0%, 100% { transform: rotate(2.5deg) translateY(0); }
    50% { transform: rotate(1deg) translateY(-15px); }
  }

  @keyframes koro-bob {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-18px) rotate(12deg); }
  }

  @media (max-width: 960px) {
    .koro-nav {
      grid-template-columns: 1fr auto;
    }

    .koro-nav__links { display: none; }

    .koro-hero {
      min-height: auto;
      padding-top: 122px;
      grid-template-columns: 1fr;
      text-align: center;
    }

    .koro-hero__copy { margin: 0 auto; }
    .koro-hero__intro { margin-left: auto; margin-right: auto; }
    .koro-hero__actions, .koro-badges { justify-content: center; }
    .koro-hero__visual { width: min(820px, 100%); margin: 20px auto 40px; }
    .koro-scroll { display: none; }
    .koro-marble--a { left: 7%; top: 47%; }

    .koro-feature-grid { grid-template-columns: 1fr; }
    .koro-feature-card { min-height: 300px; }

    .koro-story__art {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .koro-story__art img {
      width: 116%;
      margin: 0 -8% -10%;
      transform: rotate(3deg);
    }

    .koro-buy {
      grid-template-columns: 1fr;
    }

    .koro-buy__media { min-height: 520px; }
    .koro-buy__details { max-width: 680px; margin: 0 auto; }
    .koro-gallery__pair { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .koro-nav { top: 10px; width: calc(100% - 20px); min-height: 58px; padding-left: 14px; }
    .koro-wordmark { font-size: 22px; }
    .koro-nav__cart { padding: 9px 13px; }

    .koro-hero {
      padding-left: 20px;
      padding-right: 20px;
      padding-bottom: 54px;
    }

    .koro-hero h1 { font-size: clamp(48px, 16vw, 74px); }
    .koro-hero__image { width: 112%; margin-left: -6%; border-width: 4px; }
    .koro-sticker { padding: 9px 12px; border-width: 2px; box-shadow: 4px 5px 0 rgba(63,61,66,.22); }
    .koro-sticker--top { top: -10px; }
    .koro-sticker--bottom { bottom: -12px; }

    .koro-story,
    .koro-play,
    .koro-buy,
    .koro-gallery {
      padding-left: 20px;
      padding-right: 20px;
    }

    .koro-story__header h2,
    .koro-play__heading h2,
    .koro-gallery__lead h2 { font-size: 45px; }

    .koro-feature-card { padding: 22px; border-radius: 28px; }
    .koro-story__art { margin-top: 62px; padding: 28px 20px; border-radius: 34px; }

    .koro-console-shell {
      padding: 14px;
      border-radius: 26px 26px 54px 26px;
      box-shadow: 0 20px 0 #18141d, 0 40px 60px rgba(0,0,0,.35);
    }

    .koro-demo,
    .koro-demo-placeholder { min-height: 420px; }
    .koro-console-shell__controls { padding-left: 4px; padding-right: 4px; }
    .koro-speaker { display: none; }
    .koro-console-shell__controls { grid-template-columns: 1fr 1fr; }
    .koro-controls { line-height: 2.3; }

    .koro-buy__media { min-height: 430px; }
    .koro-buy__caption { right: 1%; bottom: 3%; }
    .koro-buy h2 { font-size: 68px; }
    .koro-buy-form { padding: 18px; border-radius: 22px; }
    .koro-buy-form__row { grid-template-columns: 78px 1fr; }
    .koro-add-button { min-height: 72px; padding: 0 16px; font-size: 16px; }
    .koro-product-notes li { grid-template-columns: 1fr; gap: 4px; }

    .koro-gallery__wide,
    .koro-gallery__pair figure { border-width: 3px; box-shadow: 7px 9px 0 var(--koro-ink); }
    .koro-gallery__pair { gap: 22px; }
    .koro-gallery__pair figure { min-height: 390px; }
    .koro-gallery__cartridge-card img { padding: 28px; }

    .koro-footer {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .koro-footer > a,
    .koro-footer > a:last-child { justify-self: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    #KoroPage-{{ section.id }} *,
    #KoroPage-{{ section.id }} *::before,
    #KoroPage-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
{% endstyle %}

<script>
  (() => {
    const root = document.getElementById('KoroPage-{{ section.id }}');
    if (!root) return;

    const variantSelect = root.querySelector('[data-koro-variant]');
    const price = root.querySelector('[data-koro-price]');
    const addButton = root.querySelector('[data-koro-add]');
    const addLabel = root.querySelector('[data-koro-add-label]');

    if (variantSelect) {
      variantSelect.addEventListener('change', () => {
        const option = variantSelect.options[variantSelect.selectedIndex];
        const available = option.dataset.available === 'true';
        const comparePrice = option.dataset.comparePrice;

        if (price) {
          price.innerHTML = `<span>${option.dataset.price || ''}</span>${comparePrice ? `<s>${comparePrice}</s>` : ''}`;
        }

        if (addButton && addLabel) {
          addButton.disabled = !available;
          addLabel.textContent = available ? 'Add to cart' : 'Sold out';
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Koro product page",
  "tag": "section",
  "class": "koro-product-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Hero eyebrow",
      "default": "A cheerful puzzle for Game Boy Color"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero title prefix",
      "default": "Meet"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Hero text",
      "default": "Help a little mouse collect runaway marbles in a bright, quick and endlessly replayable puzzle game."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero product image",
      "info": "Falls back to assets/koro-box-preview.jpg."
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Story title",
      "default": "The marbles escaped into the garden."
    },
    {
      "type": "textarea",
      "id": "story_text",
      "label": "Story text",
      "default": "Koro loves to play marbles. One sunny day they rolled everywhere, and now every clever move brings them closer to home."
    },
    {
      "type": "image_picker",
      "id": "box_art_image",
      "label": "Box artwork image",
      "info": "Falls back to assets/koro-game-box.png."
    },
    {
      "type": "checkbox",
      "id": "show_demo",
      "label": "Show embedded demo",
      "default": true
    },
    {
      "type": "textarea",
      "id": "demo_text",
      "label": "Demo text",
      "default": "The browser demo uses the same compact controls and colorful rules as the cartridge."
    },
    {
      "type": "image_picker",
      "id": "cartridge_image",
      "label": "Cartridge image",
      "info": "Falls back to assets/koro-cartridge.png."
    },
    {
      "type": "header",
      "content": "From screen to shelf"
    },
    {
      "type": "image_picker",
      "id": "gallery_wide_image",
      "label": "Large gallery image"
    },
    {
      "type": "text",
      "id": "gallery_wide_alt",
      "label": "Large image alt text",
      "default": "Koro physical edition product visualization"
    },
    {
      "type": "textarea",
      "id": "gallery_wide_note",
      "label": "Large image footer note",
      "default": "The complete Koro physical edition, ready for your collection."
    },
    {
      "type": "image_picker",
      "id": "gallery_left_image",
      "label": "Left gallery image"
    },
