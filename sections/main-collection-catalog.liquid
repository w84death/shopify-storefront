{% comment %}
  Main collection — "Mail-order catalogue" edition.
  Renders the current collection's title, description and products
  in the catalog design (paper/navy/red, mono kickers, hard shadows).
  Assign via the "catalog" collection template (collection.catalog.json).
{% endcomment %}

{%- style -%}
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  #shopify-section-{{ section.id }} .cnc {
    --paper: {{ section.settings.color_bg }};
    --navy: {{ section.settings.color_ink }};
    --red: {{ section.settings.color_accent }};
    --dim: {{ section.settings.color_muted }};
    --rule: {{ section.settings.color_line }};
    --paper2: {{ section.settings.color_card }};
    --mono: ui-monospace, "Cascadia Mono", "JetBrains Mono", Consolas, monospace;
    --display: "WDXL Lubrifont JP N", "Fredoka", "Nunito", sans-serif;
    background: var(--paper);
    color: var(--navy);
    font-family: "Nunito", "Trebuchet MS", "Avenir Next", "Segoe UI", sans-serif;
    line-height: 1.55;
    padding-bottom: 60px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  #shopify-section-{{ section.id }} .cnc * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .cnc a:not(.cnc-btn) { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .cnc :focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .cnc-wrap { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  #shopify-section-{{ section.id }} .cnc h1,
  #shopify-section-{{ section.id }} .cnc h2,
  #shopify-section-{{ section.id }} .cnc h3 {
    font-family: var(--display); font-weight: 650; letter-spacing: -.02em;
    text-wrap: balance; margin: 0;
  }

  #shopify-section-{{ section.id }} .cnc-kicker {
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--red);
  }
  #shopify-section-{{ section.id }} .cnc-head {
    text-align: center; padding: 52px 0 36px; border-bottom: 3px double var(--navy);
    margin-bottom: 36px;
  }
  #shopify-section-{{ section.id }} .cnc-head h1 { font-size: clamp(38px, 5.4vw, 68px); line-height: .95; margin: 14px 0 12px; }
  #shopify-section-{{ section.id }} .cnc-head .cnc-desc { color: var(--dim); font-size: 16.5px; max-width: 620px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .cnc-head .cnc-desc p { margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .cnc-head .cnc-desc a { color: var(--red); text-decoration: underline; text-underline-offset: 3px; }

  #shopify-section-{{ section.id }} .cnc-count {
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--dim);
    margin-bottom: 22px;
  }
  #shopify-section-{{ section.id }} .cnc-count b { color: var(--red); }

  #shopify-section-{{ section.id }} .cnc-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr)); gap: 22px;
  }
  #shopify-section-{{ section.id }} .cnc-card {
    background: var(--paper2); border: 2px solid var(--navy); border-radius: 8px;
    padding: 16px 16px 20px; display: flex; flex-direction: column; gap: 9px;
    transition: transform .12s ease, box-shadow .12s ease;
  }
  #shopify-section-{{ section.id }} .cnc-card:hover { transform: translate(-2px,-2px); box-shadow: 5px 5px 0 var(--navy); }
  #shopify-section-{{ section.id }} .cnc-card-img {
    width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 6px; display: block; background: var(--paper);
  }
  #shopify-section-{{ section.id }} .cnc-card h3 { font-size: 21px; line-height: 1.05; }
  #shopify-section-{{ section.id }} .cnc-card:hover h3 { color: var(--red); }
  #shopify-section-{{ section.id }} .cnc-price {
    align-self: flex-start; font-family: var(--mono); font-size: 13px; font-weight: 700;
    background: var(--navy); color: var(--paper); border-radius: 4px;
    padding: 4px 10px; transform: rotate(-1deg); margin-top: auto;
  }
  #shopify-section-{{ section.id }} .cnc-price s { opacity: .6; margin-left: 6px; }

  #shopify-section-{{ section.id }} .cnc-empty {
    background: var(--paper2); border: 3px dashed var(--navy); border-radius: 10px;
    padding: 40px; text-align: center;
  }
  #shopify-section-{{ section.id }} .cnc-empty h2 { font-size: 26px; margin-bottom: 8px; }
  #shopify-section-{{ section.id }} .cnc-empty p { color: var(--dim); margin: 0 0 18px; }

  #shopify-section-{{ section.id }} .cnc-pager {
    display: flex; justify-content: space-between; align-items: center;
    gap: 12px; margin-top: 36px;
  }
  #shopify-section-{{ section.id }} .cnc-pager-info {
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: var(--dim);
  }
  #shopify-section-{{ section.id }} .cnc-btn {
    display: inline-flex; align-items: center; height: 44px; padding: 0 20px;
    border: 2px solid var(--navy); border-radius: 6px; background: transparent;
    color: var(--navy); font-weight: 800; font-size: 13px; text-transform: uppercase;
    letter-spacing: .04em; transition: background .12s ease, color .12s ease;
  }
  #shopify-section-{{ section.id }} .cnc-btn:hover { background: var(--navy); color: var(--paper); }

  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .cnc-grid { grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 16px; }
  }
{%- endstyle -%}

<div class="cnc">
  <header class="cnc-head cnc-wrap">
    <p class="cnc-kicker">{{ section.settings.kicker | default: 'Catalog' }}</p>
    <h1>{{ collection.title }}</h1>
    {% if section.settings.show_description and collection.description != blank %}
      <div class="cnc-desc">{{ collection.description }}</div>
    {% endif %}
  </header>

  <div class="cnc-wrap">
    {% paginate collection.products by section.settings.products_per_page %}
      <p class="cnc-count"><b>{{ collection.products_count }}</b> item{% if collection.products_count != 1 %}s{% endif %} on this shelf</p>

      {% if collection.products.size > 0 %}
        <div class="cnc-grid">
          {% for product in collection.products %}
            <a class="cnc-card" href="{{ product.url }}">
              {% if product.featured_image %}
                <img class="cnc-card-img"
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  width="800"
                  height="{{ 800 | divided_by: product.featured_image.aspect_ratio | round }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy">
              {% endif %}
              <h3>{{ product.title }}</h3>
              <span class="cnc-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
              </span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="cnc-empty">
          <h2>Nothing on this shelf yet</h2>
          <p>New items land here as soon as they leave the workbench.</p>
          <a class="cnc-btn" href="{{ routes.all_products_url }}">Browse everything</a>
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="cnc-pager">
          {% if paginate.previous %}
            <a class="cnc-btn" href="{{ paginate.previous.url }}">← Previous</a>
          {% else %}<span></span>{% endif %}
          <span class="cnc-pager-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a class="cnc-btn" href="{{ paginate.next.url }}">Next →</a>
          {% else %}<span></span>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Catalog collection",
  "tag": "section",
  "class": "section-main-collection-catalog",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Catalog" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "range", "id": "products_per_page", "min": 6, "max": 24, "step": 6, "label": "Products per page", "default": 12 },
    { "type": "color", "id": "color_bg", "label": "Paper background", "default": "#F6F1E3" },
    { "type": "color", "id": "color_ink", "label": "Text (navy)", "default": "#1F2A44" },
    { "type": "color", "id": "color_accent", "label": "Print red", "default": "#D6453D" },
    { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#5D6478" },
    { "type": "color", "id": "color_card", "label": "Cards", "default": "#FDFAF1" },
    { "type": "color", "id": "color_line", "label": "Hairlines", "default": "#C9BFA6" }
  ]
}
{% endschema %}
