{% comment %}
  Game blog — devlog listing, "Mail-order catalogue" edition.
  Matches the catalog homepage (paper/navy/red, mono kickers, listings).
  Fonts are self-hosted from theme assets.
{% endcomment %}

{%- style -%}
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "WDXL Lubrifont JP N";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url({{ "wdxl-lubrifont-jp-n-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin-ext.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: "Nunito";
    font-style: normal;
    font-weight: 200 1000;
    font-display: swap;
    src: url({{ "nunito-latin.woff2" | asset_url }}) format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  #shopify-section-{{ section.id }} .cnb {
    --paper: {{ section.settings.color_bg }};
    --navy: {{ section.settings.color_ink }};
    --red: {{ section.settings.color_accent }};
    --dim: {{ section.settings.color_muted }};
    --rule: {{ section.settings.color_line }};
    --paper2: {{ section.settings.color_card }};
    --mono: ui-monospace, "Cascadia Mono", "JetBrains Mono", Consolas, monospace;
    --display: "WDXL Lubrifont JP N", "Fredoka", "Nunito", sans-serif;
    background: var(--paper);
    color: var(--navy);
    font-family: "Nunito", "Trebuchet MS", "Avenir Next", "Segoe UI", sans-serif;
    line-height: 1.55;
    padding-bottom: 60px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  #shopify-section-{{ section.id }} .cnb * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .cnb a:not(.cnb-btn) { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .cnb :focus-visible { outline: 3px solid var(--red); outline-offset: 2px; }
  #shopify-section-{{ section.id }} .cnb-wrap { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
  #shopify-section-{{ section.id }} .cnb h1,
  #shopify-section-{{ section.id }} .cnb h2 {
    font-family: var(--display); font-weight: 650; letter-spacing: -.02em;
    text-wrap: balance; margin: 0;
  }

  #shopify-section-{{ section.id }} .cnb-ticker {
    background: var(--navy); color: var(--paper);
    font-family: var(--mono); font-size: 11.5px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; text-align: center;
    padding: 8px 12px; margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .cnb-ticker b { color: #F6C94A; }

  #shopify-section-{{ section.id }} .cnb-kicker {
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--red);
  }
  #shopify-section-{{ section.id }} .cnb-head {
    text-align: center; padding: 48px 0 36px; border-bottom: 3px double var(--navy);
    margin-bottom: 36px;
  }
  #shopify-section-{{ section.id }} .cnb-head h1 { font-size: clamp(38px, 5.4vw, 68px); line-height: .95; margin: 14px 0 12px; }
  #shopify-section-{{ section.id }} .cnb-head .sub { color: var(--dim); font-size: 16.5px; max-width: 620px; margin: 0 auto; }

  #shopify-section-{{ section.id }} .cnb-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px;
  }
  #shopify-section-{{ section.id }} .cnb-card {
    background: var(--paper2); border: 2px solid var(--navy); border-radius: 8px;
    padding: 18px 18px 22px; display: flex; flex-direction: column; gap: 10px;
    position: relative; transition: transform .12s ease, box-shadow .12s ease;
  }
  #shopify-section-{{ section.id }} .cnb-card:hover { transform: translate(-2px,-2px); box-shadow: 5px 5px 0 var(--navy); }
  #shopify-section-{{ section.id }} .cnb-cover {
    width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;
    border-radius: 6px; display: block; margin-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .cnb-date {
    font-family: var(--mono); font-size: 11px; font-weight: 700;
    letter-spacing: .12em; color: var(--dim); text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .cnb-card h2 { font-size: clamp(22px, 2vw, 27px); line-height: 1; }
  #shopify-section-{{ section.id }} .cnb-card h2:hover { color: var(--red); }
  #shopify-section-{{ section.id }} .cnb-card p {
    color: var(--dim); font-size: 14px; margin: 0;
  }
  #shopify-section-{{ section.id }} .cnb-more {
    font-family: var(--mono); font-size: 12.5px; font-weight: 700;
    color: var(--red); text-transform: uppercase; margin-top: auto; padding-top: 6px;
  }
  #shopify-section-{{ section.id }} .cnb-card:hover .cnb-more { text-decoration: underline; text-underline-offset: 3px; }

  #shopify-section-{{ section.id }} .cnb-pager {
    display: flex; justify-content: space-between; align-items: center;
    gap: 12px; margin-top: 36px;
  }
  #shopify-section-{{ section.id }} .cnb-pager-info {
    font-family: var(--mono); font-size: 12px; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase; color: var(--dim);
  }
  #shopify-section-{{ section.id }} .cnb-btn {
    display: inline-flex; align-items: center; height: 44px; padding: 0 20px;
    border: 2px solid var(--navy); border-radius: 6px; background: transparent;
    color: var(--navy); font-weight: 800; font-size: 13px; text-transform: uppercase;
    letter-spacing: .04em; transition: background .12s ease, color .12s ease;
  }
  #shopify-section-{{ section.id }} .cnb-btn:hover { background: var(--navy); color: var(--paper); }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .cnb-grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .cnb-pager { flex-wrap: wrap; justify-content: center; }
  }
{%- endstyle -%}

<div class="cnb">
  {%- if section.settings.ticker_text != blank -%}
    <div class="cnb-ticker">
      {%- assign ticker = section.settings.ticker_text | strip -%}
      {{ ticker }} <b>★</b> {{ ticker }}
    </div>
  {%- endif -%}

  <header class="cnb-head cnb-wrap">
    <p class="cnb-kicker">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading | default: blog.title }}</h1>
    {%- if section.settings.sub != blank -%}
      <p class="sub">{{ section.settings.sub }}</p>
    {%- endif -%}
  </header>

  <div class="cnb-wrap">
    {% paginate blog.articles by section.settings.posts_per_page %}
      <div class="cnb-grid">
        {% for article in blog.articles %}
          <a class="cnb-card" href="{{ article.url }}">
            {% if article.image %}
              <img class="cnb-cover"
                src="{{ article.image | image_url: width: 800 }}"
                width="800"
                height="{{ 800 | divided_by: article.image.aspect_ratio | round }}"
                alt="{{ article.image.alt | default: article.title | escape }}"
                loading="lazy">
            {% endif %}
            <time class="cnb-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: "%B %-d, %Y" }}</time>
            <h2>{{ article.title }}</h2>
            {% if section.settings.show_excerpts %}
              <p>{{ article.excerpt | default: article.content | strip_html | truncatewords: 26 }}</p>
            {% endif %}
            <span class="cnb-more">{{ section.settings.read_label }} →</span>
          </a>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="cnb-pager">
          {% if paginate.previous %}
            <a class="cnb-btn" href="{{ paginate.previous.url }}">← Previous</a>
          {% else %}<span></span>{% endif %}
          <span class="cnb-pager-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {% if paginate.next %}
            <a class="cnb-btn" href="{{ paginate.next.url }}">Next →</a>
          {% else %}<span></span>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Game blog",
  "tag": "section",
  "class": "section-game-blog",
  "enabled_on": { "templates": ["blog"] },
  "settings": [
    { "type": "textarea", "id": "ticker_text", "label": "Ticker text (repeated with ★, empty hides it)", "default": "New games for old machines · Handmade in Poland · Small batches · Tested on real hardware" },
    { "type": "color", "id": "color_bg", "label": "Paper background", "default": "#F6F1E3" },
    { "type": "color", "id": "color_ink", "label": "Text (navy)", "default": "#1F2A44" },
    { "type": "color", "id": "color_accent", "label": "Print red", "default": "#D6453D" },
    { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#5D6478" },
    { "type": "color", "id": "color_card", "label": "Cards", "default": "#FDFAF1" },
    { "type": "color", "id": "color_line", "label": "Hairlines", "default": "#C9BFA6" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Cyfrowy Nomada · devlog" },
    { "type": "text", "id": "heading", "label": "Heading (falls back to blog title)" },
    { "type": "text", "id": "sub", "label": "Subhead", "default": "Progress updates, postmortems, and free templates from the workbench." },
    { "type": "range", "id": "posts_per_page", "min": 6, "max": 24, "step": 3, "label": "Posts per page", "default": 12 },
    { "type": "checkbox", "id": "show_excerpts", "label": "Show excerpts", "default": true },
    { "type": "text", "id": "read_label", "label": "Read link label", "default": "Read more" }
  ]
}
{% endschema %}
