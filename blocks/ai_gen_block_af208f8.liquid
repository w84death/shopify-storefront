{% doc %}
  @prompt
    Create a "Company Milestones" section block that displays a list of milestones from a metaobject definition of type "milestone_1". Each milestone metaobject has three fields: year (key: year, single_line_text_field), title (key: title, single_line_text_field), and description (key: description, multi_line_text_field). The block should support up to 5 milestones, each with a metaobject_reference setting pointing to milestone_1 entries. Display each milestone as a timeline-style row showing the year, title, and description. All three fields must be properly bound as dynamic sources to the metaobject fields — no hardcoded Liquid syntax in setting values. The visual style should match a retro, utilitarian indie game store aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-milestones-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-milestones-wrapper-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-milestones-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, monospace;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_below_heading }}px 0;
    text-transform: {{ block.settings.heading_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-milestones-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.milestone_spacing }}px;
  }

  .ai-milestone-item-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: {{ block.settings.year_width }}px 1fr;
    gap: {{ block.settings.column_gap }}px;
    padding: {{ block.settings.item_padding }}px;
    border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
    background-color: {{ block.settings.item_background }};
    position: relative;
  }

  .ai-milestone-year-{{ ai_gen_id }} {
    font-family: {{ block.settings.year_font.family }}, monospace;
    font-size: {{ block.settings.year_size }}px;
    font-weight: {{ block.settings.year_weight }};
    color: {{ block.settings.year_color }};
    line-height: 1.2;
    text-transform: {{ block.settings.year_transform }};
  }

  .ai-milestone-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-milestone-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, monospace;
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
    text-transform: {{ block.settings.title_transform }};
  }

  .ai-milestone-description-{{ ai_gen_id }} {
    font-family: {{ block.settings.description_font.family }}, monospace;
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-milestone-empty-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    color: {{ block.settings.description_color }};
    font-family: {{ block.settings.description_font.family }}, monospace;
    font-size: 14px;
    border: 1px dashed {{ block.settings.border_color }};
    background-color: {{ block.settings.item_background }};
  }

  .ai-completed-{{ ai_gen_id }} .ai-milestone-title-{{ ai_gen_id }},
  .ai-completed-{{ ai_gen_id }} .ai-milestone-year-{{ ai_gen_id }} {
    text-decoration: line-through;
    color: #b6b6b6ff;
  }
  .ai-completed-{{ ai_gen_id }} .ai-milestone-description-{{ ai_gen_id }} {
    color: #868686ff;
  }

  @media screen and (max-width: 749px) {
    .ai-milestone-item-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.content_gap }}px;
    }

    .ai-milestones-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-milestone-year-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.year_size }}px * 0.85);
    }

    .ai-milestone-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }
  }
{% endstyle %}

<company-milestones-{{ ai_gen_id }} class="ai-milestones-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-milestones-wrapper-{{ ai_gen_id }}">
    {% if block.settings.section_heading != blank %}
      <h2 class="ai-milestones-heading-{{ ai_gen_id }}">{{ block.settings.section_heading }}</h2>
    {% endif %}

    {% assign has_milestones = false %}
    {% for i in (1..5) %}
      {% assign milestone_key = 'milestone_' | append: i %}
      {% assign milestone = block.settings[milestone_key] %}
      {% if milestone != blank %}
        {% assign has_milestones = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_milestones %}
      <div class="ai-milestones-list-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% assign milestone_key = 'milestone_' | append: i %}
          {% assign milestone = block.settings[milestone_key] %}
          
          {% if milestone != blank %}
            <div class="ai-milestone-item-{{ ai_gen_id }}{% if milestone.done == true %} ai-completed-{{ ai_gen_id }}{% endif %}">
              <div class="ai-milestone-year-{{ ai_gen_id }}">
                {{ milestone.year.value }}
              </div>             
              <div class="ai-milestone-content-{{ ai_gen_id }}">
                <h3 class="ai-milestone-title-{{ ai_gen_id }}">
                  {{ milestone.title.value }}
                </h3>
                {% if milestone.description.value != blank %}
                  <p class="ai-milestone-description-{{ ai_gen_id }}">
                    {{ milestone.description.value }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-milestone-empty-{{ ai_gen_id }}">
        Next, add milestone metaobjects to display your company timeline
      </div>
    {% endif %}
  </div>
</company-milestones-{{ ai_gen_id }}>

<script>
  (function() {
    class CompanyMilestones{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initializeMilestones();
      }

      initializeMilestones() {
        const items = this.querySelectorAll('.ai-milestone-item-{{ ai_gen_id }}');
        items.forEach((item, index) => {
          item.style.animationDelay = `${index * 0.1}s`;
        });
      }
    }

    customElements.define('company-milestones-{{ ai_gen_id }}', CompanyMilestones{{ ai_gen_id }});
  })();
</script>

