{% doc %}
  @prompt
    i need a section that will showcase a timeline, kinda milestones for my shop/company. first point is: invest in hardware and game engine, second: (now): develop few simple games, third: packaging, open sell, fourth: pay out all investments, fifth: get Analog Pocket.
    
    make this widget work with database entry so I can easily change it and update with one is current.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-timeline-container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-timeline-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 10px;
  }

  .ai-timeline-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-timeline-list-{{ ai_gen_id }} {
    position: relative;
    padding-left: 40px;
  }

  .ai-timeline-list-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    left: 8px;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: {{ block.settings.line_color }};
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    padding-bottom: 30px;
  }

  .ai-timeline-item-{{ ai_gen_id }}:last-child {
    padding-bottom: 0;
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: absolute;
    left: -32px;
    top: 4px;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: 2px solid {{ block.settings.background_color }};
    z-index: 1;
  }

  .ai-timeline-item-{{ ai_gen_id }}.current .ai-timeline-dot-{{ ai_gen_id }} {
    background-color: {{ block.settings.current_dot_color }};
    box-shadow: 0 0 0 4px {{ block.settings.current_dot_color }}33;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    padding: 16px 20px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 1px solid {{ block.settings.card_border_color }};
  }

  .ai-timeline-item-{{ ai_gen_id }}.current .ai-timeline-content-{{ ai_gen_id }} {
    border-color: {{ block.settings.current_dot_color }};
    border-width: 2px;
  }

  .ai-timeline-item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_title_size }}px;
    color: {{ block.settings.item_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-timeline-item-{{ ai_gen_id }}.current .ai-timeline-item-title-{{ ai_gen_id }} {
    color: {{ block.settings.current_dot_color }};
  }

  .ai-timeline-item-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_description_size }}px;
    color: {{ block.settings.item_description_color }};
    margin: 0;
  }

  .ai-timeline-badge-{{ ai_gen_id }} {
    display: inline-block;
    padding: 4px 12px;
    background-color: {{ block.settings.current_dot_color }};
    color: {{ block.settings.background_color }};
    font-size: 12px;
    border-radius: 12px;
    margin-bottom: 8px;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-list-{{ ai_gen_id }} {
      padding-left: 30px;
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      left: -26px;
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      padding: 12px 16px;
    }
  }
{% endstyle %}

<timeline-milestones-{{ ai_gen_id }} class="ai-timeline-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-timeline-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-timeline-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-timeline-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-timeline-list-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign milestone_enabled_key = 'milestone_' | append: i | append: '_enabled'
          assign milestone_title_key = 'milestone_' | append: i | append: '_title'
          assign milestone_description_key = 'milestone_' | append: i | append: '_description'
          assign milestone_current_key = 'milestone_' | append: i | append: '_current'

          assign milestone_enabled = block.settings[milestone_enabled_key]
          assign milestone_title = block.settings[milestone_title_key]
          assign milestone_description = block.settings[milestone_description_key]
          assign milestone_current = block.settings[milestone_current_key]
        %}

        {% if milestone_enabled %}
          <div class="ai-timeline-item-{{ ai_gen_id }} {% if milestone_current %}current{% endif %}">
            <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>
            <div class="ai-timeline-content-{{ ai_gen_id }}">
              {% if milestone_current %}
                <span class="ai-timeline-badge-{{ ai_gen_id }}">{{ block.settings.current_label }}</span>
              {% endif %}
              {% if milestone_title != blank %}
                <h3 class="ai-timeline-item-title-{{ ai_gen_id }}">{{ milestone_title }}</h3>
              {% endif %}
              {% if milestone_description != blank %}
                <div class="ai-timeline-item-description-{{ ai_gen_id }}">{{ milestone_description }}</div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</timeline-milestones-{{ ai_gen_id }}>

<script>
  (function() {
    class TimelineMilestones{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.observeIntersection();
      }

      observeIntersection() {
        const items = this.querySelectorAll('.ai-timeline-item-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateX(0)';
              }
            });
          }, {
            threshold: 0.1
          });

          items.forEach((item, index) => {
            item.style.opacity = '0';
            item.style.transform = 'translateX(-20px)';
            item.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
            item.style.transitionDelay = (index * 0.1) + 's';
            observer.observe(item);
          });
        }
      }
    }

    customElements.define('timeline-milestones-{{ ai_gen_id }}', TimelineMilestones{{ ai_gen_id }});
  })();
</script>

