{% doc %}
  @prompt
    Fix the vertical timeline line alignment in the "Company milestones" block (file: ai_gen_block_b0867eb.liquid or similar in the blocks/ or sections/ folder). The vertical connecting line between dots is not horizontally centered with the dots. Fix the CSS so the line is perfectly centered — set `left: 50%` and `transform: translateX(-50%)` on the vertical line element, or adjust its positioning so it aligns with the horizontal center of the dot/circle elements. Do not change any other styles.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
  }

  .ai-timeline-{{ ai_gen_id }} {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 0;
    bottom: 0;
    width: {{ block.settings.line_width }}px;
    background-color: {{ block.settings.line_color }};
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: {{ block.settings.item_spacing }}px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .ai-timeline-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    flex: 1;
    text-align: right;
    padding-right: 20px;
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    background-color: {{ block.settings.dot_color }};
    border-radius: 50%;
    flex-shrink: 0;
    z-index: 2;
    border: {{ block.settings.dot_border_width }}px solid {{ block.settings.dot_border_color }};
  }

  .ai-timeline-content-right-{{ ai_gen_id }} {
    flex: 1;
    text-align: left;
    padding-left: 20px;
  }

  .ai-timeline-year-{{ ai_gen_id }} {
    font-size: {{ block.settings.year_font_size }}px;
    font-weight: bold;
    color: {{ block.settings.year_color }};
    margin-bottom: 8px;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
    margin-bottom: 8px;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-timeline-{{ ai_gen_id }} {
      padding-left: 30px;
    }

    .ai-timeline-line-{{ ai_gen_id }} {
      left: 0;
      transform: translateX(0);
    }

    .ai-timeline-item-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      text-align: left;
      padding-right: 0;
      order: 2;
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      position: absolute;
      left: calc(-30px + ({{ block.settings.dot_size }}px / 2) * -1);
      order: 1;
    }

    .ai-timeline-content-right-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-timeline-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-timeline-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}"></div>

    {% for i in (1..5) %}
      {% liquid
        assign year_key = 'milestone_' | append: i | append: '_year'
        assign title_key = 'milestone_' | append: i | append: '_title'
        assign description_key = 'milestone_' | append: i | append: '_description'
        assign enabled_key = 'milestone_' | append: i | append: '_enabled'

        assign year = block.settings[year_key]
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
        assign enabled = block.settings[enabled_key]
      %}

      {% if enabled %}
        <div class="ai-timeline-item-{{ ai_gen_id }}">
          <div class="ai-timeline-content-{{ ai_gen_id }}">
            {% if year != blank %}
              <div class="ai-timeline-year-{{ ai_gen_id }}">{{ year }}</div>
            {% endif %}
            {% if title != blank %}
              <div class="ai-timeline-title-{{ ai_gen_id }}">{{ title }}</div>
            {% endif %}
            {% if description != blank %}
              <div class="ai-timeline-description-{{ ai_gen_id }}">{{ description }}</div>
            {% endif %}
          </div>

          <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>

          <div class="ai-timeline-content-right-{{ ai_gen_id }}"></div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

