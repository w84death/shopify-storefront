{% doc %}
  @prompt
    generate an iframe block that I could just pass the URL to the content of it (for this example: https://fungus-foray-dx.p1x.in/emulator/), setup minimal height to keep the iframe in 160x144 ratio.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-iframe-container-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-iframe-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: 144px;
    aspect-ratio: 160 / 144;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-iframe-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.placeholder_text_color }};
    font-size: 14px;
    padding: 20px;
  }

  @media screen and (max-width: 749px) {
    .ai-iframe-container-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-iframe-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-iframe-wrapper-{{ ai_gen_id }}">
    {% if block.settings.iframe_url != blank %}
      <iframe
        class="ai-iframe-{{ ai_gen_id }}"
        src="{{ block.settings.iframe_url }}"
        title="{{ block.settings.iframe_title }}"
        loading="lazy"
        {% if block.settings.allow_fullscreen %}allowfullscreen{% endif %}
      ></iframe>
    {% else %}
      <div class="ai-iframe-placeholder-{{ ai_gen_id }}">
        Next, add an iframe URL
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Iframe embed",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Iframe settings"
    },
    {
      "type": "url",
      "id": "iframe_url",
      "label": "Iframe URL"
    },
    {
      "type": "text",
      "id": "iframe_title",
      "label": "Iframe title",
      "default": "Embedded content"
    },
    {
      "type": "checkbox",
      "id": "allow_fullscreen",
      "label": "Allow fullscreen",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "placeholder_text_color",
      "label": "Placeholder text color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Iframe embed"
    }
  ]
}
{% endschema %}
